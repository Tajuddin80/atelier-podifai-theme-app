<style>
  .testimonials-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding: {{ section.settings.section_padding }}px 40px;
  }


  .testimonials-section-{{ section.id }} .testimonials-inner {
    max-width: {{ section.settings.content_width }}px;
    margin: 0 auto;
  }


  /* Heading Alignment Control from Admin */
  .testimonials-section-{{ section.id }} .testimonials-heading {
    font-size: {{ section.settings.heading_size }}px;
    color: {{ section.settings.heading_color }};
    text-align: {{ section.settings.heading_alignment }};
    {% comment %} font-family: Georgia, serif;
    font-weight: 400;
    font-style: italic; {% endcomment %}
    margin: 0 0 32px;
    {% comment %} line-height: 1.3; {% endcomment %}
  }


  .testimonials-section-{{ section.id }} .carousel-outer {
    position: relative;
  }


  .testimonials-section-{{ section.id }} .carousel-track-wrapper {
    overflow: hidden;
    padding: 10px;
    margin: -10px;
  }


  .testimonials-section-{{ section.id }} .carousel-track {
    display: flex;
    gap: {{ section.settings.card_gap }}px;
    transition: transform 0.4s ease;
    will-change: transform;
  }


  /* Desktop View Width Calculation */
  .testimonials-section-{{ section.id }} .testimonial-card {
    flex: 0 0 calc((100% - {{ section.settings.card_gap | times: section.settings.cards_per_view | minus: section.settings.card_gap }}px) / {{ section.settings.cards_per_view }});
    background: {{ section.settings.card_bg_color }};
    border: 1px solid {{ section.settings.card_border_color }};
    border-radius: {{ section.settings.card_radius }}px;
    padding: {{ section.settings.card_padding }}px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 12px;
    position: relative;
    transform: translateZ(0);
    backface-visibility: hidden;
  }


  .testimonials-section-{{ section.id }} .stars {
    display: flex;
    gap: 3px;
  }


  .testimonials-section-{{ section.id }} .star {
    color: {{ section.settings.star_color }};
    font-size: {{ section.settings.star_size }}px;
    line-height: 1;
  }


  .testimonials-section-{{ section.id }} .review-text {
    font-size: {{ section.settings.review_size }}px;
    color: {{ section.settings.review_color }};
    {% comment %} font-family: Arial, sans-serif;
    line-height: 1.6; {% endcomment %}
    margin: 0;
    flex: 1;
  }


  .testimonials-section-{{ section.id }} .reviewer {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 8px;
  }


  .testimonials-section-{{ section.id }} .reviewer-avatar {
    width: {{ section.settings.avatar_size }}px;
    height: {{ section.settings.avatar_size }}px;
    border-radius: 50%;
    background: {{ section.settings.avatar_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
  }


  .testimonials-section-{{ section.id }} .reviewer-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }


  .testimonials-section-{{ section.id }} .reviewer-avatar .avatar-placeholder {
    width: 100%;
    height: 100%;
    background: {{ section.settings.avatar_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
  }


  .testimonials-section-{{ section.id }} .reviewer-avatar .avatar-placeholder svg {
    width: 55%;
    height: 55%;
    fill: {{ section.settings.avatar_icon_color }};
  }


  .testimonials-section-{{ section.id }} .reviewer-info .reviewer-name {
    font-size: {{ section.settings.name_size }}px;
    {% comment %} font-weight: 700; {% endcomment %}
    color: {{ section.settings.name_color }};
    {% comment %} font-family: Arial, sans-serif; {% endcomment %}
    margin: 0;
    {% comment %} line-height: 1.3; {% endcomment %}
  }


  .testimonials-section-{{ section.id }} .reviewer-info .reviewer-tag {
    font-size: {{ section.settings.tag_size }}px;
    color: {{ section.settings.tag_color }};
    {% comment %} font-family: Arial, sans-serif; {% endcomment %}
    margin: 0;
    {% comment %} line-height: 1.2; {% endcomment %}
  }


  .testimonials-section-{{ section.id }} .carousel-nav {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 28px;
    align-items: center;
  }


  .testimonials-section-{{ section.id }} .carousel-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid {{ section.settings.nav_border_color }};
    background: {{ section.settings.nav_bg_color }};
    color: {{ section.settings.nav_arrow_color }};
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    padding: 0;
  }


  .testimonials-section-{{ section.id }} .carousel-btn svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }


  .testimonials-section-{{ section.id }} .carousel-btn:hover {
    opacity: 0.7;
    background: {{ section.settings.nav_border_color }};
    color: #fff;
  }


  .testimonials-section-{{ section.id }} .carousel-dots {
    display: flex;
    gap: 8px;
    align-items: center;
  }


  .testimonials-section-{{ section.id }} .carousel-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: {{ section.settings.dot_inactive_color }};
    border: none;
    cursor: pointer;
    padding: 0;
    transition: all 0.3s ease;
  }


  .testimonials-section-{{ section.id }} .carousel-dot.active {
    background: {{ section.settings.dot_active_color }};
    transform: scale(1.3);
  }


  /* Mobile screen responsive card width solution */
  @media screen and (max-width: 768px) {
    .testimonials-section-{{ section.id }} {
      padding: {{ section.settings.section_padding }}px 20px;
    }
    .testimonials-section-{{ section.id }} .carousel-track {
      gap: 20px;
    }
    .testimonials-section-{{ section.id }} .testimonial-card {
      flex: 0 0 100%;
      max-width: 100%;
    }
  }
</style>


{% capture card_html %}
  {% for block in section.blocks %}
    <div class="testimonial-card" {{ block.shopify_attributes }}>
      <div class="stars">
        {% assign star_count = block.settings.rating | round %}
        {% for i in (1..5) %}
          {% if i <= star_count %}
            <span class="star">★</span>
          {% else %}
            <span class="star" style="opacity:0.3;">★</span>
          {% endif %}
        {% endfor %}
      </div>
      {% if block.settings.review_text != blank %}
        <p class="review-text">{{ block.settings.review_text }}</p>
      {% endif %}
      <div class="reviewer">
        <div class="reviewer-avatar">
          {% if block.settings.avatar != blank %}
            <img src="{{ block.settings.avatar | image_url: width: 100 }}" alt="{{ block.settings.reviewer_name }}">
          {% else %}
            <div class="avatar-placeholder">
              <svg viewBox="0 0 24 24"><path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/></svg>
            </div>
          {% endif %}
        </div>
        <div class="reviewer-info">
          {% if block.settings.reviewer_name != blank %}
            <p class="reviewer-name">{{ block.settings.reviewer_name }}</p>
          {% endif %}
          {% if block.settings.reviewer_tag != blank %}
            <p class="reviewer-tag">{{ block.settings.reviewer_tag }}</p>
          {% endif %}
        </div>
      </div>
    </div>
  {% endfor %}
{% endcapture %}


<section class="testimonials-section-{{ section.id }}">
  <div class="testimonials-inner">


    {% if section.settings.heading != blank %}
      <h2 class="testimonials-heading">{{ section.settings.heading }}</h2>
    {% endif %}


    <div class="carousel-outer">
      <div class="carousel-track-wrapper">
        <div class="carousel-track" id="carousel-track-{{ section.id }}">
          {{ card_html }}
          {{ card_html }}
          {{ card_html }}
        </div>
      </div>


      <div class="carousel-nav">
        <button class="carousel-btn" id="prev-{{ section.id }}" aria-label="Previous">
          <svg viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <div class="carousel-dots" id="dots-{{ section.id }}"></div>
        <button class="carousel-btn" id="next-{{ section.id }}" aria-label="Next">
          <svg viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
    </div>


  </div>
</section>


<script>
(function() {
  var sectionId = '{{ section.id }}';
  var totalCards = {{ section.blocks.size }};
  var autoplaySpeed = {{ section.settings.autoplay_speed | times: 1000 }};
  var enableAutoplay = {{ section.settings.autoplay }};


  var track = document.getElementById('carousel-track-' + sectionId);
  var prevBtn = document.getElementById('prev-' + sectionId);
  var nextBtn = document.getElementById('next-' + sectionId);
  var dotsContainer = document.getElementById('dots-' + sectionId);


  if (!track || totalCards === 0) return;


  var currentPos = totalCards;
  var isTransitioning = false;
  var autoplayInterval = null;


  if (dotsContainer) {
    dotsContainer.innerHTML = '';
    for (var i = 0; i < totalCards; i++) {
      (function(index) {
        var dot = document.createElement('button');
        dot.className = 'carousel-dot' + (index === 0 ? ' active' : '');
        dot.addEventListener('click', function() { jumpTo(index); });
        dotsContainer.appendChild(dot);
      })(i);
    }
  }


  function getCardWidth() {
    var cards = track.children;
    if (!cards.length) return 0;
    var currentGap = window.innerWidth <= 768 ? 20 : {{ section.settings.card_gap }};
    return cards[0].getBoundingClientRect().width + currentGap;
  }


  function setPosition(pos, animate) {
    track.style.transition = animate ? 'transform 0.4s ease' : 'none';
    track.style.transform = 'translateX(-' + (pos * getCardWidth()) + 'px)';
  }


  function updateDots() {
    var realIndex = currentPos % totalCards;
    if (dotsContainer) {
      var dots = dotsContainer.querySelectorAll('.carousel-dot');
      dots.forEach(function(d, i) { d.classList.toggle('active', i === realIndex); });
    }
  }


  function goNext() {
    if (isTransitioning) return;
    isTransitioning = true;
    currentPos++;
    setPosition(currentPos, true);
    updateDots();
  }


  function goPrev() {
    if (isTransitioning) return;
    isTransitioning = true;
    currentPos--;
    setPosition(currentPos, true);
    updateDots();
  }


  function jumpTo(index) {
    currentPos = totalCards + index;
    setPosition(currentPos, true);
    updateDots();
  }


  track.addEventListener('transitionend', function() {
    isTransitioning = false;
    if (currentPos >= totalCards * 2) {
      currentPos = currentPos - totalCards;
      setPosition(currentPos, false);
    }
    if (currentPos < totalCards) {
      currentPos = currentPos + totalCards;
      setPosition(currentPos, false);
    }
  });


  setPosition(currentPos, false);
  updateDots();


  if (prevBtn) prevBtn.addEventListener('click', function() { goPrev(); if (enableAutoplay) startAutoplay(); });
  if (nextBtn) nextBtn.addEventListener('click', function() { goNext(); if (enableAutoplay) startAutoplay(); });


  function startAutoplay() { stopAutoplay(); autoplayInterval = setInterval(goNext, autoplaySpeed); }
  function stopAutoplay() { if (autoplayInterval) clearInterval(autoplayInterval); }


  if (enableAutoplay) startAutoplay();
  window.addEventListener('resize', function() { setPosition(currentPos, false); });
})();
</script>


{% schema %}
{
  "name": "Testimonials Carousel",
  "tag": "section",
  "class": "testimonials-carousel-section",
  "settings": [
    {
      "type": "header",
      "content": "Heading Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Over 2,000 Australian Homes Styled with Mordéa"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Font Size",
      "min": 18,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#2a2a2a"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Max Content Width",
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section Padding",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "cards_per_view",
      "label": "Cards Per View (Desktop)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap Between Cards",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Autoplay"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay Speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 4
    },
    {
      "type": "header",
      "content": "Card Styling & Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f5f2ee"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card Border Color",
      "default": "#e0dbd4"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card Border Radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card Inner Padding",
      "min": 12,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Review Components"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star Color",
      "default": "#c4a882"
    },
    {
      "type": "range",
      "id": "star_size",
      "label": "Star Size",
      "min": 12,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "review_size",
      "label": "Review Font Size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "color",
      "id": "review_color",
      "label": "Review Text Color",
      "default": "#3a3a3a"
    },
    {
      "type": "range",
      "id": "avatar_size",
      "label": "Avatar Size",
      "min": 32,
      "max": 72,
      "step": 4,
      "unit": "px",
      "default": 44
    },
    {
      "type": "color",
      "id": "avatar_bg_color",
      "label": "Avatar Background",
      "default": "#d9d0c4"
    },
    {
      "type": "color",
      "id": "avatar_icon_color",
      "label": "Avatar Icon Color",
      "default": "#a89880"
    },
    {
      "type": "range",
      "id": "name_size",
      "label": "Name Font Size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "color",
      "id": "name_color",
      "label": "Name Color",
      "default": "#2a2a2a"
    },
    {
      "type": "range",
      "id": "tag_size",
      "label": "Tag Font Size",
      "min": 9,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "color",
      "id": "tag_color",
      "label": "Tag Color",
      "default": "#888888"
    },
    {
      "type": "header",
      "content": "Navigation Settings"
    },
    {
      "type": "color",
      "id": "nav_bg_color",
      "label": "Nav Button Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "nav_border_color",
      "label": "Nav Button Border",
      "default": "#d0c8be"
    },
    {
      "type": "color",
      "id": "nav_arrow_color",
      "label": "Nav Arrow Color",
      "default": "#3a3a3a"
    },
    {
      "type": "color",
      "id": "dot_active_color",
      "label": "Active Dot Color",
      "default": "#3a3a3a"
    },
    {
      "type": "color",
      "id": "dot_inactive_color",
      "label": "Inactive Dot Color",
      "default": "#d0c8be"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Star Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review Text",
          "default": "Absolutely love this product! The quality exceeded my expectations and it arrived quickly. Highly recommend!"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Reviewer Photo (optional)"
        },
        {
          "type": "text",
          "id": "reviewer_name",
          "label": "Reviewer Name",
          "default": "Sarah M."
        },
        {
          "type": "text",
          "id": "reviewer_tag",
          "label": "Reviewer Tag",
          "default": "Verified Buyer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials Carousel",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}