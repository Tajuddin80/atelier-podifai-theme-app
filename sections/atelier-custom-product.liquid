    cursor: pointer;
    padding: 0;
    transition: color 0.2s ease;
  }

  .size-guide-link:hover {
    color: #1a1a1a;
  }

  /* Size Radio Pills */
  .size-pill-swatches {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .size-pill-label {
    flex: 1;
    min-width: 90px;
    text-align: center;
    border: 1.5px solid #E2E2E2;
    border-radius: 8px;
    padding: 10px 14px;
    cursor: pointer;
    user-select: none;
    background: #ffffff;
    transition: all 0.2s ease;
