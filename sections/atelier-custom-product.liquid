<script id="podifai-product-variants-json" type="application/json">
  {{ product.variants | json }}
</script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Quantity Stepper (if enabled)
    const qtyInput = document.getElementById('product-quantity-input');
    const minusBtn = document.getElementById('qty-minus-btn');
    const plusBtn = document.getElementById('qty-plus-btn');

    if (qtyInput && minusBtn && plusBtn) {
      minusBtn.addEventListener('click', () => {
        let current = parseInt(qtyInput.value) || 1;
        if (current > 1) {
          qtyInput.value = current - 1;
          if (window.PodifaiCustomizer && window.PodifaiCustomizer.updatePrice) {
            window.PodifaiCustomizer.updatePrice();
          }
        }
      });

      plusBtn.addEventListener('click', () => {
        let current = parseInt(qtyInput.value) || 1;
        if (current < 99) {
          qtyInput.value = current + 1;
          if (window.PodifaiCustomizer && window.PodifaiCustomizer.updatePrice) {
            window.PodifaiCustomizer.updatePrice();
          }
        }
      });
    }

    const variantsDataEl = document.getElementById('podifai-product-variants-json');
    let productVariants = [];
    try {
      if (variantsDataEl) {
        productVariants = JSON.parse(variantsDataEl.textContent);
      }
    } catch (e) {
      console.error('Error parsing product variants JSON:', e);
    }

    const variantIdInput = document.getElementById('selected-variant-id');
    const imageWrappers = document.querySelectorAll('.product-image-wrapper');
    const optionGroups = document.querySelectorAll('.variant-option-group');
    const priceContainer = document.getElementById('podifai-product-price');
    const addToCartBtn = document.getElementById('add-to-cart-btn');

    // Dynamic Size Description Switcher
    function updateSizeDescription() {
      const checkedSize = document.querySelector(
        '.variant-option-group--size .size-pill-input:checked, .size-pill-input:checked'
      );
      const descEl = document.getElementById('size-description-text');
      if (descEl && checkedSize) {
        const desc = checkedSize.dataset.sizeDesc || '';
        descEl.innerText = desc;
      }
    }

    // Ensure at least one image wrapper is active on load
    const activeWrapper = document.querySelector('.product-image-wrapper.active');
    if (!activeWrapper && imageWrappers.length > 0) {
      imageWrappers[0].classList.remove('hidden');
      imageWrappers[0].classList.add('active');
    }

    function switchProductImage(imageId, imageUrl) {
      if (imageWrappers.length === 0) return;

      let matched = false;
      if (imageId) {
        imageWrappers.forEach((w) => {
          if (String(w.dataset.imageId) === String(imageId)) {
            w.classList.remove('hidden');
            w.classList.add('active');
            matched = true;
          } else {
            w.classList.remove('active');
            w.classList.add('hidden');
          }
        });
      }

      if (!matched && imageUrl) {
        const cleanTarget = imageUrl.replace(/^https?:/, '').split('?')[0];
        imageWrappers.forEach((w) => {
          const img = w.querySelector('img');
          const imgSrc = (img?.src || '').replace(/^https?:/, '').split('?')[0];
          if (imgSrc && (imgSrc.includes(cleanTarget) || cleanTarget.includes(imgSrc))) {
            w.classList.remove('hidden');
            w.classList.add('active');
            matched = true;
          } else {
            w.classList.remove('active');
            w.classList.add('hidden');
          }
        });

        if (!matched) {
          let cur = document.querySelector('.product-image-wrapper.active') || imageWrappers[0];
          if (cur) {
            cur.classList.remove('hidden');
            cur.classList.add('active');
            const img = cur.querySelector('img');
            if (img) img.src = imageUrl;
          }
        }
      }

      setTimeout(() => {
        if (window.PodifaiCustomizer && window.PodifaiCustomizer.reAnchor) {
          window.PodifaiCustomizer.reAnchor();
        }
      }, 50);
    }

    // Dynamic Swatch Availability Filter based on Size selection & Variant Image / Stock presence
    function updateAvailableSwatches() {
      if (!productVariants || productVariants.length === 0) return;

      const sizeGroup = document.querySelector('.variant-option-group--size, [data-option-name*="size" i]');
      const colorGroup = document.querySelector('.variant-option-group--colour, [data-option-name*="colo" i]');

      if (!colorGroup) return;

      const sizeOptIdx = sizeGroup ? parseInt(sizeGroup.dataset.optionIndex) : null;
      const colorOptIdx = parseInt(colorGroup.dataset.optionIndex);

      const checkedSize = sizeGroup ? sizeGroup.querySelector('.size-pill-input:checked') : null;
      const selectedSizeVal = checkedSize ? checkedSize.value : '';

      // Check if product variants have any images configured
      const storeHasVariantImages = productVariants.some(
        (v) => !!(v.featured_image?.src || v.featured_media?.preview_image?.src || v.featured_media?.src)
      );

      const colorSwatches = colorGroup.querySelectorAll('.color-swatch-btn');
      colorSwatches.forEach((swatch) => {
        const colorVal = swatch.dataset.optionValue;

        // Find the specific variant for (selectedSizeVal, colorVal)
        const exactVariant = productVariants.find((v) => {
          const matchSize = sizeOptIdx === null || !selectedSizeVal || v.options[sizeOptIdx] === selectedSizeVal;
          const matchColor = v.options[colorOptIdx] === colorVal;
          return matchSize && matchColor;
        });

        // Check image presence for this variant or color
        const hasVariantImg = !!(
          exactVariant?.featured_image?.src ||
          exactVariant?.featured_media?.preview_image?.src ||
          exactVariant?.featured_media?.src
        );
        const hasColorImg = productVariants.some(
          (v) =>
            v.options[colorOptIdx] === colorVal &&
            !!(v.featured_image?.src || v.featured_media?.preview_image?.src || v.featured_media?.src)
        );

        const isImgAvailable = storeHasVariantImages ? hasVariantImg || hasColorImg : true;
        const isAvailable = exactVariant && exactVariant.available !== false && isImgAvailable;

        if (isAvailable) {
          swatch.style.display = '';
          swatch.classList.remove('swatch-hidden');
        } else {
          swatch.style.display = 'none';
          swatch.classList.add('swatch-hidden');
        }
      });

      // If active color became hidden, switch active to the first available visible color
      const currentActiveVisible = colorGroup.querySelector('.color-swatch-btn.active:not(.swatch-hidden)');
      if (!currentActiveVisible) {
        const firstVisible = colorGroup.querySelector('.color-swatch-btn:not(.swatch-hidden)');
        if (firstVisible) {
          colorSwatches.forEach((s) => s.classList.remove('active'));
          firstVisible.classList.add('active');
        }
      }
    }

    function resolveSelectedVariant() {
      if (!productVariants || productVariants.length === 0) return;

      const selectedOptions = {};
      optionGroups.forEach((group) => {
        const optIndex = parseInt(group.dataset.optionIndex);
        const activeColorBtn =
          group.querySelector('.color-swatch-btn.active:not(.swatch-hidden)') ||
          group.querySelector('.color-swatch-btn.active');
        const checkedRadio = group.querySelector('.size-pill-input:checked');

        let val = '';
        if (activeColorBtn) {
          val = activeColorBtn.dataset.optionValue;
        } else if (checkedRadio) {
          val = checkedRadio.value;
        }

        if (typeof optIndex === 'number' && !isNaN(optIndex)) {
          selectedOptions[optIndex] = val;
        }

        const valLabel = group.querySelector('.selected-option-value');
        if (valLabel && val) {
          valLabel.innerText = val;
        }
      });

      updateSizeDescription();

      const matchedVariant = productVariants.find((v) => {
        return v.options.every((optVal, idx) => {
          return !selectedOptions[idx] || optVal === selectedOptions[idx];
        });
      });

      if (matchedVariant) {
        if (variantIdInput) {
          variantIdInput.value = matchedVariant.id;
        }

        if (priceContainer) {
          priceContainer.dataset.basePrice = matchedVariant.price;
        }

        if (window.PodifaiCustomizer && window.PodifaiCustomizer.updatePrice) {
          window.PodifaiCustomizer.updatePrice();
        }

        let variantImgId = matchedVariant.featured_media?.id || matchedVariant.featured_image?.id;
        let variantImgUrl = matchedVariant.featured_media?.preview_image?.src || matchedVariant.featured_image?.src;

        // If matched variant has no image assigned, fallback to any variant with the same selected Color
        if (!variantImgId && !variantImgUrl) {
          const colorGroup = document.querySelector('.variant-option-group--colour, [data-option-name*="colo" i]');
          if (colorGroup) {
            const colorOptIdx = parseInt(colorGroup.dataset.optionIndex);
            const selectedColorVal = selectedOptions[colorOptIdx];
            if (selectedColorVal) {
              const colorVariantWithImg = productVariants.find(
                (v) => v.options[colorOptIdx] === selectedColorVal && (v.featured_image || v.featured_media)
              );
              if (colorVariantWithImg) {
                variantImgId = colorVariantWithImg.featured_media?.id || colorVariantWithImg.featured_image?.id;
                variantImgUrl =
                  colorVariantWithImg.featured_media?.preview_image?.src || colorVariantWithImg.featured_image?.src;
              }
            }
          }
        }

        if (variantImgId || variantImgUrl) {
          switchProductImage(variantImgId, variantImgUrl);
        }

        if (addToCartBtn) {
          if (!matchedVariant.available) {
            addToCartBtn.disabled = true;
            const btnText = document.getElementById('add-to-cart-text');
            if (btnText) btnText.innerHTML = 'SOLD OUT';
          } else {
            addToCartBtn.disabled = false;
            const btnText = document.getElementById('add-to-cart-text');
            if (btnText && !btnText.innerHTML.includes('Add to bag')) {
              btnText.innerHTML = `Add to bag · <span id="podifai-btn-price-display"></span>`;
              if (window.PodifaiCustomizer && window.PodifaiCustomizer.updatePrice) {
                window.PodifaiCustomizer.updatePrice();
              }
            }
          }
        }
      }
    }

    // Attach listeners to Color Swatches
    document.querySelectorAll('.color-swatch-btn').forEach((swatch) => {
      swatch.addEventListener('click', (e) => {
        if (swatch.classList.contains('swatch-hidden')) return;
        const group = swatch.closest('.variant-option-group');
        if (group) {
          group.querySelectorAll('.color-swatch-btn').forEach((s) => s.classList.remove('active'));
          swatch.classList.add('active');
        }
        resolveSelectedVariant();
      });
    });

    // Attach listeners to Size / Pill Swatches
    document.querySelectorAll('.size-pill-label').forEach((pill) => {
      pill.addEventListener('click', (e) => {
        const group = pill.closest('.variant-option-group');
        if (group) {
          group.querySelectorAll('.size-pill-label').forEach((p) => p.classList.remove('active'));
          pill.classList.add('active');
          const input = pill.querySelector('input');
          if (input) {
            input.checked = true;
          }
        }
        updateAvailableSwatches();
        resolveSelectedVariant();
      });
    });

    // Initial variant resolution & swatch filtering on page load
    updateAvailableSwatches();
    resolveSelectedVariant();
    updateSizeDescription();

    // Size Guide Modal Logic
    window.openSizeGuideModal = function (sectionId) {
      const modal = document.getElementById('SizeGuideModal-' + sectionId);
      if (modal) {
        modal.style.display = 'flex';
        // Force reflow
        void modal.offsetWidth;
        modal.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      }
    };

    window.closeSizeGuideModal = function (sectionId) {
      const modal = document.getElementById('SizeGuideModal-' + sectionId);
      if (modal) {
        modal.classList.remove('is-open');
        setTimeout(() => {
          if (!modal.classList.contains('is-open')) {
            modal.style.display = 'none';
          }
        }, 250);
        document.body.style.overflow = '';
      }
    };
  });
</script>

