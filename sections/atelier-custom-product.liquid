  .size-pill-label:hover {
    border-color: var(--podifai-primary-btn-bg);
  }

  .size-pill-input {
    display: none;
  }

  .size-pill-text {
    font-size: 0.88rem;
    font-weight: 600;
    color: #1a1a1a;
    transition: color 0.2s ease;
  }

  .size-pill-label.active {
    border-color: var(--podifai-primary-btn-bg);
    background-color: var(--podifai-primary-btn-bg);
  }

  .size-pill-label.active .size-pill-text {
    color: var(--podifai-primary-btn-text);
  }

  /* Size Dynamic Description */
  .size-description-container {
    margin-top: 8px;
    min-height: 18px;
  }

  .size-description-text {
    font-size: 0.82rem;
    color: #888888;
    line-height: 1.45;
    margin: 0;
  }

  /* Color Swatches */
  .color-circle-swatches {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    align-items: center;
  }

  .color-swatch-btn {
    position: relative;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.12);
    cursor: pointer;
    display: inline-block;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    padding: 0;
    outline: none;
  }

  .color-swatch-btn:hover {
    transform: scale(1.08);
  }

  .color-swatch-btn.active {
    box-shadow: 0 0 0 2px #ffffff, 0 0 0 4px var(--podifai-primary-btn-bg);
    border-color: transparent;
  }

  /* Add to Cart CTA */
  .product-submit-row {
    display: flex;
    gap: 12px;
    align-items: center;
    margin: 16px 0 24px 0;
  }

  .product-quantity-wrapper {
    display: inline-flex;
    align-items: center;
    border: 1.5px solid #D3D3D3;
    border-radius: 8px;
    background: #ffffff;
    height: 52px;
    box-sizing: border-box;
    overflow: hidden;
  }

  .quantity-btn {
    background: none;
    border: none;
    width: 38px;
    height: 100%;
    font-size: 1.2rem;
    font-weight: 500;
    color: #333333;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease;
  }

  .quantity-input {
    width: 44px;
    height: 100%;
    border: none;
    text-align: center;
    font-size: 0.95rem;
    font-weight: 600;
    color: #1a1a1a;
    background: transparent;
    outline: none;
    -moz-appearance: textfield;
  }

  .quantity-input::-webkit-outer-spin-button,
  .quantity-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .product-add-to-cart-btn {
    width: 100%;
    height: 52px;
    background-color: var(--podifai-atc-btn-bg);
    color: var(--podifai-atc-btn-text);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0 24px;
    transition: opacity 0.2s ease, transform 0.1s ease;
  }

  .product-add-to-cart-btn:hover {
    opacity: 0.93;
  }

  .product-add-to-cart-btn:active {
    transform: scale(0.99);
  }

  /* Accordions */
  .product-accordions {
    border-top: 1px solid #eeeeee;
    margin-top: 24px;
  }

  .product-accordion-item {
    border-bottom: 1px solid #eeeeee;
  }

  .product-accordion-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 0;
    font-weight: 600;
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    cursor: pointer;
    list-style: none;
    user-select: none;
    color: #333;
  }

  .product-accordion-summary::-webkit-details-marker {
    display: none;
  }

  .accordion-chevron {
    font-size: 0.9rem;
    color: #666;
    transition: transform 0.2s ease;
  }

  .product-accordion-item[open] .accordion-chevron {
    transform: rotate(180deg);
  }

  .product-accordion-body {
    padding-bottom: 16px;
    font-size: 0.88rem;
    color: var(--podifai-body-color);
    line-height: 1.6;
  }

  /* Size Guide Modal Popup */
  .size-guide-modal {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 999999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
  }

  .size-guide-modal.is-open {
    opacity: 1;
    visibility: visible;
  }

  .size-guide-modal__backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
