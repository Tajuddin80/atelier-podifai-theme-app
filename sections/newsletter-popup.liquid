      "max": 60,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "select",
      "id": "cookie_duration",
      "label": "Dismissal session duration",
      "info": "How long until the pop-up may appear again after dismissal.",
      "options": [
        {
          "value": "session",
          "label": "Until browser session ends"
        },
        {
          "value": "1",
          "label": "1 day"
        },
        {
          "value": "7",
          "label": "7 days"
        },
        {
          "value": "30",
          "label": "30 days"
        }
      ],
      "default": "session"
    },
    {
      "type": "checkbox",
