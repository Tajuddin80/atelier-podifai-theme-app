<style>
  #custom-features-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
  }

  #custom-features-{{ section.id }} .cf-container {
    max-width: {{ section.settings.section_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  #custom-features-{{ section.id }} .cf-border-wrapper {
    border-top: {{ section.settings.border_thickness }}px solid {{ section.settings.border_color }};
    border-bottom: {{ section.settings.border_thickness }}px solid {{ section.settings.border_color }};
    padding: {{ section.settings.inner_padding_vertical }}px 0;
  }

  #custom-features-{{ section.id }} .cf-grid {
    display: flex;
    justify-content: space-around;
    align-items: flex-start;
    gap: 40px;
    flex-wrap: wrap;
  }

  #custom-features-{{ section.id }} .cf-item {
    flex: 1;
    min-width: 250px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Indicator / Icon Styling */
  #custom-features-{{ section.id }} .cf-indicator-wrap {
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 24px;
  }

  #custom-features-{{ section.id }} .cf-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
  }

  #custom-features-{{ section.id }} .cf-icon-img {
    max-height: 24px;
    width: auto;
    object-fit: contain;
  }

  /* Typography Styling */
  #custom-features-{{ section.id }} .cf-heading {
    font-family: Georgia, serif;
    font-style: italic;
    font-weight: 400;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.heading_size_desktop }}px;
    line-height: 1.2;
    margin: 0 0 12px 0;
  }

  #custom-features-{{ section.id }} .cf-description {
    font-family: inherit;
    color: {{ section.settings.desc_color }};
    font-size: {{ section.settings.desc_size_desktop }}px;
    line-height: 1.5;
    margin: 0;
    max-width: 300px;
  }

  /* Mobile Responsive */
  @media screen and (max-width: 768px) {
    #custom-features-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #custom-features-{{ section.id }} .cf-heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }

    #custom-features-{{ section.id }} .cf-description {
      font-size: {{ section.settings.desc_size_mobile }}px;
    }

    #custom-features-{{ section.id }} .cf-grid {
      flex-direction: column;
      gap: 30px;
    }
  }
</style>

<div id="custom-features-{{ section.id }}" class="cf-section">
  <div class="cf-container">
    <div class="cf-border-wrapper">
      <div class="cf-grid">
        {%- for block in section.blocks -%}
          <div class="cf-item" {{ block.shopify_attributes }}>
            <div class="cf-indicator-wrap">
              {%- if block.settings.icon_image != blank -%}
                <img src="{{ block.settings.icon_image | img_url: '100x' }}" alt="{{ block.settings.heading | escape }}" class="cf-icon-img">
              {%- else -%}
                <span class="cf-dot" style="background-color: {{ block.settings.dot_color }};"></span>
              {%- endif -%}
            </div>

            {%- if block.settings.heading != blank -%}
              <h3 class="cf-heading">{{ block.settings.heading }}</h3>
            {%- endif -%}

            {%- if block.settings.description != blank -%}
              <div class="cf-description">{{ block.settings.description }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Feature Highlights",
  "settings": [
    {
      "type": "header",
      "content": "Layout & Sizing"
    },
    {
      "type": "range",
      "id": "section_width",
      "min": 600,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Section Max Width",
      "default": 1200
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FDFBF7"
    },
    {
      "type": "header",
      "content": "Borders"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Line Color",
      "default": "#E6E2D6"
    },
    {
      "type": "range",
      "id": "border_thickness",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "Border Line Thickness",
      "default": 1
    },
    {
      "type": "range",
      "id": "inner_padding_vertical",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Inner Vertical Spacing",
      "default": 45
    },
    {
      "type": "header",
      "content": "Padding (Desktop)"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Top Padding (Desktop)",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding (Desktop)",
      "default": 40
    },
    {
      "type": "header",
      "content": "Padding (Mobile)"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Top Padding (Mobile)",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding (Mobile)",
      "default": 20
    },
    {
      "type": "header",
      "content": "Typography Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading Text Color",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "desc_color",
      "label": "Description Text Color",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Typography Sizes"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Heading Size (Desktop)",
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Heading Size (Mobile)",
      "default": 22
    },
    {
      "type": "range",
      "id": "desc_size_desktop",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Description Size (Desktop)",
      "default": 14
    },
    {
      "type": "range",
      "id": "desc_size_mobile",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Description Size (Mobile)",
      "default": 13
    }
  ],
  "blocks": [
    {
      "type": "feature_item",
      "name": "Feature Column",
      "settings": [
        {
          "type": "header",
          "content": "Indicator (Dot or Icon)"
        },
        {
          "type": "color",
          "id": "dot_color",
          "label": "Dot Color (Fallback if no icon)",
          "default": "#E0A96D"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom Icon Image (Overrides Dot)"
        },
        {
          "type": "header",
          "content": "Text Content"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Celebrate"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Every moment is worth marking."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature Highlights",
      "blocks": [
        {
          "type": "feature_item",
          "settings": {
            "dot_color": "#E5B158",
            "heading": "Celebrate",
            "description": "Every moment is worth marking."
          }
        },
        {
          "type": "feature_item",
          "settings": {
            "dot_color": "#D96B6B",
            "heading": "Customise",
            "description": "Made entirely for you."
          }
        },
        {
          "type": "feature_item",
          "settings": {
            "dot_color": "#7D5E7B",
            "heading": "Joy",
            "description": "The feeling in everything we make."
          }
        }
      ]
    }
  ]
}
{% endschema %}