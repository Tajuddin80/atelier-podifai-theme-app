{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    background-color: {{ section.settings.section_bg_color }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }

  /* অ্যাডমিন প্যানেল থেকে কন্টেইনারের সাইজ কন্ট্রোল */
  .container-{{ section.id }} {
    width: 100%;
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  #cus-wrap-{{ section.id }} {
    background-color: {{ section.settings.grid_bg_color }};
  }

  #cus-wrap-{{ section.id }} .cus-icon-box i {
    color: {{ section.settings.icon_default_color }};
  }

  #cus-wrap-{{ section.id }} .cus-icon-box .cus-i-hover {
    color: {{ section.settings.icon_hover_color }} !important;
  }
{%- endstyle -%}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<div class="section-{{ section.id }}-padding" style="display: flex; justify-content: center; width: 100%; box-sizing: border-box;">
  
  <div class="container-{{ section.id }}">
    
    <div id="cus-wrap-{{ section.id }}" class="cus-features-wrapper">
      <div class="cus-features-grid">
        
        {%- for block in section.blocks -%}
          <div class="cus-feature-item" {{ block.shopify_attributes }}>
            <div class="cus-icon-box">
              <i class="{{ block.settings.icon_class }} cus-i-main"></i>
              <i class="{{ block.settings.icon_class }} cus-i-hover"></i>
            </div>
            <div class="cus-text-content">
              {%- if block.settings.heading != blank -%}
                <h3>{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.subtext != blank -%}
                <p>{{ block.settings.subtext | newline_to_br }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}

      </div>
    </div>

  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@700&family=Inter:wght@400;700&display=swap');

  .cus-features-wrapper * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
  }

  .cus-features-wrapper {
      font-family: 'Inter', sans-serif;
      border-radius: 100px;
      border: 1px solid #ddd;
      padding: 25px 50px;
      width: 100%;
      box-shadow: 0 5px 20px rgba(0,0,0,0.05);
  }

  .cus-features-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      align-items: center; /* সব আইটেম যেন সমানভাবে এলাইন থাকে */
  }

  .cus-feature-item {
      display: flex;
      align-items: center;
      gap: 15px;
      cursor: pointer;
      padding: 10px;
      border-right: 1px solid #eee;
  }

  .cus-feature-item:last-child {
      border-right: none;
  }

  /* FIXED: Added flex-shrink and updated display properties */
  .cus-icon-box {
      position: relative;
      width: 45px;
      height: 45px;
      overflow: hidden;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0; /* লেখা বেশি হলেও আইকন বক্স ছোট হবে না */
  }

  /* FIXED: Better transition alignment */
  .cus-icon-box i {
      position: absolute;
      font-size: 35px;
      left: 50%;
      transform: translate(-50%, -50%);
      transition: all 0.4s cubic-bezier(0.6, 0, 0.2, 1);
  }

  .cus-i-main {
      top: 50%;
  }

  .cus-i-hover {
      top: 150%;
  }

  .cus-feature-item:hover .cus-i-main {
      top: -50%;
  }

  .cus-feature-item:hover .cus-i-hover {
      top: 50%;
  }

  .cus-text-content {
      flex-grow: 1; /* টেক্সট বক্সকে পুরো জায়গা নিতে সাহায্য করবে */
  }

  .cus-text-content h3 {
      font-family: 'Oswald', sans-serif;
      font-size: 18px;
      text-transform: uppercase;
      margin-bottom: 2px;
      color: #111;
  }

  .cus-text-content p {
      font-size: 13px;
      color: #666;
      line-height: 1.3;
  }

  @media (max-width: 1024px) {
      .cus-features-grid {
          grid-template-columns: repeat(2, 1fr);
      }
      .cus-feature-item {
          border-right: none;
          border-bottom: 1px solid #eee;
          padding-bottom: 20px;
      }
      .cus-feature-item:last-child {
          border-bottom: none;
          padding-bottom: 10px;
      }
  }

  @media (max-width: 600px) {
      .cus-features-wrapper {
          border-radius: 30px;
          padding: 30px 20px;
      }
      .cus-features-grid {
          grid-template-columns: 1fr;
      }
  }
</style>

{% schema %}
{
  "name": "Custom Feature Grid",
  "settings": [
    {
      "type": "header",
      "content": "Container Layout Control"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 800,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Container Max Width",
      "default": 1250,
      "info": "width"
    },
    {
      "type": "header",
      "content": "Section Colors"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section Background Color",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "grid_bg_color",
      "label": "Grid Wrapper Background",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Icon Global Colors"
    },
    {
      "type": "color",
      "id": "icon_default_color",
      "label": "Icon Default Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "icon_hover_color",
      "label": "Icon Hover Color",
      "default": "#a71919"
    },
    {
      "type": "header",
      "content": "Section Padding (Desktop)"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 50
    },
    {
      "type": "header",
      "content": "Section Padding (Mobile)"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top Padding",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "feature_item",
      "name": "Feature Item",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "icon_class",
          "label": "FontAwesome Icon Class",
          "default": "fa-solid fa-truck-fast"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Fast Shipping"
        },
        {
          "type": "textarea",
          "id": "subtext",
          "label": "Subtext",
          "default": "Fast shipping\nFor your every order"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Feature Grid",
      "blocks": [
        {
          "type": "feature_item",
          "settings": {
            "icon_class": "fa-solid fa-truck-fast",
            "heading": "Fast Shipping",
            "subtext": "Fast shipping\nFor your every order"
          }
        },
        {
          "type": "feature_item",
          "settings": {
            "icon_class": "fa-solid fa-award",
            "heading": "Quality Products",
            "subtext": "Hand Made Watches Using\nHigh Quality Parts"
          }
        },
        {
          "type": "feature_item",
          "settings": {
            "icon_class": "fa-solid fa-money-check-dollar",
            "heading": "Returns Accepted",
            "subtext": "14 Days No Quibble\nRefund Policy"
          }
        },
        {
          "type": "feature_item",
          "settings": {
            "icon_class": "fa-solid fa-headset",
            "heading": "Online Support",
            "subtext": "Fast Support In A Fast\nWorld"
          }
        }
      ]
    }
  ]
}
{% endschema %}