    },
    {
      "type": "color",
      "id": "top_sub_color",
      "label": "Subheadings Color Accent",
      "default": "#707070"
    },
    {
      "type": "color",
      "id": "desc_color",
      "label": "Descriptions Color",
      "default": "#2b2b2b"
    },
    {
      "type": "color",
      "id": "badge_bg_color",
