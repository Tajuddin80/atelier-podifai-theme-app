{%- comment -%}
  Derives CSS variables from the menu typography settings for 2nd and 3rd level menu items.
  Accepts:
     settings: {block.settings}
{%- endcomment -%}

--menu-parent-font-family: 'Red Hat Text', var(--font-{{ settings.type_font_primary_link }}--family, sans-serif);
--menu-parent-font-style: normal;
--menu-parent-font-weight: 500;
--menu-parent-font-case: uppercase;
--menu-parent-font-size: 13px;
--menu-parent-font-line-height: 1.4;
--menu-parent-font-color: var(--color-foreground);
--menu-parent-active-font-color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));

--menu-child-font-family: 'Red Hat Text', var(--font-{{ settings.type_font_primary_link }}--family, sans-serif);
--menu-child-font-style: normal;
--menu-child-font-weight: 500;
--menu-child-font-case: uppercase;
--menu-child-font-size: 13px;
--menu-child-font-line-height: 1.4;
--menu-child-font-color: var(--color-foreground);
--menu-child-active-font-color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));

