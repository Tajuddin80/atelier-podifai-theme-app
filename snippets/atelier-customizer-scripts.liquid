<script src="{{ 'konva.min.js' | asset_url }}" defer></script>

{{ 'atelier-customizer.css' | asset_url | stylesheet_tag }}

<script>
  (function () {
    const BASE_STAGE_REF = 600;
    const configEl = document.getElementById('podifai-customizer-config');
    const CURRENCY_SYMBOL = configEl ? configEl.dataset.currencySymbol || 'RM' : 'RM';
    const PATCH_UNIT_PRICE = configEl ? parseFloat(configEl.dataset.patchPrice) || 6.0 : 6.0;
    const EMBROIDERY_UNIT_PRICE = configEl ? parseFloat(configEl.dataset.embroideryPrice) || 20.0 : 20.0;
    const PATCH_ADDON_VARIANT = configEl ? configEl.dataset.patchAddonVariant || '' : '';
    const EMBROIDERY_ADDON_VARIANT = configEl ? configEl.dataset.embroideryAddonVariant || '' : '';
    const ENABLE_ADDON = configEl ? configEl.dataset.enableAddon !== 'false' : true;
    const IMGBB_API_KEY = configEl ? (configEl.dataset.imgbbApiKey || '').trim() : '';
    const CLOUD_NAME = configEl ? configEl.dataset.cloudName || '' : '';
    const UPLOAD_PRESET = configEl ? configEl.dataset.uploadPreset || '' : '';
    const TEXT_INPUT_LABEL = '{{ custom_settings.text_input_label_text | default: "Your text" | escape }}';

    // Parse Patch Addon Variants & Inventory
    let patchVariantsList = [];
    const patchVariantsEl = document.getElementById('podifai-patch-addon-variants');
    if (patchVariantsEl) {
      try {
        patchVariantsList = JSON.parse(patchVariantsEl.textContent) || [];
      } catch (_) {}
    }

    // Auto-discover any newly added or renamed patch products from the store collection asynchronously
    try {
      const collHandle = (configEl && configEl.dataset.patchAddonsCollection) || 'patch-addons';
      fetch(`/collections/${collHandle}/products.json?limit=250`)
        .then((res) => (res.ok ? res.json() : null))
        .then((data) => {
          if (data && Array.isArray(data.products)) {
            let updated = false;
            data.products.forEach((prod) => {
              (prod.variants || []).forEach((v) => {
                if (!patchVariantsList.some((existing) => String(existing.id) === String(v.id))) {
                  patchVariantsList.push({
                    id: v.id,
                    title: v.title,
                    product_title: prod.title,
                    product_handle: prod.handle,
                    option1: v.option1 || null,
                    option2: v.option2 || null,
                    option3: v.option3 || null,
                    sku: v.sku || '',
                    image: (v.featured_image && v.featured_image.src) || (prod.images && prod.images[0] && prod.images[0].src) || '',
                    available: v.available !== false,
                    inventory_quantity: v.inventory_quantity || 0,
                    inventory_policy: v.inventory_policy || 'deny',
                    inventory_management: v.inventory_management || null,
                  });
                  updated = true;
                }
              });
            });
            if (updated && typeof updateUIBadges === 'function') {
              updateUIBadges();
            }
          }
        })
        .catch(() => {});
    } catch (_) {}

    // Floating Stock Notice Toast
    let stockToastTimer = null;
    function showStockToast(message) {
      let toast = document.getElementById('podifai-stock-toast');
      if (!toast) {
        toast = document.createElement('div');
        toast.id = 'podifai-stock-toast';
        toast.className = 'podifai-stock-toast';
        const canvasWrapper = document.getElementById('podifai-canvas-wrapper');
        if (canvasWrapper) {
          canvasWrapper.appendChild(toast);
        } else {
          document.body.appendChild(toast);
        }
      }
      toast.innerText = message;
      toast.style.display = 'flex';
      clearTimeout(stockToastTimer);
      stockToastTimer = setTimeout(() => {
        toast.style.display = 'none';
      }, 2800);
    }

    // Resolves Shopify Variant matching for a selected patch or letter
    function getVariantForPatch(patchInfo) {
      if (!patchVariantsList || patchVariantsList.length === 0) return null;

      const norm = (s) => (s || '').toLowerCase().replace(/[^a-z0-9]/g, '');

      // 1. Character Patches (e.g. "Sushi · P2", "Sushi #2", "Blossom", filename, SKU)
      if (patchInfo.type === 'character') {
        const raw = patchInfo.name || patchInfo.letterChar || 'Patch';
        let patchLabel = '';
        const m = raw.match(/^(.*?)\s*#(\d+)$/);
        if (m) {
          patchLabel = `${m[1].replace(/^[^\w\s]+/, '').trim()} · P${m[2]}`;
        } else {
          patchLabel = raw.replace(',', ' ·');
        }

        const targetNormLabel = norm(patchLabel);
        const targetNormName = norm(raw);
        const targetRefId = norm(patchInfo.patchRefId || patchInfo.patchId);
        const targetAlt = norm(patchInfo.alt);
        const targetFilename = norm((patchInfo.filename || '').replace(/\.[^/.]+$/, ''));
        const cat = (patchInfo.categoryLabel || patchInfo.category || '').toLowerCase().trim();
        const catNorm = norm(cat);
        const patchIdx = patchInfo.index ? String(patchInfo.index) : '';

        // Priority 1: Exact Title, Alt, or RefId match
        let found = patchVariantsList.find((v) => {
          const vt = (v.title || '').toLowerCase().trim();
          const vtNorm = norm(vt);
          if (!vtNorm) return false;
          if (vtNorm === targetNormLabel || vtNorm === targetNormName) return true;
          if (targetAlt && vtNorm === targetAlt) return true;
          if (targetRefId && vtNorm === targetRefId) return true;
          return false;
        });
        if (found) return found;

        // Priority 2: Category + Index match (e.g. "Category 1 · P2", "Cutie Faces · P2", or "P2" in matching product)
        if (patchIdx) {
          const expectedIndexTitle = norm(`P${patchIdx}`);
          found = patchVariantsList.find((v) => {
            const vt = (v.title || '').toLowerCase().trim();
            const vtNorm = norm(vt);
            const pTitle = norm(v.product_title || '');
            const pHandle = norm(v.product_handle || '');

            if (vtNorm === expectedIndexTitle || vtNorm === patchIdx) {
              if (!catNorm || pTitle.includes(catNorm) || pHandle.includes(catNorm)) {
                return true;
              }
            }
            if (
              vtNorm.endsWith(expectedIndexTitle) &&
              (!catNorm || pTitle.includes(catNorm) || vtNorm.includes(catNorm))
            ) {
              return true;
            }
            return false;
          });
          if (found) return found;
        }

        // Priority 3: Filename / SKU matching
        if (targetFilename) {
          found = patchVariantsList.find((v) => {
            const vSku = norm(v.sku || '');
            if (vSku && vSku === targetFilename) return true;
            const vImg = norm((v.image || '').split('/').pop()?.split('?')[0]?.replace(/\.[^/.]+$/, '') || '');
            if (vImg && (vImg === targetFilename || vImg.includes(targetFilename))) return true;
            return false;
          });
          if (found) return found;
        }

        return null;
      }

      // 2. Alphabet Letters (e.g. letter "P" in "Black Capital Letters")
      if (patchInfo.type === 'letter') {
        const char = (patchInfo.letter || patchInfo.name || patchInfo.letterChar || '').toUpperCase().trim();
        if (!char) return null;

        const charLower = char.toLowerCase();
        const cat = (patchInfo.categoryLabel || patchInfo.category || '').toLowerCase().trim();
        const catNorm = norm(cat);
        const fullExpectedNorm = norm(`${cat}${char}`);

        // Priority 1: Match directly via variant option1 (Style) and option2 (Letter)
        let found = patchVariantsList.find((v) => {
          if (!v) return false;
          if (v.option1 && v.option2) {
            const opt1Norm = norm(v.option1);
            const opt2Norm = (v.option2 || '').toUpperCase().trim();
            if (opt1Norm === catNorm && opt2Norm === char) return true;
          }
          if (v.option2 && v.option1) {
            const opt2Norm = norm(v.option2);
            const opt1Norm = (v.option1 || '').toUpperCase().trim();
            if (opt2Norm === catNorm && opt1Norm === char) return true;
          }
          return false;
        });
        if (found) return found;

        // Priority 2: Match within the same category or product by title
        found = patchVariantsList.find((v) => {
          const vt = (v.title || '').trim();
          const vtLower = vt.toLowerCase();
          const vtNorm = norm(vt);
          if (!vtNorm) return false;

          const pTitleNorm = norm(v.product_title || '');
          const pHandleNorm = norm(v.product_handle || '');
          const belongsToCat = !catNorm || pTitleNorm.includes(catNorm) || pHandleNorm.includes(catNorm) || vtNorm.includes(catNorm);

          // 2a: Full category + letter match (e.g. "Black Capital Letters / P" or "Black Capital Letters · P")
          if (vtNorm === fullExpectedNorm) return true;

          // 2b: Belongs to category and variant is standalone letter or ends with letter
          if (belongsToCat) {
            if (vt.toUpperCase() === char || vtLower === `letter ${charLower}`) return true;
            if (
              vtLower.endsWith(`· ${charLower}`) ||
              vtLower.endsWith(`- ${charLower}`) ||
              vtLower.endsWith(` ${charLower}`) ||
              vtLower.endsWith(` / ${charLower}`) ||
              vtLower.endsWith(`/${charLower}`) ||
              vtLower.endsWith(`. ${charLower}`) ||
              vtLower.endsWith(`.${charLower}`)
            ) {
              return true;
            }
          }
          return false;
        });

        if (found) return found;

        // Priority 3: Standalone letter fallback
        return (
          patchVariantsList.find((v) => {
            const vt = (v.title || '').trim();
            return vt.toUpperCase() === char || vt.toLowerCase() === `letter ${charLower}`;
          }) || null
        );
      }

      return null;
    }

    // Gets stock count & availability state for a patch
    function getPatchStockInfo(patchInfo) {
      const variant = getVariantForPatch(patchInfo);
      if (!variant) {
        return {
          variant: null,
          variantId: null,
          isTracked: false,
          isAvailable: true,
          qtyAvailable: 999,
          policy: 'continue',
          isSoldOut: false,
        };
      }

      const isTracked = variant.inventory_management === 'shopify';
      const isAvailable = variant.available !== false;
      const qtyAvailable = isTracked ? parseInt(variant.inventory_quantity) || 0 : 999;
      const policy = variant.inventory_policy || 'deny';
      const isSoldOut = !isAvailable || (isTracked && policy !== 'continue' && qtyAvailable <= 0);

      return {
        variant,
        variantId: variant.id,
        isTracked,
        isAvailable,
        qtyAvailable,
        policy,
        isSoldOut,
      };
    }

    // Updates UI stock badges and disabled states on patch picker buttons
    function updateButtonStockDisplay(btn, stock, selectedCount) {
      let stockTag = btn.querySelector('.podifai-stock-tag');

      if (!stock || !stock.isTracked) {
        if (stock && stock.isSoldOut) {
          btn.classList.add('is-sold-out');
          btn.setAttribute('aria-disabled', 'true');
          if (!stockTag) {
            stockTag = document.createElement('span');
            btn.appendChild(stockTag);
          }
          stockTag.className = 'podifai-stock-tag sold-out';
          stockTag.innerText = 'Sold Out';
        } else {
          btn.classList.remove('is-sold-out', 'max-stock-reached');
          btn.removeAttribute('aria-disabled');
          if (stockTag) stockTag.remove();
        }
        return;
      }

      if (stock.isSoldOut) {
        btn.classList.add('is-sold-out');
        btn.classList.remove('max-stock-reached');
        btn.setAttribute('aria-disabled', 'true');
        if (!stockTag) {
          stockTag = document.createElement('span');
          btn.appendChild(stockTag);
        }
        stockTag.className = 'podifai-stock-tag sold-out';
        stockTag.innerText = 'Sold Out';
      } else {
        btn.classList.remove('is-sold-out');
        const remaining = stock.qtyAvailable - selectedCount;

        if (remaining <= 0 && stock.policy !== 'continue') {
          btn.classList.add('max-stock-reached');
          btn.setAttribute('aria-disabled', 'true');
          if (!stockTag) {
            stockTag = document.createElement('span');
            btn.appendChild(stockTag);
          }
          stockTag.className = 'podifai-stock-tag sold-out';
          stockTag.innerText = 'Sold Out';
        } else {
          btn.classList.remove('max-stock-reached');
          btn.removeAttribute('aria-disabled');
          if (stockTag) stockTag.remove();
        }
      }
    }

    let selectedPatches = [];
    let stage = null;
    let layer = null;
    let transformer = null;
    let deleteBtnGroup = null;
    let rotateBtnGroup = null;
    let mediaContainerEl = null;

    // Multi-Text Embroidery State
    let embroideryLines = [
      {
        id: 'emb-line-1',
        text: '',
        font: "'DM Serif Display', Georgia, serif",
        color: '#FAF8F5',
        colorName: 'Ivory',
        node: null,
        relX: 0.5,
        relY: 0.5,
        baseFontSize: 44,
        baseScaleX: 1,
        baseScaleY: 1,
        rotation: 0,
      },
    ];
    let nextEmbroideryLineId = 2;

    // Active Categories Tracking
    const initialCharPill =
      document.querySelector('#podifai-char-categories .podifai-pill-btn.active') ||
      document.querySelector('#podifai-char-categories .podifai-pill-btn');
    let currentCharCategory = initialCharPill ? initialCharPill.dataset.charCat : '';

    const initialAlphabetPill =
      document.querySelector('#podifai-alphabet-categories .podifai-pill-btn.active') ||
      document.querySelector('#podifai-alphabet-categories .podifai-pill-btn');
    let currentAlphabetCategory = initialAlphabetPill ? initialAlphabetPill.dataset.cat : '';

    // Live Dynamic Surcharge Pricing & Summary Card Engine
    function updateDynamicPrice() {
      const priceEl = document.getElementById('podifai-product-price');
      const priceDisplayEl = document.getElementById('podifai-price-display');
      const btnPriceDisplayEl = document.getElementById('podifai-btn-price-display');
      const configEl = document.getElementById('podifai-customizer-config');

      let rawBase = 0;
      if (priceEl && priceEl.dataset.basePrice) {
        rawBase = parseFloat(priceEl.dataset.basePrice) || 0;
      } else if (configEl && configEl.dataset.basePrice) {
        rawBase = parseFloat(configEl.dataset.basePrice) || 0;
      }

      const basePrice = rawBase > 1000 ? rawBase / 100 : rawBase;

      const patchCount = selectedPatches.length;
      const activeEmbroideryCount = embroideryLines.filter((l) => l.text && l.text.trim().length > 0).length;

      const qtyInput = document.getElementById('product-quantity-input');
      const qty = parseInt(qtyInput ? qtyInput.value : 1) || 1;

      const patchTotal = patchCount * PATCH_UNIT_PRICE;
      const embroideryTotal = activeEmbroideryCount * EMBROIDERY_UNIT_PRICE;
      const unitTotal = basePrice + patchTotal + embroideryTotal;
      const grandTotal = unitTotal * qty;

      const formattedUnitPrice = `${CURRENCY_SYMBOL}${unitTotal.toFixed(2)}`;
      const formattedGrandPrice = `${CURRENCY_SYMBOL}${grandTotal.toFixed(2)}`;
      const formattedPatchTotal = `${CURRENCY_SYMBOL}${patchTotal.toFixed(2)}`;
      const formattedEmbroideryTotal = `${CURRENCY_SYMBOL}${embroideryTotal.toFixed(2)}`;
      const formattedBasePrice = `${CURRENCY_SYMBOL}${basePrice.toFixed(2)}`;

      if (priceDisplayEl) {
        priceDisplayEl.innerText = formattedUnitPrice;
      }
      if (btnPriceDisplayEl) {
        btnPriceDisplayEl.innerText = formattedGrandPrice;
      }

      // Step 3 bottom summary price
      const summaryPriceEl = document.getElementById('podifai-summary-price');
      if (summaryPriceEl) {
        summaryPriceEl.innerText = formattedPatchTotal;
      }

      // Step 3 header meta info
      const patchesHeaderCountText = document.getElementById('podifai-patches-header-count-text');
      const clearAllPatchesBtn = document.getElementById('podifai-clear-all-patches-btn');
      if (patchesHeaderCountText) {
        if (patchCount > 0) {
          patchesHeaderCountText.innerText = `${patchCount} added`;
          if (clearAllPatchesBtn) clearAllPatchesBtn.style.display = 'inline-block';
        } else {
          patchesHeaderCountText.innerText = '';
          if (clearAllPatchesBtn) clearAllPatchesBtn.style.display = 'none';
        }
      }

      // Live Order Breakdown Card
      const basePriceRow = document.getElementById('podifai-summary-base-price');
      if (basePriceRow) basePriceRow.innerText = formattedBasePrice;

      const checkedSize = document.querySelector('.variant-option-group--size .size-pill-input:checked, .size-pill-input:checked');
      const sizeVal = checkedSize ? checkedSize.value : '';
      const productNameEl = document.getElementById('podifai-summary-product-name');
      const productTitle = '{{ product.title | escape }}';
      if (productNameEl) {
        productNameEl.innerText = sizeVal ? `${productTitle} (${sizeVal})` : productTitle;
      }

      const patchesRow = document.getElementById('podifai-summary-patches-row');
      const patchesQtyEl = document.getElementById('podifai-summary-patches-qty');
      const patchesTotalEl = document.getElementById('podifai-summary-patches-total');
      if (patchesRow && patchesQtyEl && patchesTotalEl) {
        if (patchCount > 0) {
          patchesRow.style.display = 'flex';
          patchesQtyEl.innerText = patchCount;
          patchesTotalEl.innerText = formattedPatchTotal;
        } else {
          patchesRow.style.display = 'none';
        }
      }

      const embRow = document.getElementById('podifai-summary-embroidery-row');
      const embQtyEl = document.getElementById('podifai-summary-embroidery-qty');
      const embTotalEl = document.getElementById('podifai-summary-embroidery-total');
      if (embRow && embQtyEl && embTotalEl) {
        if (activeEmbroideryCount > 0) {
          embRow.style.display = 'flex';
          embQtyEl.innerText = activeEmbroideryCount;
          embTotalEl.innerText = formattedEmbroideryTotal;
        } else {
          embRow.style.display = 'none';
        }
      }

      const grandTotalEl = document.getElementById('podifai-summary-grand-total');
      if (grandTotalEl) grandTotalEl.innerText = formattedUnitPrice;

      return {
        basePrice,
        unitTotal,
        patchTotal,
        embroideryTotal,
        grandTotal,
        formattedPrice: formattedUnitPrice,
        formattedGrandPrice,
        patchCount,
        activeEmbroideryCount,
        quantity: qty,
      };
    }

    // Filter Character Patches Grid
    function filterCharacterPatchesGrid() {
      const activePill =
        document.querySelector('#podifai-char-categories .podifai-pill-btn.active') ||
        document.querySelector('#podifai-char-categories .podifai-pill-btn');
      if (activePill) {
        currentCharCategory =
          activePill.dataset.charCat || activePill.dataset.category || activePill.textContent.trim();
        updateCharacterSublabel(activePill);
      }

      const items = document.querySelectorAll('#podifai-character-patches .podifai-patch-item');
      if (items.length === 0) return;

      const normCurrent = (currentCharCategory || '').toLowerCase().replace(/[^a-z0-9]/g, '');

      items.forEach((btn) => {
        const rawCat = btn.dataset.charCategory || btn.dataset.category || '';
        const normCat = rawCat.toLowerCase().replace(/[^a-z0-9]/g, '');

        if (
          !normCat ||
          !normCurrent ||
          normCat === normCurrent ||
          normCurrent.includes(normCat) ||
          normCat.includes(normCurrent)
        ) {
          btn.classList.remove('hidden');
          btn.style.display = '';
        } else {
          btn.classList.add('hidden');
          btn.style.display = 'none';
        }
      });
    }

    // Dynamic Letter Patch SVG Generator
    function getLetterPatchImageUrl(category, letterChar) {
      const charUpper = (letterChar || 'A').toUpperCase();
      const charLower = (letterChar || 'a').toLowerCase();
      const catLower = (category || '').toLowerCase();

      if (catLower.includes('blue')) {
        const svgString = `<svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 120 120">
          <text x="60" y="80" font-size="76" font-weight="900" font-family="'Arial Black', sans-serif" fill="#0091EA" stroke="#FFFFFF" stroke-width="6" stroke-linejoin="round" text-anchor="middle">${charUpper}</text>
        </svg>`;
        return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svgString);
      } else if (catLower.includes('pink')) {
        const svgString = `<svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 120 120">
          <text x="60" y="80" font-size="76" font-weight="900" font-family="'Arial Black', sans-serif" fill="#E91E63" stroke="#FFFFFF" stroke-width="6" stroke-linejoin="round" text-anchor="middle">${charUpper}</text>
        </svg>`;
        return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svgString);
      } else if (catLower.includes('yellow')) {
        const svgString = `<svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 120 120">
          <text x="60" y="80" font-size="76" font-weight="900" font-family="'Arial Black', sans-serif" fill="#FFC107" stroke="#FFFFFF" stroke-width="6" stroke-linejoin="round" text-anchor="middle">${charUpper}</text>
        </svg>`;
        return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svgString);
      } else if (catLower.includes('mix')) {
        const rainbowColors = ['#E91E63', '#FF5722', '#FFC107', '#4CAF50', '#2196F3', '#9C27B0'];
        const charCode = (letterChar || 'A').charCodeAt(0) || 0;
        const color = rainbowColors[charCode % rainbowColors.length];
        const svgString = `<svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 120 120">
          <text x="60" y="80" font-size="76" font-weight="900" font-family="'Arial Black', sans-serif" fill="${color}" stroke="#FFFFFF" stroke-width="6" stroke-linejoin="round" text-anchor="middle">${charUpper}</text>
        </svg>`;
        return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svgString);
      } else {
        // Default / Black caps
        const svgString = `<svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 120 120">
          <text x="60" y="80" font-size="76" font-weight="900" font-family="'Impact', 'Arial Black', sans-serif" fill="#1A1A1A" stroke="#FFFFFF" stroke-width="5" stroke-linejoin="round" text-anchor="middle">${charUpper}</text>
        </svg>`;
        return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svgString);
      }
    }

    // Filter Alphabet Letter Grid
    function updateAlphabetGrid() {
      const activeAlphaPill =
        document.querySelector('#podifai-alphabet-categories .podifai-pill-btn.active') ||
        document.querySelector('#podifai-alphabet-categories .podifai-pill-btn');
      if (activeAlphaPill) {
        currentAlphabetCategory =
          activeAlphaPill.dataset.cat || activeAlphaPill.dataset.category || activeAlphaPill.textContent.trim();
        updateAlphabetSublabel(activeAlphaPill);
      }

      const normCurrent = (currentAlphabetCategory || '').toLowerCase().replace(/[^a-z0-9]/g, '');
      const items = document.querySelectorAll('#podifai-alphabet-grid .podifai-letter-item');

      items.forEach((btn) => {
        const rawCat = btn.dataset.letterCategory || btn.dataset.category || '';
        const normCat = rawCat.toLowerCase().replace(/[^a-z0-9]/g, '');
        const letter = btn.dataset.letter;
        const imgEl = btn.querySelector('.podifai-letter-img');
        const customImg = btn.dataset.customImg;

        if (
          !normCat ||
          !normCurrent ||
          normCat === normCurrent ||
          normCurrent.includes(normCat) ||
          normCat.includes(normCurrent)
        ) {
          btn.classList.remove('hidden');
          btn.style.display = '';
          if (imgEl) {
            imgEl.src = customImg || getLetterPatchImageUrl(currentAlphabetCategory, letter);
          }
        } else {
          btn.classList.add('hidden');
          btn.style.display = 'none';
        }
      });
    }

    function formatDimensionString(rawStr) {
      if (!rawStr) return '8cm x 8cm';
      let clean = rawStr.toString().trim();
      const nums = clean.match(/(\d+(?:\.\d+)?)/g);
      if (!nums || nums.length === 0) return '8cm x 8cm';
      const w = nums[0];
      const h = nums.length > 1 ? nums[1] : w;
      return `${w}cm x ${h}cm`;
    }

