    function getPatchDimensionsPx(sizeStr, patchType) {
      const isCharEnabled = {{ char_scale_on | json }};
      const isAlphaEnabled = {{ alpha_scale_on | json }};

      const isScalingActive = patchType === 'letter' ? isAlphaEnabled : isCharEnabled;

      if (!isScalingActive) {
        return { width: 95, height: 95 };
      }

      if (!sizeStr) return { width: 95, height: 95 };

      const numbers = sizeStr.toString().match(/(\d+(?:\.\d+)?)/g);
      if (!numbers || numbers.length === 0) return { width: 95, height: 95 };

      // Use dominant dimension (e.g. 6cm from "6cm x 4cm", 5cm from "5cm x 5cm", 2cm from "2cm x 2cm")
      const parsed = numbers.map((n) => parseFloat(n)).filter((n) => !isNaN(n));
      let maxCm = Math.max(...parsed);

      // Clamp to reasonable physical bounds
      maxCm = Math.max(1, Math.min(maxCm, 12));

      // Compact visual scaling — 15px per cm for clear size differentiation:
      //   2cm x 2cm     -> 40px x 40px
      //   3cm x 3cm     -> 55px x 55px
      //   4cm x 4cm     -> 70px x 70px
      //   5cm x 5cm     -> 85px x 85px
      //   5.5cm x 5.5cm -> 93px x 93px
      //   6cm x 4cm     -> 100px x 100px
      //   8cm x 8cm     -> 130px x 130px
      const visualPx = Math.min(135, Math.round(40 + (maxCm - 2) * 15));

      return {
        width: Math.max(35, visualPx),
        height: Math.max(35, visualPx),
      };
    }

