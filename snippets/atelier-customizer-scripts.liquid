    // ==========================================
    // MULTI-TEXT EMBROIDERY MANAGEMENT SYSTEM
    // ==========================================
    const embroideryLinesContainer = document.getElementById('podifai-embroidery-lines');
    const addTextBtn = document.getElementById('podifai-add-text-btn');
    const threadSource = document.getElementById('podifai-thread-options-source');

    function updateEmbroideryLineNode(lineObj, lineIndex) {
      if (!stage || !layer) return;

      const trimmedText = (lineObj.text || '').trim();

      if (!trimmedText) {
        if (lineObj.node) {
          lineObj.node.destroy();
          lineObj.node = null;
          transformer.nodes([]);
          layer.draw();
        }
        updateDynamicPrice();
        checkPatchOverlaps();
        return;
      }

      const currentW = stage.width();
      const currentH = stage.height();
      const scaleFactor = currentW / BASE_STAGE_REF;
      const baseFontSize = 44;
      const MAX_EMB_WIDTH = Math.min(240 * scaleFactor, currentW * 0.48);

      const activeEmbLines = embroideryLines.filter((l) => (l.text || '').trim().length > 0);
      const totalActive = activeEmbLines.length || 1;
      const embSpacing = 42 * scaleFactor;
      const defaultCenterX = currentW / 2;
      const activeLineIndex = Math.max(0, activeEmbLines.indexOf(lineObj));
      const defaultCenterY = currentH * 0.50 + (activeLineIndex - (totalActive - 1) / 2) * embSpacing;

      // Embroidery is intentionally fixed to the centre of the bag preview.
      // Multiple lines remain grouped around that centre point.
      const targetX = defaultCenterX;
      const targetY = defaultCenterY;
      lineObj.isCustomMoved = false;
      lineObj.relX = defaultCenterX / currentW;
      lineObj.relY = defaultCenterY / currentH;
      lineObj.baseFontSize = baseFontSize;

      const isGaramond = lineObj.font && lineObj.font.includes('Garamond');
      const isItalic =
        lineObj.font.includes('Chancery') ||
        lineObj.font.includes('Picturama') ||
        lineObj.font.includes('Brush Script');

      const resolvedFontFamily = isGaramond ? "'EB Garamond', serif" : lineObj.font;
      const fontStyleStr = isItalic ? 'italic' : (isGaramond ? '500' : 'normal');

      if (!lineObj.node) {
        const node = new Konva.Text({
          x: targetX,
          y: targetY,
          text: lineObj.text,
          fontSize: baseFontSize * scaleFactor,
          fontFamily: resolvedFontFamily,
          fontStyle: fontStyleStr,
          fill: lineObj.color,
          align: 'center',
          draggable: false,
        });

        node._dragStartX = targetX;
        node._dragStartY = targetY;
        node._dragLockAxis = null;

        // Enforce ~8cm proportion constraint
        if (node.width() > MAX_EMB_WIDTH) {
          node.fontSize(baseFontSize * scaleFactor * (MAX_EMB_WIDTH / node.width()));
        }
        node.offsetX(node.width() / 2);
        node.offsetY(node.height() / 2);

        node.on('click tap', () => {
          if (transformer) {
            transformer.nodes([]);
            updateTransformerButtonsPosition();
          }
          const inputEl = document.querySelector(`.podifai-embroidery-card[data-line-id="${lineObj.id}"] .podifai-text-input`);
          if (inputEl) inputEl.focus();
        });

        layer.add(node);
        lineObj.node = node;
      } else {
        lineObj.node.text(lineObj.text);
        lineObj.node.fontFamily(resolvedFontFamily);
        lineObj.node.fontStyle(fontStyleStr);
        lineObj.node.fill(lineObj.color);
        lineObj.node.fontSize(baseFontSize * scaleFactor);

        // Enforce ~8cm proportion constraint
        if (lineObj.node.width() > MAX_EMB_WIDTH) {
          lineObj.node.fontSize(baseFontSize * scaleFactor * (MAX_EMB_WIDTH / lineObj.node.width()));
        }
        lineObj.node.offsetX(lineObj.node.width() / 2);
        lineObj.node.offsetY(lineObj.node.height() / 2);

        lineObj.node.x(targetX);
        lineObj.node.y(targetY);
        lineObj.node._dragStartX = targetX;
        lineObj.node._dragStartY = targetY;
        lineObj.node._dragLockAxis = null;
        lineObj.node.draggable(false);
      }

      updateTransformerButtonsPosition();
      updateDynamicPrice();
      checkPatchOverlaps();
    }

    function getFontDisplayName(fontStr) {
      if (!fontStr) return 'DM Serif Display';
      if (fontStr.includes('Garamond')) return 'EB Garamond';
      if (fontStr.includes('Chancery')) return 'Chancery';
      if (fontStr.includes('DM Serif Display')) return 'DM Serif Display';
      if (fontStr.includes('Picturama Founder')) return 'Picturama Founder';
      if (fontStr.includes('Georgia')) return 'DM Serif Display';
      if (fontStr.includes('Brush Script')) return 'Picturama Founder';
      return 'DM Serif Display';
    }

    function renderEmbroideryLinesUI() {
      if (!embroideryLinesContainer) return;

      embroideryLinesContainer.innerHTML = '';

      embroideryLines.forEach((line, index) => {
        // Fallback removed Gill Sans / Inter font to DM Serif Display
        if (line.font && (line.font.includes('Gill Sans') || line.font.includes('Inter'))) {
          line.font = "'DM Serif Display', Georgia, serif";
          if (line.node) line.node.fontFamily(line.font);
        }
        if (line.font && line.font.includes('Garamond')) {
          line.font = "'EB Garamond', serif";
        }

        const card = document.createElement('div');
        card.className = 'podifai-embroidery-card';
        card.dataset.lineId = line.id;

        card.innerHTML = `
          ${
            embroideryLines.length > 1
              ? `<div class="podifai-card-header">
                  <span class="podifai-card-title">Embroidery Text #${index + 1}</span>
                  <button type="button" class="podifai-card-remove" data-id="${line.id}">&times; Remove</button>
                </div>`
              : ''
          }

          <!-- Font Style Picker -->
          <div class="podifai-field-group">
            <label class="podifai-field-label">Font: <strong class="podifai-selected-font-name">${getFontDisplayName(line.font)}</strong></label>
            <div class="podifai-font-picker">
              <button type="button" class="podifai-font-btn ${
                line.font.includes('DM Serif Display') || line.font.includes('Georgia') ? 'active' : ''
              }" data-font="'DM Serif Display', Georgia, serif" style="font-family: 'DM Serif Display', Georgia, serif;" title="DM Serif Display">
                Aa
              </button>
              <button type="button" class="podifai-font-btn ${
                line.font.includes('Picturama Founder') || line.font.includes('Brush Script') ? 'active' : ''
              }" data-font="'Picturama Founder', 'Brush Script MT', cursive" style="font-family: 'Picturama Founder', 'Brush Script MT', cursive; font-style: italic; font-weight: normal;" title="Picturama Founder">
                Aa
              </button>
              <button type="button" class="podifai-font-btn ${
                line.font.includes('Garamond') ? 'active' : ''
              }" data-font="'EB Garamond', serif" style="font-family: 'EB Garamond', serif; font-weight: 500;" title="EB Garamond">
                Aa
              </button>
              <button type="button" class="podifai-font-btn ${
                line.font.includes('Chancery') ? 'active' : ''
              }" data-font="'Apple Chancery', 'Zapf Chancery', cursive" style="font-family: 'Apple Chancery', 'Zapf Chancery', cursive; font-style: italic;" title="Chancery">
                Aa
              </button>
            </div>
          </div>

          <!-- Text Input -->
          <div class="podifai-field-group">
            <div class="podifai-field-label-row">
              <label class="podifai-field-label">${TEXT_INPUT_LABEL}</label>
              <span class="podifai-char-counter">${(line.text || '').length}/10</span>
            </div>
            <input
              type="text"
              class="podifai-text-input"
              maxlength="10"
              value="${line.text || ''}"
              autocomplete="off"
            >
          </div>

          <!-- Thread Color Picker -->
          <div class="podifai-field-group">
            <label class="podifai-field-label">Thread colour: <strong class="podifai-selected-thread-name">${
              line.colorName || 'Ivory'
            }</strong></label>
            <div class="podifai-color-picker">
              ${threadSource ? threadSource.innerHTML : ''}
            </div>
          </div>
        `;

        const swatches = card.querySelectorAll('.podifai-color-swatch');
        const threadNameLabel = card.querySelector('.podifai-selected-thread-name');

        swatches.forEach((sw) => {
          if (sw.dataset.color.toLowerCase() === line.color.toLowerCase()) {
            sw.classList.add('active');
          }
          sw.addEventListener('click', () => {
            swatches.forEach((s) => s.classList.remove('active'));
            sw.classList.add('active');
            line.color = sw.dataset.color;
            line.colorName = sw.dataset.colorName || sw.title || 'Selected';
            if (threadNameLabel) {
              threadNameLabel.innerText = line.colorName;
            }
            updateEmbroideryLineNode(line, index);
          });
        });

        const fontBtns = card.querySelectorAll('.podifai-font-btn');
        const fontNameLabel = card.querySelector('.podifai-selected-font-name');
        fontBtns.forEach((fb) => {
          fb.addEventListener('click', () => {
            fontBtns.forEach((b) => b.classList.remove('active'));
            fb.classList.add('active');
            line.font = fb.dataset.font;
            if (fontNameLabel) {
              fontNameLabel.innerText = getFontDisplayName(line.font);
            }
            updateEmbroideryLineNode(line, index);
            if (document.fonts && typeof document.fonts.load === 'function') {
              try {
                document.fonts.load(`16px ${line.font}`).then(() => {
                  if (stage && layer) {
                    updateEmbroideryLineNode(line, index);
                    layer.batchDraw();
                  }
                });
              } catch (_) {}
            }
          });
        });

        const textInput = card.querySelector('.podifai-text-input');
        const charCounter = card.querySelector('.podifai-char-counter');
        textInput.addEventListener('input', (e) => {
          line.text = e.target.value;
          if (charCounter) charCounter.innerText = `${line.text.length}/10`;
          updateEmbroideryLineNode(line, index);
          // A newly added/removed line changes the centred stack, so recalculate
          // the other active embroidery lines as well.
          embroideryLines.forEach((otherLine, otherIndex) => {
            if (otherLine !== line && (otherLine.text || '').trim()) {
              updateEmbroideryLineNode(otherLine, otherIndex);
            }
          });
        });

        const removeBtn = card.querySelector('.podifai-card-remove');
        if (removeBtn) {
          removeBtn.addEventListener('click', () => {
            if (line.node) {
              line.node.destroy();
              transformer.nodes([]);
              layer.draw();
            }
            embroideryLines = embroideryLines.filter((l) => l.id !== line.id);
            embroideryLines.forEach((otherLine, otherIndex) => {
              if ((otherLine.text || '').trim()) updateEmbroideryLineNode(otherLine, otherIndex);
            });
            renderEmbroideryLinesUI();
            updateDynamicPrice();
            checkPatchOverlaps();
          });
        }

        embroideryLinesContainer.appendChild(card);
      });
    }

    if (addTextBtn) {
      addTextBtn.addEventListener('click', () => {
        const newLine = {
          id: `emb-line-${nextEmbroideryLineId++}`,
          text: '',
          font: "'Brush Script MT', cursive",
          color: '#FAF8F5',
          colorName: 'Ivory',
          node: null,
          relX: 0.5,
          relY: 0.5,
          baseFontSize: 28,
          baseScaleX: 1,
          baseScaleY: 1,
          rotation: 0,
        };
        embroideryLines.push(newLine);
        renderEmbroideryLinesUI();
        updateDynamicPrice();
      });
    }

    // Ultra High-Definition Composite Snapshot Generator for Cloudinary
    async function generateFullCustomizationSnapshot() {
      try {
        const activeImgEl =
          document.querySelector('.product-image-wrapper.active img') ||
          document.querySelector('.product-main-image') ||
          document.querySelector('.product-images img');

        const exportW = 1200;
        const exportH = 1200;

        const exportCanvas = document.createElement('canvas');
        exportCanvas.width = exportW;
        exportCanvas.height = exportH;
        const ctx = exportCanvas.getContext('2d');
        if (!ctx) return null;
        ctx.imageSmoothingEnabled = true;
        ctx.imageSmoothingQuality = 'high';

        // 1. Draw product background image
        if (activeImgEl && (activeImgEl.complete || activeImgEl.naturalWidth > 0)) {
          try {
            const imgW = activeImgEl.naturalWidth || exportW;
            const imgH = activeImgEl.naturalHeight || exportH;
            const imgRatio = imgW / imgH;
            const containerRatio = exportW / exportH;

            let drawW, drawH, drawX, drawY;
            if (imgRatio > containerRatio) {
              drawW = exportW;
              drawH = exportW / imgRatio;
              drawX = 0;
              drawY = (exportH - drawH) / 2;
            } else {
              drawH = exportH;
              drawW = exportH * imgRatio;
              drawX = (exportW - drawW) / 2;
              drawY = 0;
            }

            ctx.drawImage(activeImgEl, drawX, drawY, drawW, drawH);
          } catch (e) {
            console.warn('Background draw note:', e);
          }
        }

        // 2. Temporarily detach transformer & hide delete and rotate buttons for clean export
        if (deleteBtnGroup) {
          deleteBtnGroup.visible(false);
        }
        if (rotateBtnGroup) {
          rotateBtnGroup.visible(false);
        }
        if (transformer) {
          transformer.detach();
        }
        if (layer) {
          layer.draw();
        }

        // 3. Draw Konva canvas elements in high resolution
        if (stage) {
          const konvaDataUrl = stage.toDataURL({ pixelRatio: 2 });
          await new Promise((resolve) => {
            const konvaImg = new Image();
            konvaImg.crossOrigin = 'anonymous';
            konvaImg.onload = () => {
              try {
                ctx.drawImage(konvaImg, 0, 0, exportW, exportH);
              } catch (_) {}
              resolve();
            };
            konvaImg.onerror = () => resolve();
            konvaImg.src = konvaDataUrl;
          });
        }

        return exportCanvas.toDataURL('image/png');
      } catch (err) {
        console.warn('Snapshot generation note:', err);
        return null;
      }
    }

    // Direct Image Upload Function (ImgBB Direct Upload with Cloudinary Fallback)
    async function uploadPreviewToCloudinary(base64Data) {
      return uploadPreviewImage(base64Data);
    }

    async function uploadPreviewImage(base64Data) {
      if (!base64Data || typeof base64Data !== 'string' || !base64Data.startsWith('data:image')) {
        return null;
      }

      // 1. Primary: Direct ImgBB API Upload (Preserves 100% untouched original full resolution)
      if (IMGBB_API_KEY) {
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 5000);

        try {
          const formData = new FormData();
          // Extract base64 payload cleanly
          const base64Body = base64Data.replace(/^data:image\/[a-z]+;base64,/, '');
          formData.append('image', base64Body);
          formData.append('key', IMGBB_API_KEY);

          const res = await fetch(`https://api.imgbb.com/1/upload?key=${encodeURIComponent(IMGBB_API_KEY)}`, {
            method: 'POST',
            body: formData,
            signal: controller.signal,
          });

          clearTimeout(timeoutId);

          if (res.ok) {
            const result = await res.json();
            if (result && result.success && result.data) {
              // Direct high-quality original file URL (https://i.ibb.co/...)
              const directFullResUrl = result.data.url || (result.data.image && result.data.image.url);
              if (directFullResUrl && typeof directFullResUrl === 'string' && directFullResUrl.startsWith('http')) {
                return directFullResUrl;
              }
            }
          } else {
            console.warn('ImgBB upload returned non-200 status code:', res.status);
          }
        } catch (err) {
          if (err.name === 'AbortError') {
            console.warn('ImgBB upload timed out after 5s; proceeding without preview link.');
          } else {
            console.warn('ImgBB upload error:', err);
          }
        } finally {
          clearTimeout(timeoutId);
        }
      }

      // 2. Fallback: Cloudinary (if IMGBB_API_KEY not configured but Cloudinary credentials exist)
      if (CLOUD_NAME && UPLOAD_PRESET) {
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 4500);

        try {
          const formData = new FormData();
          formData.append('file', base64Data);
          formData.append('upload_preset', UPLOAD_PRESET);
          formData.append('folder', 'podifai_customizations');

          const res = await fetch(`https://api.cloudinary.com/v1_1/${CLOUD_NAME}/image/upload`, {
            method: 'POST',
            body: formData,
            signal: controller.signal,
          });

          clearTimeout(timeoutId);

          if (res.ok) {
            const data = await res.json();
            if (data && (data.secure_url || data.url)) {
              return data.secure_url || data.url;
            }
          } else {
            console.warn('Cloudinary upload returned non-200 status code:', res.status);
          }
        } catch (err) {
          if (err.name === 'AbortError') {
            console.warn('Cloudinary upload timed out after 4.5s; proceeding without preview link.');
          } else {
            console.warn('Cloudinary upload failed:', err);
          }
        } finally {
          clearTimeout(timeoutId);
        }
      }

      return null;
    }

    // Custom AJAX Add to Cart Handler
    async function handleCustomAddToCart(form) {
      // Validate patch overlaps
      if (checkPatchOverlaps()) {
        const toast = document.getElementById('podifai-overlap-error-toast');
        if (toast) {
          toast.style.display = 'flex';
          toast.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        return false;
      }

      const btn = form.querySelector('[type="submit"]') || document.getElementById('add-to-cart-btn');
      const originalBtnHTML = btn ? btn.innerHTML : 'Add to bag';

      if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<span>Capturing preview...</span>';
      }

      const fullMergedSnapshot = await generateFullCustomizationSnapshot();
      const priceInfo = updateDynamicPrice() || {};
      const mainVariantId =
        form.querySelector('[name="id"]')?.value || document.getElementById('selected-variant-id')?.value;
      const qty = parseInt(form.querySelector('[name="quantity"]')?.value) || 1;

      if (!mainVariantId) {
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = originalBtnHTML;
        }
        return false;
      }

      const mainProductTitle = document.querySelector('.product-title')?.innerText || 'Customized Product';

      const activeEmbLines = embroideryLines.filter((l) => l.text && l.text.trim() !== '');

      // Deterministic signature based on variant, selected patches, and embroidery
      function computeCustomizationSignature(variantId, patches, embLines) {
        const patchParts = (patches || [])
          .map((p) =>
            `${p.id || ''}:${p.category || ''}:${p.letterChar || ''}:${Math.round((parseFloat(p.relX) || 0) * 100)}:${Math.round(
              (parseFloat(p.relY) || 0) * 100
            )}:${Math.round(parseFloat(p.rotation) || 0)}`
          )
          .sort()
          .join('|');

        const embParts = (embLines || [])
          .map((l) =>
            `${l.text.trim()}:${(l.font || '').split(',')[0].replace(/['"]/g, '').trim()}:${(l.colorName || l.color || '').trim()}:${Math.round(
              (parseFloat(l.relX) || 0) * 100
            )}:${Math.round((parseFloat(l.relY) || 0) * 100)}`
          )
          .join('|');

        const raw = `${variantId}__P_${patchParts}__E_${embParts}`;
        let hash = 0x811c9dc5;
        for (let i = 0; i < raw.length; i++) {
          hash ^= raw.charCodeAt(i);
          hash = Math.imul(hash, 0x01000193);
        }
        return (hash >>> 0).toString(36);
      }

      const customSig = computeCustomizationSignature(mainVariantId, selectedPatches, activeEmbLines);
      const bundleId = 'bundle_' + mainVariantId + '_' + customSig;

      // Cache preview image URL by signature so identical customizations share the same exact URL & properties
      let previewImageUrl = null;
      try {
        const cacheKey = 'podifai_prev_' + mainVariantId + '_' + customSig;
        const cachedUrl = sessionStorage.getItem(cacheKey);
        if (cachedUrl && cachedUrl.startsWith('http')) {
          previewImageUrl = cachedUrl;
        } else if (fullMergedSnapshot) {
          previewImageUrl = await uploadPreviewImage(fullMergedSnapshot);
          if (previewImageUrl && previewImageUrl.startsWith('http')) {
            try {
              sessionStorage.setItem(cacheKey, previewImageUrl);
            } catch (_) {}
          }
        }
      } catch (uploadErr) {
        console.warn('Preview upload skipped due to error:', uploadErr);
        previewImageUrl = null;
      }

      const mainItemProperties = {
        _bundle_id: bundleId,
        _customization_signature: customSig,
      };

      activeEmbLines.forEach((line, idx) => {
        const embKey = activeEmbLines.length > 1 ? `_Embroidery ${idx + 1}` : '_Embroidery';
        mainItemProperties[embKey] = `${line.text} (${getFontDisplayName(line.font)}, ${
          line.colorName || line.color
        })`;
      });

      mainItemProperties['_Customisation Breakdown'] = `${priceInfo.patchCount || 0} Patches (+${CURRENCY_SYMBOL}${(
        priceInfo.patchTotal || 0
      ).toFixed(2)}), ${priceInfo.activeEmbroideryCount || 0} Embroidery (+${CURRENCY_SYMBOL}${(
        priceInfo.embroideryTotal || 0
      ).toFixed(2)})`;
      mainItemProperties['_Total Custom Price'] =
        priceInfo.formattedPrice || `${CURRENCY_SYMBOL}${(priceInfo.grandTotal || 0).toFixed(2)}`;
      mainItemProperties['_Base Product Price'] = `${CURRENCY_SYMBOL}${(priceInfo.basePrice || 0).toFixed(2)}`;

      // Only set _Preview if a valid HTTP URL was generated from ImgBB or Cloudinary.
      // Never fall back to massive base64 data URLs which cause Shopify /cart/add.js or checkout payload errors.
      if (previewImageUrl && typeof previewImageUrl === 'string' && previewImageUrl.startsWith('http')) {
        mainItemProperties['_Preview'] = previewImageUrl;
      }

      if (selectedPatches.length > 0) {
        mainItemProperties['_Selected Patches'] = selectedPatches.map((p) => p.letterChar || 'Patch').join(', ');
      }

      mainItemProperties['_Customization Data'] = JSON.stringify({
        signature: customSig,
        pricing: priceInfo,
        patches: selectedPatches.map((p, idx) => ({
          order: idx + 1,
          id: p.id,
          type: p.type,
          category: p.category,
          letterChar: p.letterChar,
          relX: p.relX,
          relY: p.relY,
          rotation: p.rotation || 0,
        })),
        embroidery: activeEmbLines.map((line, idx) => ({
          line: idx + 1,
          text: line.text,
          font: line.font,
          color: line.color,
          colorName: line.colorName,
          relX: line.relX,
          relY: line.relY,
          rotation: line.rotation || 0,
        })),
      });

      mainItemProperties['_patches_per_bag'] = String(priceInfo.patchCount);
      mainItemProperties['_embroidery_per_bag'] = String(priceInfo.activeEmbroideryCount);

      const resolvedProductTitle =
        {{ product.title | json }} ||
        document.querySelector('.product-title')?.innerText?.trim() ||
        mainProductTitle ||
        'Customized Bag';

      // Resolve variant title so add-ons show the main product variant (e.g. "The Everyday Joy Bag Medium / Electric Orange")
      let variantTitle = '';
      let variantsList = [];
      try {
        variantsList = {{ product.variants | json }} || [];
      } catch (_) {}
      if (!variantsList || !variantsList.length) {
        const variantsEl = document.getElementById('podifai-product-variants-json');
        if (variantsEl) {
          try {
            variantsList = JSON.parse(variantsEl.textContent);
          } catch (_) {}
        }
      }

      const matchedVariant = (variantsList || []).find((v) => String(v.id) === String(mainVariantId));
      if (matchedVariant && matchedVariant.title && matchedVariant.title !== 'Default Title') {
        variantTitle = matchedVariant.title.trim();
      }

      // Fallback to reading selected variant options from DOM if not found in variantsList
      if (!variantTitle) {
        const selectedOpts = [];
        document.querySelectorAll('.variant-option-group').forEach((g) => {
          const val =
            g.querySelector('.selected-option-value')?.innerText?.trim() ||
            g.querySelector('.color-swatch-btn.active:not(.swatch-hidden), .color-swatch-btn.active')?.dataset?.optionValue?.trim() ||
            g.querySelector('.size-pill-input:checked')?.value?.trim();
          if (val) selectedOpts.push(val);
        });
        if (selectedOpts.length > 0) {
          variantTitle = selectedOpts.join(' / ');
        }
      }

      let parentLabel = resolvedProductTitle;
      if (variantTitle) {
        if (variantTitle.toLowerCase().startsWith(resolvedProductTitle.toLowerCase())) {
          parentLabel = variantTitle;
        } else {
          parentLabel = `${resolvedProductTitle} – ${variantTitle}`;
        }
      }

      const embSummary = activeEmbLines
        .map((l) => `${l.text} (${getFontDisplayName(l.font)}, ${l.colorName || l.color})`)
        .join('; ');
      const patchSummary = selectedPatches
        .map((p) => {
          const cat = p.category ? `${p.category}: ` : '';
          return `${cat}${p.letterChar || 'Patch'}`;
        })
        .join(', ');
      const previewText =
        previewImageUrl && previewImageUrl.startsWith('http') ? previewImageUrl : 'None';
      const noteEntry = `[${mainProductTitle}] Patches: ${patchSummary || 'None'} | Embroidery: ${
        embSummary || 'None'
      } | Preview: ${previewText}`;

      mainItemProperties['_note_entry'] = noteEntry;

      const itemsPayload = [
        {
          id: parseInt(mainVariantId),
          quantity: qty,
          properties: mainItemProperties,
        },
      ];

      if (ENABLE_ADDON && priceInfo.patchCount > 0) {
        selectedPatches.forEach((p, idx) => {
          let patchLabel = '';
          if (p.type === 'character') {
            const raw = p.letterChar || 'Patch';
            const m = raw.match(/^(.*?)\s*#(\d+)$/);
            if (m) {
              patchLabel = `${m[1].replace(/^[^\w\s]+/, '').trim()} · P${m[2]}`;
            } else {
              patchLabel = raw.replace(',', ' ·');
            }
          } else {
            const cat = p.categoryLabel || p.category || 'Alphabet';
            const char = (p.letterChar || '').toUpperCase().replace(/'/g, '');
            patchLabel = `${cat} · ${char}`;
          }

          let fullPatchImgUrl = p.imgUrl || '';
          if (fullPatchImgUrl.startsWith('//')) {
            fullPatchImgUrl = 'https:' + fullPatchImgUrl;
          }

          let patchVariantId = null;
          const matchedVariant = getVariantForPatch({
            type: p.type,
            name: p.letterChar,
            letterChar: p.letterChar,
            category: p.category,
            categoryLabel: p.categoryLabel,
            patchRefId: p.patchRefId,
            alt: p.alt,
            index: p.index,
            filename: p.filename,
          });
          if (matchedVariant && matchedVariant.id) {
            patchVariantId = parseInt(matchedVariant.id);
          } else if (PATCH_ADDON_VARIANT) {
            patchVariantId = parseInt(PATCH_ADDON_VARIANT);
          } else if (patchVariantsList && patchVariantsList.length > 0) {
            const genericVariant =
              patchVariantsList.find((v) => (v.product_handle || '').includes('patch-addon')) ||
              patchVariantsList.find((v) => (v.title || '').toLowerCase().includes('default')) ||
              patchVariantsList[0];
            if (genericVariant) patchVariantId = parseInt(genericVariant.id);
          }

          const patchProps = {
            'For': parentLabel,
            _parent_item: parentLabel,
            _bundle_id: bundleId,
            _addon_type: 'Patch Add on',
            _is_companion: 'true',
            _patch_index: String(idx + 1),
            _patch_instance_id: p.id,
            _image: fullPatchImgUrl,
            _thumbnail: fullPatchImgUrl,
            _patch_img: fullPatchImgUrl,
          };
          // Only show 'Patch: ...' property if variant is generic (e.g. 'Default Title')
          // When variant is specific (e.g. 'Sushi · P2'), Shopify checkout already displays the variant title cleanly
          if (!matchedVariant || (matchedVariant.title || '').toLowerCase().includes('default')) {
            patchProps['Patch'] = patchLabel;
          }

          itemsPayload.push({
            id: patchVariantId,
            quantity: 1 * qty,
            properties: patchProps,
          });
        });
      }

      if (ENABLE_ADDON && EMBROIDERY_ADDON_VARIANT && priceInfo.activeEmbroideryCount > 0) {
        itemsPayload.push({
          id: parseInt(EMBROIDERY_ADDON_VARIANT),
          quantity: priceInfo.activeEmbroideryCount * qty,
          properties: {
            _bundle_id: bundleId,
            _parent_item: parentLabel,
            'For': parentLabel,
            _embroidery_per_bag: String(priceInfo.activeEmbroideryCount),
            _addon_type: 'Embroidery Add on',
            _is_companion: 'true',
          },
        });
      }

      if (btn) {
        btn.innerHTML = '<span>Adding to bag...</span>';
      }

      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify({ items: itemsPayload }),
        });

        if (response.ok) {
          const cartResponse = await response.json();
          if (btn) {
            btn.innerHTML = '<span>Added to bag!</span>';
          }

          const cartAddEvent = new CustomEvent('cart:update', {
            bubbles: true,
            detail: {
              resource: cartResponse,
              sourceId: form.id || 'product-form',
              data: {
                source: 'product-form-component',
                itemCount: qty,
              },
            },
          });
          document.dispatchEvent(cartAddEvent);

          // Immediately update header and drawer bubbles
          const currentCountEl = document.querySelector('.cart-bubble__text-count');
          const currentCount = parseInt(currentCountEl?.textContent?.trim() || '0', 10);
          const newTotalCount = currentCount + qty;
          if (typeof window.updateHeaderCountUI === 'function') {
            window.updateHeaderCountUI(newTotalCount);
          }

          const cartDrawer = document.querySelector('cart-drawer-component');
          if (cartDrawer && typeof cartDrawer.open === 'function') {
            cartDrawer.open();
          }

          document.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart: cartResponse } }));
          window.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart: cartResponse } }));
          document.dispatchEvent(new CustomEvent('cart:refresh'));

          if (typeof window.syncCartEngine === 'function') {
            window.syncCartEngine();
          }

          // Asynchronously sync Cart / Order Notes so ONLY active bags currently in the cart are kept
          (async function syncOrderNote() {
            try {
              const curRes = await fetch('/cart.js', { headers: { 'x-cart-sync': '1' } });
              const curCart = await curRes.json();

              const activeBagNotes = [];
              (curCart.items || []).forEach((it) => {
                const p = it.properties || {};
                const isCompanion = p['_is_companion'] === 'true' || p['_addon_type'] != null;
                if (isCompanion) return;

                if (p['_note_entry']) {
                  activeBagNotes.push(p['_note_entry']);
                } else if (p['_bundle_id'] === bundleId) {
                  activeBagNotes.push(noteEntry);
                } else if (p['_bundle_id'] || p['_Preview']) {
                  const t = it.product_title || it.title || 'Customized Bag';
                  const pat = p['_Selected Patches'] || 'None';
                  const em = p['_Embroidery'] || 'None';
                  const pv = p['_Preview'] || 'None';
                  activeBagNotes.push(`[${t}] Patches: ${pat} | Embroidery: ${em} | Preview: ${pv}`);
                }
              });

              if (!activeBagNotes.includes(noteEntry)) {
                activeBagNotes.push(noteEntry);
              }

              // Preserve any non-bag manual notes entered by the shopper
              const isAutoBagNote = (t) =>
                t.startsWith('[') && t.includes('Patches:') && t.includes('Preview:');

              const existingChunks = (curCart.note || '').split('\n\n');
              const manualCustomerChunks = existingChunks.filter((chunk) => {
                const t = chunk.trim();
                return t && !isAutoBagNote(t);
              });
              const manualCustomerNote = manualCustomerChunks.join('\n\n').trim();

              let desiredNote = '';
              if (manualCustomerNote && activeBagNotes.length > 0) {
                desiredNote = `${manualCustomerNote}\n\n${activeBagNotes.join('\n\n')}`;
              } else if (activeBagNotes.length > 0) {
                desiredNote = activeBagNotes.join('\n\n');
              } else {
                desiredNote = manualCustomerNote;
              }

              if ((curCart.note || '').trim() !== desiredNote.trim()) {
                await fetch('/cart/update.js', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json', Accept: 'application/json', 'x-cart-sync': '1' },
                  body: JSON.stringify({ note: desiredNote }),
                });
              }
            } catch (e) {}
          })();

          // Reset Add to Bag button back to active state after 1.8 seconds
          setTimeout(() => {
            if (btn) {
              btn.disabled = false;
              btn.innerHTML = `<span id="add-to-cart-text">Add to bag · <span id="podifai-btn-price-display"></span></span>`;
              if (typeof updateDynamicPrice === 'function') {
                updateDynamicPrice();
              }
            }
          }, 1800);

          return true;
        } else {
          const errData = await response.json().catch(() => ({}));
          const errMsg =
            errData.description ||
            errData.message ||
            'This item is currently sold out. Please select another colour or size.';
          console.warn('Cart add error from Shopify:', errMsg);

          if (btn) {
            btn.disabled = false;
            btn.innerHTML = `<span>${errMsg}</span>`;
            setTimeout(() => {
              btn.innerHTML = originalBtnHTML;
            }, 4000);
          }
          return false;
        }
      } catch (err) {
        console.error('Add to cart bundle error:', err);
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = originalBtnHTML;
        }
        return false;
      }
    }

    // Intercept Form Submit
    document.addEventListener(
      'submit',
      async (e) => {
        const form = e.target;
        if (
          form &&
          (form.matches('form[action*="/cart/add"]') ||
            form.matches('form[data-type="add-to-cart-form"]') ||
            form.id === 'product-form')
        ) {
          e.preventDefault();
          await handleCustomAddToCart(form);
        }
      },
      true
    );

    window.PodifaiCustomizer = {
      updatePrice: updateDynamicPrice,
      getStage: () => stage,
      reAnchor: resizeAndRedrawCanvas,
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        initKonvaOverlay();
        filterCharacterPatchesGrid();
        updateAlphabetGrid();
        updateUIBadges();
        renderEmbroideryLinesUI();
        updateActiveHeaderLabels();
        updateDynamicPrice();
      });
    } else {
      initKonvaOverlay();
      filterCharacterPatchesGrid();
      updateAlphabetGrid();
      updateUIBadges();
      renderEmbroideryLinesUI();
      updateActiveHeaderLabels();
      updateDynamicPrice();
    }

    if (document.fonts) {
      if (typeof document.fonts.load === 'function') {
        try {
          document.fonts.load('500 16px "EB Garamond"');
          document.fonts.load('400 16px "EB Garamond"');
          document.fonts.load('italic 16px "Brush Script MT"');
          document.fonts.load('16px "Brush Script MT"');
          document.fonts.load('italic 16px "Picturama Founder"');
          document.fonts.load('16px "Picturama Founder"');
          document.fonts.load('italic 16px "Apple Chancery"');
          document.fonts.load('16px "Apple Chancery"');
        } catch (_) {}
      }
      if (typeof document.fonts.ready !== 'undefined') {
        document.fonts.ready.then(() => {
          if (stage && layer) {
            embroideryLines.forEach((line, index) => {
              if (line.node && line.text) {
                updateEmbroideryLineNode(line, index);
              }
            });
            layer.batchDraw();
          }
        });
      }
    }
  })();
</script>