    // Auto-trim transparent padding from patch images so the actual graphic fills the bounds
    function trimTransparentBorders(image) {
      try {
        const w = image.naturalWidth || image.width;
        const h = image.naturalHeight || image.height;
        if (!w || !h) return image;

        const canvas = document.createElement('canvas');
        canvas.width = w;
        canvas.height = h;
        const ctx = canvas.getContext('2d', { willReadFrequently: true });
        ctx.drawImage(image, 0, 0);

        const imgData = ctx.getImageData(0, 0, w, h);
        const data = imgData.data;

        let minX = w, minY = h, maxX = 0, maxY = 0;
        let found = false;

        for (let y = 0; y < h; y += 2) {
          for (let x = 0; x < w; x += 2) {
            const alpha = data[(y * w + x) * 4 + 3];
            if (alpha > 15) {
              if (x < minX) minX = x;
              if (x > maxX) maxX = x;
              if (y < minY) minY = y;
              if (y > maxY) maxY = y;
              found = true;
            }
          }
        }

        if (!found || (minX < 5 && minY < 5 && maxX > w - 5 && maxY > h - 5)) {
          return image;
        }

        minX = Math.max(0, minX - 2);
        minY = Math.max(0, minY - 2);
        maxX = Math.min(w, maxX + 4);
        maxY = Math.min(h, maxY + 4);

        const cropW = maxX - minX;
        const cropH = maxY - minY;

        if (cropW <= 10 || cropH <= 10) return image;

        const trimmedCanvas = document.createElement('canvas');
        trimmedCanvas.width = cropW;
        trimmedCanvas.height = cropH;
        const trimCtx = trimmedCanvas.getContext('2d');
        trimCtx.drawImage(canvas, minX, minY, cropW, cropH, 0, 0, cropW, cropH);

        return trimmedCanvas;
      } catch (err) {
        return image;
      }
    }

    // Add Patch Handler (supports multiple instances of the same patch / letter)
    function handlePatchAdd(btnEl, patchRefId, patchType, titleStr, svgOrImgSrc, categoryStr, categoryLabel) {
      if (!layer || !stage) return;

      const stock = getPatchStockInfo({
        type: patchType,
        name: titleStr,
        letterChar: titleStr,
        letter: titleStr,
        category: categoryStr,
        categoryLabel: categoryLabel,
        patchId: patchRefId,
        alt: btnEl?.dataset?.patchAlt || '',
        index: btnEl?.dataset?.patchIndex || btnEl?.dataset?.index || '',
        filename: btnEl?.dataset?.patchFilename || btnEl?.dataset?.filename || '',
      });

      if (stock.isSoldOut) {
        showStockToast(`"${titleStr}" is currently sold out.`);
        return;
      }

      if (stock.isTracked && stock.policy !== 'continue') {
        const alreadyCount = selectedPatches.filter((p) => {
          if (patchType === 'character') {
            return p.type === 'character' && p.patchRefId === patchRefId;
          } else {
            return (
              p.type === 'letter' &&
              p.category === (categoryStr || currentAlphabetCategory) &&
              (p.letterChar || '').toLowerCase() === (titleStr || '').toLowerCase()
            );
          }
        }).length;

        if (alreadyCount >= stock.qtyAvailable) {
          showStockToast(`Maximum available quantity already added for "${titleStr}".`);
          return;
        }
      }

      const currentW = stage.width();
      const currentH = stage.height();
      const scaleFactor = currentW / BASE_STAGE_REF;

      const imgObj = new Image();
      imgObj.crossOrigin = 'Anonymous';
      const finalImgSrc = svgOrImgSrc || getLetterPatchImageUrl(categoryStr || currentAlphabetCategory, titleStr);
      imgObj.src = finalImgSrc;

      // Unique instance ID for this specific patch node
      const instanceId = `${patchRefId}-inst-${Date.now()}-${Math.random().toString(36).substr(2, 5)}`;

      // Stagger positions nicely across canvas
      const patchIndex = selectedPatches.length;
      const initX = Math.min(Math.max(50, currentW / 2 + ((patchIndex % 5) - 2) * 45), currentW - 50);
      const initY = Math.min(Math.max(50, currentH / 2 + Math.floor(patchIndex / 5) * 45), currentH - 50);
      const relX = initX / currentW;
      const relY = initY / currentH;

      let rawSizeStr = null;
      if (btnEl && btnEl.dataset.size) {
        rawSizeStr = btnEl.dataset.size;
      }
      if (!rawSizeStr && btnEl && btnEl.closest('[data-size]')) {
        rawSizeStr = btnEl.closest('[data-size]').dataset.size;
      }
      if (!rawSizeStr && categoryStr) {
        const pill = document.querySelector(
          patchType === 'letter'
            ? `#podifai-alphabet-categories .podifai-pill-btn[data-cat="${categoryStr}"]`
            : `#podifai-char-categories .podifai-pill-btn[data-char-cat="${categoryStr}"]`
        );
        if (pill && pill.dataset.size) rawSizeStr = pill.dataset.size;
      }
      if (!rawSizeStr) {
        if (patchType === 'letter') {
          const activeAlphaPill = document.querySelector('#podifai-alphabet-categories .podifai-pill-btn.active');
          if (activeAlphaPill) rawSizeStr = activeAlphaPill.dataset.size;
        } else {
          const activeCharPill = document.querySelector('#podifai-char-categories .podifai-pill-btn.active');
          if (activeCharPill) rawSizeStr = activeCharPill.dataset.size;
        }
      }
      if (!rawSizeStr) rawSizeStr = '8cm x 8cm';

      const dim = getPatchDimensionsPx(rawSizeStr, patchType);
      const baseWidth = dim.width;
      const baseHeight = dim.height;

      const node = new Konva.Image({
        x: initX,
        y: initY,
        image: imgObj,
        width: baseWidth,
        height: baseHeight,
        offsetX: baseWidth / 2,
        offsetY: baseHeight / 2,
        scaleX: scaleFactor,
        scaleY: scaleFactor,
        draggable: true,
        dragBoundFunc: function (pos) {
          if (!stage) return pos;
          const sw = stage.width();
          const sh = stage.height();
          const s = this.scaleX();
          const halfW = (this.width() * s) / 2;
          const halfH = (this.height() * s) / 2;
          const m = 6;
          return {
            x: Math.max(halfW + m, Math.min(pos.x, sw - halfW - m)),
            y: Math.max(halfH + m, Math.min(pos.y, sh - halfH - m)),
          };
        },
      });

      function applyImageDimensions() {
        const processedImg = trimTransparentBorders(imgObj) || imgObj;
        node.image(processedImg);

        const natW = processedImg.width || processedImg.naturalWidth;
        const natH = processedImg.height || processedImg.naturalHeight;

        if (natW && natH) {
          const natRatio = natW / natH;
          let w = baseWidth;
          let h = baseHeight;

          if (patchType === 'letter') {
            const char = (titleStr || '').trim().toLowerCase();
            const catLower = (categoryLabel || categoryStr || '').toLowerCase();
            const isSmallLetterCategory =
              catLower.includes('small') ||
              catLower.includes('lower') ||
              (catLower.includes('letters') && !catLower.includes('capital'));

            if (isSmallLetterCategory) {
              // Standard lowercase letters without ascenders or descenders (x-height letters)
              const xHeightLetters = new Set(['a', 'c', 'e', 'm', 'n', 'o', 'r', 's', 'u', 'v', 'w', 'x', 'z']);
              const descenderLetters = new Set(['g', 'j', 'p', 'q', 'y']);

              let targetH;
              if (xHeightLetters.has(char)) {
                // All core lowercase letters (m, n, s, etc.) share the exact same uniform x-height
                targetH = Math.round(baseHeight * 0.72);
              } else if (char === 'i') {
                targetH = Math.round(baseHeight * 0.85);
              } else if (descenderLetters.has(char)) {
                targetH = Math.round(baseHeight * 0.95);
              } else {
                // Ascenders (b, d, f, h, k, l, t) stand at full height
                targetH = baseHeight;
              }
              h = targetH;
              w = Math.round(targetH * natRatio);

              // Guardrails: ensure width doesn't get excessively stretched
              const maxW = Math.round(baseWidth * 1.5);
              if (w > maxW) {
                w = maxW;
                h = Math.round(w / natRatio);
              }
            } else {
              // Capital letters: all capital letters stand at a uniform cap-height
              let targetH = baseHeight;
              if (char === 'q' || char === 'j') {
                targetH = Math.round(baseHeight * 1.05);
              }
              h = targetH;
              w = Math.round(targetH * natRatio);

              const maxW = Math.round(baseWidth * 1.4);
              if (w > maxW) {
                w = maxW;
                h = Math.round(w / natRatio);
              }
            }
          } else {
            // Character patches (icons, emojis, graphics): fit within bounding box
            const maxDim = Math.max(baseWidth, baseHeight);
            w = maxDim;
            h = maxDim;
            if (natRatio > 1.05) {
              h = Math.round(maxDim / natRatio);
            } else if (natRatio < 0.95) {
              w = Math.round(maxDim * natRatio);
            }
          }

          node.width(w);
          node.height(h);
          node.offsetX(w / 2);
          node.offsetY(h / 2);
        }
        updateTransformerButtonsPosition();
        checkPatchOverlaps();
        layer.draw();
      }

      if (imgObj.complete && (imgObj.naturalWidth || imgObj.width)) {
        applyImageDimensions();
      } else {
        imgObj.onload = applyImageDimensions;
      }

      const patchObj = {
        id: instanceId,
        patchRefId: patchRefId,
        type: patchType,
        category: categoryStr,
        categoryLabel: categoryLabel,
        letterChar: titleStr,
        node: node,
        element: btnEl,
        alt: btnEl?.dataset?.patchAlt || '',
        index: btnEl?.dataset?.patchIndex || btnEl?.dataset?.index || '',
        filename: btnEl?.dataset?.patchFilename || btnEl?.dataset?.filename || '',
        imgUrl: finalImgSrc,
        relX: relX,
        relY: relY,
        baseScaleX: 1,
        baseScaleY: 1,
        rotation: 0,
      };

      function syncNodeRelativeState() {
        const w = stage.width();
        const h = stage.height();
        patchObj.relX = node.x() / w;
        patchObj.relY = node.y() / h;
        patchObj.rotation = node.rotation();
      }

      node.on('dragmove dragend transform transformend', () => {
        syncNodeRelativeState();
        updateTransformerButtonsPosition();
        checkPatchOverlaps();
      });

      node.on('click tap', () => {
        transformer.nodes([node]);
        updateTransformerButtonsPosition();
        checkPatchOverlaps();
      });

      layer.add(node);
      transformer.nodes([node]);
      updateTransformerButtonsPosition();

      selectedPatches.push(patchObj);
      checkPatchOverlaps();
      updateUIBadges();
    }

    // Character Category Switcher Listeners
    document.querySelectorAll('#podifai-char-categories .podifai-pill-btn').forEach((pill) => {
      pill.addEventListener('click', () => {
