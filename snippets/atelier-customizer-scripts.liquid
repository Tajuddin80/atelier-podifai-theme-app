    // Helper to disable / enable Add to Cart button when overlap occurs or variant is sold out
    function setAddToCartDisabled(disabled) {
      const atcBtns = document.querySelectorAll(
        '#add-to-cart-btn, .product-submit-row button[type="submit"], [name="add"], .product-submit-btn'
      );
      const currentVariantId = document.getElementById('selected-variant-id')?.value;
      let variantIsSoldOut = false;
      const variantsEl = document.getElementById('podifai-product-variants-json');
      if (currentVariantId && variantsEl) {
        try {
          const variantsList = JSON.parse(variantsEl.textContent) || [];
          const v = variantsList.find((item) => String(item.id) === String(currentVariantId));
          if (v && v.available === false) variantIsSoldOut = true;
        } catch (_) {}
      }

      atcBtns.forEach((btn) => {
        if (disabled || variantIsSoldOut) {
          btn.disabled = true;
          btn.classList.add('disabled');
          btn.setAttribute('aria-disabled', 'true');
          btn.style.opacity = '0.5';
          btn.style.cursor = 'not-allowed';
          btn.style.pointerEvents = 'none';
          if (variantIsSoldOut) {
            const btnText = document.getElementById('add-to-cart-text');
            if (btnText) btnText.innerHTML = 'SOLD OUT';
          }
        } else {
          btn.disabled = false;
          btn.classList.remove('disabled');
          btn.removeAttribute('aria-disabled');
          btn.style.opacity = '';
          btn.style.cursor = '';
          btn.style.pointerEvents = '';
        }
      });
    }

    // Checks all editable patches against each other and against fixed, centred embroidery.
    function checkPatchOverlaps() {
      const toast = document.getElementById('podifai-overlap-error-toast');
      if (!stage || !layer) {
        if (toast) toast.style.display = 'none';
        if (transformer) {
          transformer.borderStroke('#333333');
          transformer.borderStrokeWidth(1);
        }
        setAddToCartDisabled(false);
        return false;
      }

      const activePatchNodes = selectedPatches
        .map((p) => p.node)
        .filter((n) => n && typeof n.getStage === 'function' && n.getStage());

      let hasOverlap = false;

      // Bounding-box collision with small inset to skip transparent edge padding
      // Shrink each rect by 5% on each side so only real pixel-to-pixel overlap triggers
      const INSET_RATIO = 0.05;
      const patchRects = activePatchNodes.map((node) => {
        // getClientRect accounts for rotation, scale, and offset
        const rect = node.getClientRect({ relativeTo: stage });
        const insetX = rect.width * INSET_RATIO;
        const insetY = rect.height * INSET_RATIO;
        return {
          left: rect.x + insetX,
          right: rect.x + rect.width - insetX,
          top: rect.y + insetY,
          bottom: rect.y + rect.height - insetY,
          node: node,
        };
      });

      const embroideryRects = embroideryLines
        .map((line) => line.node)
        .filter((node) => node && typeof node.getStage === 'function' && node.getStage())
        .map((node) => {
          const rect = node.getClientRect({ relativeTo: stage });
          const insetX = rect.width * INSET_RATIO;
          const insetY = rect.height * INSET_RATIO;
          return {
            left: rect.x + insetX,
            right: rect.x + rect.width - insetX,
            top: rect.y + insetY,
            bottom: rect.y + rect.height - insetY,
          };
        });

      const rectanglesOverlap = (a, b) =>
        a.left < b.right && a.right > b.left && a.top < b.bottom && a.bottom > b.top;

      for (let i = 0; i < patchRects.length; i++) {
        for (let j = i + 1; j < patchRects.length; j++) {
          const a = patchRects[i];
          const b = patchRects[j];

          // AABB intersection: overlaps when visible artwork areas actually touch
          if (rectanglesOverlap(a, b)) {
            hasOverlap = true;
            break;
          }
        }
        if (hasOverlap) break;
      }

      // Embroidery cannot be covered by a patch, and a patch cannot be placed
      // over embroidery. The same comparison enforces both cases.
      if (!hasOverlap) {
        for (const patchRect of patchRects) {
          if (embroideryRects.some((embroideryRect) => rectanglesOverlap(patchRect, embroideryRect))) {
            hasOverlap = true;
            break;
          }
        }
      }

      if (hasOverlap) {
        if (toast) toast.style.display = 'flex';
        if (transformer) {
          transformer.borderStroke('#dc2626');
          transformer.borderStrokeWidth(1.5);
        }
        setAddToCartDisabled(true);
      } else {
        if (toast) toast.style.display = 'none';
        if (transformer) {
          transformer.borderStroke('#333333');
          transformer.borderStrokeWidth(1);
        }
        setAddToCartDisabled(false);
      }

      return hasOverlap;
    }

    // Helper to position floating Delete (top-right) and Rotate (bottom-right) buttons
    function updateTransformerButtonsPosition() {
      if (!stage || !layer) return;
      const nodes = transformer ? transformer.nodes() : [];
      if (!nodes || nodes.length === 0) {
        if (deleteBtnGroup) deleteBtnGroup.visible(false);
        if (rotateBtnGroup) rotateBtnGroup.visible(false);
        layer.batchDraw();
        return;
      }
      const selectedNode = nodes[0];
      const box = selectedNode.getClientRect({ relativeTo: layer });

      if (deleteBtnGroup) {
        deleteBtnGroup.position({
          x: box.x + box.width + 2,
          y: box.y - 2,
        });
        deleteBtnGroup.visible(true);
        deleteBtnGroup.moveToTop();
      }

      if (rotateBtnGroup) {
        rotateBtnGroup.position({
          x: box.x + box.width + 2,
          y: box.y + box.height + 2,
        });
        rotateBtnGroup.visible(true);
        rotateBtnGroup.moveToTop();
      }

      layer.batchDraw();
    }
    const updateDeleteButtonPosition = updateTransformerButtonsPosition;

    // Responsive Canvas Resize & Re-anchor Function
    function resizeAndRedrawCanvas() {
      if (!mediaContainerEl || !stage || !layer) return;

      const newRect = mediaContainerEl.getBoundingClientRect();
      if (newRect.width <= 0 || newRect.height <= 0) return;

      // Prevent fractional subpixel micro-reflows that cause mobile screen shaking
      if (Math.abs(newRect.width - lastCanvasW) < 1.5 && Math.abs(newRect.height - lastCanvasH) < 1.5) {
        return;
      }

      lastCanvasW = newRect.width;
      lastCanvasH = newRect.height;

      const newWidth = newRect.width;
      const newHeight = newRect.height;

      stage.width(newWidth);
      stage.height(newHeight);

      const scaleFactor = newWidth / BASE_STAGE_REF;

      selectedPatches.forEach((p) => {
        if (p.node) {
          p.node.x(p.relX * newWidth);
          p.node.y(p.relY * newHeight);
          p.node.scaleX((p.baseScaleX || 1) * scaleFactor);
          p.node.scaleY((p.baseScaleY || 1) * scaleFactor);
          if (typeof p.rotation === 'number') {
            p.node.rotation(p.rotation);
          }
        }
      });

      const baseEmbSize = 44 * scaleFactor;
      const maxEmbW = Math.min(240 * scaleFactor, newWidth * 0.48);
      const activeEmbLines = embroideryLines.filter((l) => (l.text || '').trim().length > 0);
      const totalActive = activeEmbLines.length || 1;
      const embSpacing = 42 * scaleFactor;

      embroideryLines.forEach((line) => {
        if (line.node) {
          line.node.fontSize(baseEmbSize);
          if (line.node.width() > maxEmbW) {
            line.node.fontSize(baseEmbSize * (maxEmbW / line.node.width()));
          }
          line.node.offsetX(line.node.width() / 2);
          line.node.offsetY(line.node.height() / 2);

          const centerX = newWidth / 2;
          const activeIndex = Math.max(0, activeEmbLines.indexOf(line));
          const centerY = newHeight * 0.50 + (activeIndex - (totalActive - 1) / 2) * embSpacing;
          line.node.x(centerX);
          line.node.y(centerY);
          line.isCustomMoved = false;
          line.relX = 0.5;
          line.relY = centerY / newHeight;
          line.node._dragStartX = line.node.x();
          line.node._dragStartY = line.node.y();
          line.node._dragLockAxis = null;
          line.node.draggable(false);
          if (typeof line.rotation === 'number') {
            line.node.rotation(0);
          }
        }
      });

      updateTransformerButtonsPosition();
      checkPatchOverlaps();
      layer.batchDraw();
    }

    // Initialize Konva Canvas Engine
    function initKonvaOverlay() {
      mediaContainerEl = document.querySelector(
        '.product-images, .product-media-gallery, [data-product-single-media-group], .product-gallery__main'
      );
      const canvasWrapper = document.getElementById('podifai-canvas-wrapper');

      if (mediaContainerEl && canvasWrapper) {
        if (getComputedStyle(mediaContainerEl).position === 'static') {
          mediaContainerEl.style.position = 'relative';
        }
        mediaContainerEl.appendChild(canvasWrapper);

        // Ensure preview disclaimer is rendered below mediaContainerEl
        const existingDisclaimer = mediaContainerEl.parentNode
          ? mediaContainerEl.parentNode.querySelector('.podifai-preview-disclaimer')
          : null;
        if (!existingDisclaimer && mediaContainerEl.parentNode) {
          const disc = document.createElement('div');
          disc.className = 'podifai-preview-disclaimer';
          {% assign js_disc_text = block.settings.preview_disclaimer_text | default: section_settings.preview_disclaimer_text | default: section.settings.preview_disclaimer_text %}
          {% if js_disc_text == blank and block.settings.preview_disclaimer_text == nil and section_settings.preview_disclaimer_text == nil and section.settings.preview_disclaimer_text == nil %}
            {% assign js_disc_text = '💛 The preview is a guide — colours and placement are approximate. Every piece is made by hand, so your final piece may vary a touch.' %}
          {% endif %}
          disc.innerHTML = {{ js_disc_text | json }};
          if (mediaContainerEl.nextSibling) {
            mediaContainerEl.parentNode.insertBefore(disc, mediaContainerEl.nextSibling);
          } else {
            mediaContainerEl.parentNode.appendChild(disc);
          }
        }

        const rect = mediaContainerEl.getBoundingClientRect();
        const width = rect.width || 500;
        const height = rect.height || 500;

        lastCanvasW = width;
        lastCanvasH = height;

        stage = new Konva.Stage({
          container: 'podifai-konva-container',
          width: width,
          height: height,
        });

        layer = new Konva.Layer();
        stage.add(layer);

        // Transformer: Allows rotation and dragging while strictly locking size / preventing resizing
        transformer = new Konva.Transformer({
          rotateEnabled: false,
          resizeEnabled: false,
          enabledAnchors: [],
          borderStroke: '#333333',
          borderStrokeWidth: 1,
          borderDash: [3, 3],
          padding: 4,
        });
        layer.add(transformer);

        // Floating Delete / Trash Bin Icon Button (Top-Right)
        deleteBtnGroup = new Konva.Group({
          name: 'deleteBtnGroup',
          visible: false,
          listening: true,
        });

        const deleteBtnBg = new Konva.Circle({
          radius: 11,
          fill: '#ffffff',
          stroke: '#555555',
          strokeWidth: 0.75,
          shadowColor: 'rgba(0, 0, 0, 0.10)',
          shadowBlur: 2,
          shadowOffset: { x: 0, y: 1 },
          shadowOpacity: 0.15,
          cursor: 'pointer',
        });

        const deleteBtnIcon = new Konva.Path({
          data: 'm14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0',
          stroke: '#2b2b2b',
          strokeWidth: 1.0,
          strokeScaleEnabled: false,
          fillEnabled: false,
          lineCap: 'round',
          lineJoin: 'round',
          scale: { x: 0.48, y: 0.48 },
          offsetX: 12,
          offsetY: 12,
          cursor: 'pointer',
        });

        deleteBtnGroup.add(deleteBtnBg);
        deleteBtnGroup.add(deleteBtnIcon);
        layer.add(deleteBtnGroup);

        deleteBtnGroup.on('mouseenter', () => {
          if (typeof document !== 'undefined') document.body.style.cursor = 'pointer';
          deleteBtnBg.fill('#fee2e2');
          deleteBtnBg.stroke('#dc2626');
          deleteBtnIcon.stroke('#dc2626');
          layer.batchDraw();
        });

        deleteBtnGroup.on('mouseleave', () => {
          if (typeof document !== 'undefined') document.body.style.cursor = 'default';
          deleteBtnBg.fill('#ffffff');
          deleteBtnBg.stroke('#555555');
          deleteBtnIcon.stroke('#2b2b2b');
          layer.batchDraw();
        });

        deleteBtnGroup.on('click tap', (e) => {
          e.cancelBubble = true;
          const nodes = transformer ? transformer.nodes() : [];
          if (nodes && nodes.length > 0) {
            const targetNode = nodes[0];
            const patchObj = selectedPatches.find((p) => p.node === targetNode);
            if (patchObj) {
              removePatchById(patchObj.id);
            }
            if (transformer) transformer.nodes([]);
            updateTransformerButtonsPosition();
            checkPatchOverlaps();
          }
        });

        // Floating Rotate Button (Bottom-Right)
        rotateBtnGroup = new Konva.Group({
          name: 'rotateBtnGroup',
          visible: false,
          listening: true,
        });

        const rotateBtnBg = new Konva.Circle({
          radius: 11,
          fill: '#ffffff',
          stroke: '#555555',
          strokeWidth: 0.75,
          shadowColor: 'rgba(0, 0, 0, 0.10)',
          shadowBlur: 2,
          shadowOffset: { x: 0, y: 1 },
          shadowOpacity: 0.15,
          cursor: 'grab',
        });

        const rotateBtnIcon = new Konva.Path({
          data: 'M19.5 12c0-1.232-.046-2.453-.138-3.662a4.006 4.006 0 0 0-3.7-3.7 48.678 48.678 0 0 0-7.324 0 4.006 4.006 0 0 0-3.7 3.7c-.017.22-.032.441-.046.662M19.5 12l3-3m-3 3-3-3m-12 3c0 1.232.046 2.453.138 3.662a4.006 4.006 0 0 0 3.7 3.7 48.656 48.656 0 0 0 7.324 0 4.006 4.006 0 0 0 3.7-3.7c.017-.22.032-.441.046-.662M4.5 12l3 3m-3-3-3 3',
          stroke: '#2b2b2b',
          strokeWidth: 1.0,
          strokeScaleEnabled: false,
          fillEnabled: false,
          lineCap: 'round',
          lineJoin: 'round',
          scale: { x: 0.48, y: 0.48 },
          offsetX: 12,
          offsetY: 12,
          cursor: 'grab',
        });

        rotateBtnGroup.add(rotateBtnBg);
        rotateBtnGroup.add(rotateBtnIcon);
        layer.add(rotateBtnGroup);

        rotateBtnGroup.on('mouseenter', () => {
          if (typeof document !== 'undefined') document.body.style.cursor = 'grab';
          rotateBtnBg.fill('#f3f4f6');
          layer.batchDraw();
        });

        rotateBtnGroup.on('mouseleave', () => {
          if (typeof document !== 'undefined' && !isRotatingHandle) document.body.style.cursor = 'default';
          rotateBtnBg.fill('#ffffff');
          layer.batchDraw();
        });

        let isRotatingHandle = false;
        let rotateStartAngle = 0;
        let nodeStartRotation = 0;
        let rotateHasMoved = false;

        rotateBtnGroup.on('mousedown touchstart', (e) => {
          e.cancelBubble = true;
          const nodes = transformer ? transformer.nodes() : [];
          if (!nodes || nodes.length === 0) return;
          const selectedNode = nodes[0];
          isRotatingHandle = true;
          rotateHasMoved = false;

          const nodeCenter = {
            x: selectedNode.x(),
            y: selectedNode.y(),
          };

          const pointerPos = stage.getPointerPosition();
          if (pointerPos) {
            rotateStartAngle = Math.atan2(pointerPos.y - nodeCenter.y, pointerPos.x - nodeCenter.x) * (180 / Math.PI);
            nodeStartRotation = selectedNode.rotation() || 0;
          }

          if (typeof document !== 'undefined') {
            document.body.style.cursor = 'grabbing';
          }
        });

        const onPointerMoveRotate = () => {
          if (!isRotatingHandle || !stage) return;
          const nodes = transformer ? transformer.nodes() : [];
          if (!nodes || nodes.length === 0) return;
          const selectedNode = nodes[0];
          const pointerPos = stage.getPointerPosition();
          if (!pointerPos) return;

          const nodeCenter = { x: selectedNode.x(), y: selectedNode.y() };
          const curAngle = Math.atan2(pointerPos.y - nodeCenter.y, pointerPos.x - nodeCenter.x) * (180 / Math.PI);
          const angleDiff = curAngle - rotateStartAngle;

          if (Math.abs(angleDiff) > 2) {
            rotateHasMoved = true;
          }

          let newRot = Math.round((nodeStartRotation + angleDiff) % 360);
          if (newRot < 0) newRot += 360;
          selectedNode.rotation(newRot);

          const patchObj = selectedPatches.find((p) => p.node === selectedNode);
          if (patchObj) {
            patchObj.rotation = newRot;
          }

          updateTransformerButtonsPosition();
          checkPatchOverlaps();
          layer.batchDraw();
        };

        const onPointerUpRotate = () => {
          if (!isRotatingHandle) return;
          isRotatingHandle = false;
          if (typeof document !== 'undefined') {
            document.body.style.cursor = 'default';
          }
          checkPatchOverlaps();
        };

        window.addEventListener('mousemove', onPointerMoveRotate);
        window.addEventListener('touchmove', onPointerMoveRotate, { passive: false });
        window.addEventListener('mouseup', onPointerUpRotate);
        window.addEventListener('touchend', onPointerUpRotate);

        // Click / Tap on rotate button rotates by +45 degrees if not dragged
        rotateBtnGroup.on('click tap', (e) => {
          e.cancelBubble = true;
          if (rotateHasMoved) return;
          const nodes = transformer ? transformer.nodes() : [];
          if (!nodes || nodes.length === 0) return;
          const selectedNode = nodes[0];
          let curRot = selectedNode.rotation() || 0;
          let newRot = (curRot + 45) % 360;
          selectedNode.rotation(newRot);

          const patchObj = selectedPatches.find((p) => p.node === selectedNode);
          if (patchObj) {
            patchObj.rotation = newRot;
          }

          updateTransformerButtonsPosition();
          checkPatchOverlaps();
          layer.batchDraw();
        });

        stage.on('click tap', (e) => {
          if (e.target === stage) {
            transformer.nodes([]);
            updateTransformerButtonsPosition();
          }
        });

        if (window.ResizeObserver) {
          const ro = new ResizeObserver(() => {
            if (resizeFrameId) cancelAnimationFrame(resizeFrameId);
            resizeFrameId = requestAnimationFrame(resizeAndRedrawCanvas);
          });
          ro.observe(mediaContainerEl);
        }

        window.addEventListener('resize', () => {
          if (resizeFrameId) cancelAnimationFrame(resizeFrameId);
          resizeFrameId = requestAnimationFrame(resizeAndRedrawCanvas);
        });
        window.addEventListener('orientationchange', () => {
          setTimeout(resizeAndRedrawCanvas, 200);
        });
      }
    }

