{%- doc -%}
  @param [limit] - {number}

  The maximum number of items in the cart to display. If the number of items in the cart is greater than this limit, the
  count will be displayed as "99+".
{%- enddoc -%}

{% liquid
  assign main_item_count = 0
  for item in cart.items
    assign item_title_lower = item.product.title | downcase
    assign item_handle = item.product.handle | downcase
    assign addon_type = item.properties['Addon Type'] | default: item.properties._addon_type
    assign parent_item = item.properties._parent_item | default: item.properties.parent_item

    assign is_addon = false
    if item_title_lower contains 'addon' or item_title_lower contains 'surcharge' or item_handle contains 'addon' or addon_type != blank or parent_item != blank or item_title_lower contains 'patch' or item_title_lower contains 'embroidery' or item_handle contains 'patch' or item_handle contains 'embroidery'
      assign is_addon = true
    endif

    unless is_addon
      assign main_item_count = main_item_count | plus: item.quantity
    endunless
  endfor
%}

<div
  ref="cartBubble"
  class="cart-bubble{% if main_item_count == 0 %} visually-hidden{% endif %}"
  {% if main_item_count <= 99 %}
    data-maintain-ratio
  {% endif %}
>
  <span class="cart-bubble__background"></span>
  <span
    ref="cartBubbleText"
    id="cart-bubble-text"
    class="cart-bubble__text"
  >
    <span
      class="cart-bubble__text-count{% if main_item_count == 0 %} hidden{% endif %}"
      ref="cartBubbleCount"
      aria-hidden="true"
      data-testid="cart-bubble"
    >
      {%- if limit == blank or main_item_count < limit -%}
        {{- main_item_count -}}
      {%- else -%}
        99+
      {%- endif -%}
    </span>
  </span>
</div>

{% stylesheet %}
  .cart-bubble {
    --cart-padding: 0.2em;

    position: relative;
    width: 20px;
    aspect-ratio: 1;
    border-radius: 50%;
    border-width: 0;
    display: flex;
    line-height: normal;
    align-items: center;
    justify-content: center;
    color: var(--color-primary-button-text);
    padding-inline: var(--cart-padding);
  }

  .cart-bubble[data-maintain-ratio] {
    aspect-ratio: 1;
  }

  .cart-bubble[data-maintain-ratio] .cart-bubble__background {
    border-radius: var(--style-border-radius-50);
  }

  .cart-bubble__background {
    position: absolute;
    inset: 0;
    background-color: white;
    border-radius: var(--style-border-radius-lg);
  }

  .cart-bubble__text {
    font-size: var(--font-size--3xs);
    z-index: var(--layer-flat);
    line-height: 1;
    display: flex;
    color: black !important;
    align-items: center;
    justify-content: center;
  }
{% endstylesheet %}
