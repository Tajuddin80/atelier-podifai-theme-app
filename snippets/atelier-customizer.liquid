 {% comment %}
  Podifai / Atelier Product Customizer Snippet
  Supports:
  1. Step 3 (Add Patches) & Step 4 (Add Embroidery) Card Architecture.
  2. Bottom Placement of Selected Patches with Pill design & Live Surcharges.
  3. Dynamic Character Categories (Cutie faces, Snacks & sweets, Tiny animals, Little feelings) & 26 Alphabet Patches.
  4. Multi-Text Embroidery Engine with Font Picker, Character Counter, and Thread Colors.
  5. Live Order Total Summary Breakdown Card & Microcopy.
  6. Zero-Backend Companion Addon Surcharge Engine + Cloudinary/Canvas composite snapshot export.
{% endcomment %}

{% assign customizer_block = block %}
{% if customizer_block == null %}
  {% assign customizer_block = section.blocks | where: 'type', 'atelier-customizer' | first %}
{% endif %}
{% if customizer_block == null %}
  {% assign customizer_block = section.blocks | where: 'type', 'podifai-customizer' | first %}
{% endif %}
{% assign custom_settings = customizer_block.settings %}
{% assign currency_symbol = custom_settings.currency_symbol | default: 'RM' %}

{% assign patch_addon_handle = custom_settings.patch_addon_product.handle
  | default: custom_settings.patch_addon_product
%}
{% assign patch_addon_prod = all_products[patch_addon_handle] | default: custom_settings.patch_addon_product %}
{% assign patch_addon_variant = patch_addon_prod.selected_or_first_available_variant
  | default: patch_addon_prod.variants.first
%}
{% assign patch_addon_variant_id = patch_addon_variant.id | default: custom_settings.patch_addon_variant_id %}
{% assign patch_unit_price = patch_addon_prod.price
  | money_without_currency
  | default: custom_settings.patch_unit_price
  | default: '6.00'
%}

{% assign embroidery_addon_handle = custom_settings.embroidery_addon_product.handle
  | default: custom_settings.embroidery_addon_product
%}
{% assign embroidery_addon_prod = all_products[embroidery_addon_handle]
  | default: custom_settings.embroidery_addon_product
%}
{% assign embroidery_addon_variant = embroidery_addon_prod.selected_or_first_available_variant
  | default: embroidery_addon_prod.variants.first
%}
{% assign embroidery_addon_variant_id = embroidery_addon_variant.id
  | default: custom_settings.embroidery_addon_variant_id
%}
{% assign embroidery_unit_price = embroidery_addon_prod.price
  | money_without_currency
  | default: custom_settings.embroidery_unit_price
  | default: '20.00'
%}
{% assign embroidery_heading_text = custom_settings.embroidery_heading_text | default: 'Add embroidery' %}
{% assign text_input_label_text = custom_settings.text_input_label_text | default: 'Your text' %}

{% assign show_default_char = custom_settings.show_default_char_categories %}
{% if show_default_char == null %}
  {% assign show_default_char = true %}
{% endif %}

{% assign show_default_alpha = custom_settings.show_default_alpha_categories %}
{% if show_default_alpha == null %}
  {% assign show_default_alpha = true %}
{% endif %}

<div class="podifai-customizer">
  <!-- Config Bridge for JavaScript -->
  <div
    id="podifai-customizer-config"
    data-enable-addon="{{ custom_settings.enable_addon_surcharges }}"
    data-currency-symbol="{{ currency_symbol }}"
    data-base-price="{{ product.selected_or_first_available_variant.price | default: product.price | money_without_currency | remove: ',' }}"
    data-patch-price="{{ patch_unit_price }}"
    data-patch-addon-variant="{{ patch_addon_variant_id }}"
    data-embroidery-price="{{ embroidery_unit_price }}"
    data-embroidery-addon-variant="{{ embroidery_addon_variant_id }}"
    data-cloud-name="{{ custom_settings.cloudinary_cloud_name | default: 'tifgkltm' | escape }}"
    data-upload-preset="{{ custom_settings.cloudinary_upload_preset | default: 'shopify_preset_podifai' | escape }}"
    style="display: none;"
  ></div>

  <!-- Canvas Overlay Teleport Anchor / Wrapper -->
  <div id="podifai-canvas-wrapper" class="podifai-canvas-wrapper">
    <div id="podifai-konva-container" class="podifai-konva-container"></div>
  </div>

  <div class="podifai-customizer__container">
    <!-- Step 3: Add Patches Card -->
    <div class="podifai-step-card podifai-patches-step-card" id="podifai-patches-step-card">
      <div class="podifai-step-header">
        <div class="podifai-step-title-group">
          <span class="step-badge">3</span>
          <span class="podifai-step-title">Add patches</span>
          <span class="podifai-optional-badge">optional</span>
        </div>
        <div class="podifai-step-header-meta">
          <span id="podifai-patches-header-count-text"></span>
          <span class="podifai-embroidery-price-tag">
            +{{ currency_symbol -}}
            {{- patch_unit_price -}}
          </span>
          <button
            type="button"
            class="podifai-clear-all-patches-btn"
            id="podifai-clear-all-patches-btn"
            style="display: none;"
            title="Clear all patches"
          >
            &times;
          </button>
        </div>
      </div>

      <!-- Accordion 1: Character Patches -->
      <div class="podifai-accordion" id="podifai-char-accordion">
        <div class="podifai-accordion__trigger">
          <span class="podifai-accordion__label">Character patches</span>

          <span class="podifai-accordion__icon">+</span>
        </div>
        <div class="podifai-accordion__content">
          <!-- Character Category Filter Pills -->
          <div class="podifai-pill-filters" id="podifai-char-categories">
            {% assign char_category_blocks = section.blocks | where: 'type', 'character_category' %}
            {% assign has_custom_char_cats = false %}

            {% if char_category_blocks.size > 0 %}
              {% for cb in char_category_blocks %}
                {% assign has_custom_char_cats = true %}
                {% assign cat_id = cb.settings.title | handleize | default: cb.id %}
                <button
                  type="button"
                  class="podifai-pill-btn {% if forloop.first %}active{% endif %}"
                  data-char-cat="{{ cat_id }}"
                  data-label="{{ cb.settings.title | escape }}"
                  data-size="{{ cb.settings.size | default: '8cm x 8cm' | escape }}"
                  {{ cb.shopify_attributes }}
                >
                  {{ cb.settings.title }}
                </button>
              {% endfor %}
            {% endif %}

            <!-- Default Beautiful Categories matching reference designs -->
            {% if has_custom_char_cats == false %}
              <button
                type="button"
                class="podifai-pill-btn active"
                data-char-cat="cutie-faces"
                data-label="Cutie faces"
                data-size="8cm x 8cm"
              >
                Cutie faces
              </button>
              <button
                type="button"
                class="podifai-pill-btn"
                data-char-cat="snacks-sweets"
                data-label="Snacks & sweets"
                data-size="8cm x 8cm"
              >
                Snacks & sweets
              </button>
              <button
                type="button"
                class="podifai-pill-btn"
                data-char-cat="tiny-animals"
                data-label="Tiny animals"
                data-size="8cm x 8cm"
              >
                Tiny animals
              </button>
              <button
                type="button"
                class="podifai-pill-btn"
                data-char-cat="little-feelings"
                data-label="Little feelings"
                data-size="8cm x 8cm"
              >
                Little feelings
              </button>
            {% endif %}
          </div>

          {% assign first_char_cat_title = '' %}
          {% assign first_char_cat_size = '8cm x 8cm' %}

          {% if char_category_blocks.size > 0 %}
            {% assign first_block = char_category_blocks.first %}
            {% assign first_char_cat_size = first_block.settings.size | default: '8cm x 8cm' %}
          {% else %}
            {% assign first_char_cat_size = '8cm x 8cm' %}
          {% endif %}

          <div class="podifai-sublabel" id="podifai-char-sublabel">
            Size approximately <span id="podifai-char-cat-size">{{ first_char_cat_size | default: '8cm x 8cm' }}</span>
          </div>

          <!-- Character Patches Grid -->
          <div class="podifai-patch-grid" id="podifai-character-patches">
            <!-- Custom Character Category Blocks (Metafield & Manual Uploads) -->
            {% if char_category_blocks.size > 0 %}
              {% for cb in char_category_blocks %}
                {% assign cat_id = cb.settings.title | handleize | default: cb.id %}
                {% assign raw_key = cb.settings.metafield_key
                  | default: cb.settings.title
                  | remove: 'custom.'
                  | strip
                  | handleize
                  | replace: '-', '_'
                %}
                {% assign patch_files = product.metafields.custom[raw_key].value
                  | default: product.metafields.custom[raw_key]
                %}
                {% if patch_files == blank %}
                  {% assign key_with_patches = raw_key | append: '_patches' %}
                  {% assign patch_files = product.metafields.custom[key_with_patches].value
                    | default: product.metafields.custom[key_with_patches]
                  %}
                {% endif %}
                {% if patch_files == blank and cb.settings.metafield_key != blank %}
                  {% assign clean_key = cb.settings.metafield_key | remove: 'custom.' | strip %}
                  {% assign patch_files = product.metafields.custom[clean_key].value
                    | default: product.metafields.custom[clean_key]
                  %}
                {% endif %}

                {% if patch_files != blank %}
                  {% for file in patch_files %}
                    {% assign img_src = file | image_url: width: 400 %}
                    {% assign default_name = cb.settings.title | append: ' #' | append: forloop.index %}
                    {% assign patch_name = file.alt | default: default_name %}
                    <button
                      type="button"
                      class="podifai-patch-item"
                      data-char-category="{{ cat_id }}"
                      data-patch-id="char-mf-{{ cb.id }}-{{ forloop.index }}"
                      data-patch-type="character"
                      data-patch-name="{{ patch_name | escape }}"
                      data-patch-img="{{ img_src }}"
                      title="{{ patch_name | escape }}"
                    >
                      <img
                        src="{{ img_src }}"
                        alt="{{ patch_name | escape }}"
                        class="podifai-patch-img"
                        loading="lazy"
                        width="44"
                        height="44"
                      >
                      <span class="podifai-patch-label">
                        {%- if file.alt != blank %}{{ file.alt }}{% else %}P{{ forloop.index }}{% endif -%}
                      </span>
                      <span class="podifai-patch-badge"></span>
                    </button>
                  {% endfor %}
                {% else %}
                  {% for i in (1..10) %}
                    {% assign img_key = 'img_' | append: i %}
                    {% if cb.settings[img_key] != blank %}
                      {% assign img_src = cb.settings[img_key] | image_url: width: 200 %}
                      {% assign patch_name = cb.settings.title | append: ' #' | append: i %}
                      <button
                        type="button"
                        class="podifai-patch-item"
                        data-char-category="{{ cat_id }}"
                        data-patch-id="char-{{ cb.id }}-{{ i }}"
                        data-patch-type="character"
                        data-patch-name="{{ patch_name | escape }}"
                        data-patch-img="{{ img_src }}"
                        title="{{ patch_name | escape }}"
                      >
                        <img
                          src="{{ img_src }}"
                          alt="{{ patch_name | escape }}"
                          class="podifai-patch-img"
                          loading="lazy"
                          width="44"
                          height="44"
                        >
                        <span class="podifai-patch-label">P{{ i }}</span>
                        <span class="podifai-patch-badge"></span>
                      </button>
                    {% endif %}
                  {% endfor %}
                {% endif %}
              {% endfor %}
            {% endif %}

