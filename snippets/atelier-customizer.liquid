    function getPatchDimensionsPx(sizeStr, patchType) {
      const isCharEnabled = {{ char_scale_on | json }};
      const isAlphaEnabled = {{ alpha_scale_on | json }};

      const isScalingActive = patchType === 'letter' ? isAlphaEnabled : isCharEnabled;

      if (!isScalingActive) {
        return { width: 85, height: 85 };
      }

      if (!sizeStr) return { width: 85, height: 85 };

      const numbers = sizeStr.toString().match(/(\d+(?:\.\d+)?)/g);
      if (!numbers || numbers.length === 0) return { width: 85, height: 85 };

      let cmW = parseFloat(numbers[0]) || 8;
      cmW = Math.max(0.5, Math.min(cmW, 12));

      // Visual size offset: 2cm -> 5cm (53px), 3cm -> 6cm (64px), 3.5cm -> 6.5cm (69px), 5cm+ -> 8cm (85px)
      let visualCm = Math.min(8, cmW + 3);
      if (cmW >= 5) {
        visualCm = 8;
      }

      const BASE_CM_TO_PX = 10.625; // 85px = 8cm max zone scale
      const visualPx = Math.round(visualCm * BASE_CM_TO_PX);

      return {
        width: visualPx,
        height: visualPx
      };
    }

