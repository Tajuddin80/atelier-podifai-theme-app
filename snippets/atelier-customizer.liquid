    // Update Persistent UI Summary Bar & Badges
    function updateUIBadges() {
      // 1. Character patch items badge count - Strictly match unique patchRefId
      document.querySelectorAll('#podifai-character-patches .podifai-patch-item').forEach((btn) => {
        const pId = btn.dataset.patchId;
        const count = selectedPatches.filter((p) => p.type === 'character' && p.patchRefId === pId).length;

        const badge = btn.querySelector('.podifai-patch-badge');
        if (count > 0) {
          btn.classList.add('active');
          if (badge) badge.innerText = count;
        } else {
          btn.classList.remove('active');
          if (badge) badge.innerText = '';
        }
      });

      const charSelectedCount = selectedPatches.filter((p) => p.type === 'character').length;
      const charSelectedCountEl = document.getElementById('podifai-char-selected-count');
      if (charSelectedCountEl) charSelectedCountEl.innerText = charSelectedCount;

      // 2. Alphabet patch items badge count
      document.querySelectorAll('#podifai-alphabet-grid .podifai-letter-item').forEach((btn) => {
        const letter = (btn.dataset.letter || '').toLowerCase();
        const count = selectedPatches.filter(
          (p) =>
            p.type === 'letter' &&
            p.category === currentAlphabetCategory &&
            (p.letterChar || '').toLowerCase() === letter
        ).length;

        const badge = btn.querySelector('.podifai-patch-badge');
        if (count > 0) {
          btn.classList.add('active');
          if (badge) badge.innerText = count;
        } else {
          btn.classList.remove('active');
          if (badge) badge.innerText = '';
        }
      });

      // 3. Bottom Summary Bar in Step 3
      const summaryContainer = document.getElementById('podifai-active-summary');
      const summaryTags = document.getElementById('podifai-summary-tags');
      const summaryCount = document.getElementById('podifai-summary-count');

      if (summaryContainer && summaryTags && summaryCount) {
        summaryCount.innerText = selectedPatches.length;
        summaryTags.innerHTML = '';

        if (selectedPatches.length > 0) {
          summaryContainer.style.display = 'block';
          selectedPatches.forEach((p) => {
            const tag = document.createElement('div');
            tag.className = 'podifai-summary-tag';

            let labelText = '';
            if (p.type === 'character') {
              const raw = p.letterChar || 'Patch';
              const m = raw.match(/^(.*?)\s*#(\d+)$/);
              if (m) {
                labelText = `${m[1].trim()}, P${m[2]}`;
              } else {
                labelText = raw;
              }
            } else {
              const cat = p.categoryLabel || p.category || 'Alphabet';
              const char = (p.letterChar || '').toUpperCase().replace(/'/g, '');
              labelText = `${cat}, ${char}`;
            }

            tag.innerHTML = `
              <img src="${p.imgUrl}" alt="${labelText}">
              <span>${labelText}</span>
              <button type="button" class="podifai-summary-remove" data-id="${p.id}">&times;</button>
            `;
            summaryTags.appendChild(tag);
          });

          summaryTags.querySelectorAll('.podifai-summary-remove').forEach((btn) => {
            btn.addEventListener('click', () => {
              const instanceId = btn.dataset.id;
              removePatchById(instanceId);
            });
          });
        } else {
          summaryContainer.style.display = 'none';
        }
      }

      updateDynamicPrice();
    }

    function removePatchById(instanceId) {
      const idx = selectedPatches.findIndex((p) => p.id === instanceId);
      if (idx > -1) {
        const removed = selectedPatches.splice(idx, 1)[0];
        if (removed.node) {
          removed.node.destroy();
          transformer.nodes([]);
          updateDeleteButtonPosition();
        }
        updateUIBadges();
      }
    }

    // Clear All Patches button in Step 3 header
    const clearAllPatchesBtn = document.getElementById('podifai-clear-all-patches-btn');
    if (clearAllPatchesBtn) {
      clearAllPatchesBtn.addEventListener('click', () => {
        selectedPatches.forEach((p) => {
          if (p.node) p.node.destroy();
        });
        selectedPatches = [];
        if (transformer) transformer.nodes([]);
        if (layer) layer.draw();
        updateUIBadges();
      });
    }

    // Add Patch Handler (supports multiple instances of the same patch / letter)
    function handlePatchAdd(btnEl, patchRefId, patchType, titleStr, svgOrImgSrc, categoryStr, categoryLabel) {
      if (!layer || !stage) return;

      const currentW = stage.width();
      const currentH = stage.height();
      const scaleFactor = currentW / BASE_STAGE_REF;

      const imgObj = new Image();
      imgObj.crossOrigin = 'Anonymous';
      const finalImgSrc = svgOrImgSrc || getLetterPatchImageUrl(categoryStr || currentAlphabetCategory, titleStr);
      imgObj.src = finalImgSrc;

      // Unique instance ID for this specific patch node
      const instanceId = `${patchRefId}-inst-${Date.now()}-${Math.random().toString(36).substr(2, 5)}`;

      // Stagger positions nicely across canvas
      const patchIndex = selectedPatches.length;
      const initX = Math.min(Math.max(50, currentW / 2 + ((patchIndex % 5) - 2) * 45), currentW - 50);
      const initY = Math.min(Math.max(50, currentH / 2 + Math.floor(patchIndex / 5) * 45), currentH - 50);
      const relX = initX / currentW;
      const relY = initY / currentH;

      let rawSizeStr = null;
      if (btnEl) {
        rawSizeStr = btnEl.dataset.size || (btnEl.closest('[data-size]') ? btnEl.closest('[data-size]').dataset.size : null);
      }
      if (!rawSizeStr) {
        if (patchType === 'letter') {
          const activeAlphaPill = document.querySelector('#podifai-alphabet-categories .podifai-pill-btn.active');
          if (activeAlphaPill) rawSizeStr = activeAlphaPill.dataset.size;
        } else {
          const activeCharPill = document.querySelector('#podifai-char-categories .podifai-pill-btn.active');
          if (activeCharPill) rawSizeStr = activeCharPill.dataset.size;
        }
      }
      if (!rawSizeStr) rawSizeStr = '8cm x 8cm';

      const dim = getPatchDimensionsPx(rawSizeStr, patchType);
      const baseWidth = dim.width;
      const baseHeight = dim.height;

      const node = new Konva.Image({
        x: initX,
        y: initY,
        image: imgObj,
        width: baseWidth,
        height: baseHeight,
        offsetX: baseWidth / 2,
        offsetY: baseHeight / 2,
        scaleX: scaleFactor,
        scaleY: scaleFactor,
        draggable: true,
        dragBoundFunc: function (pos) {
          if (!stage) return pos;
          const sw = stage.width();
          const sh = stage.height();
          const s = this.scaleX();
          const halfW = (this.width() * s) / 2;
          const halfH = (this.height() * s) / 2;
          const m = 6;
          return {
            x: Math.max(halfW + m, Math.min(pos.x, sw - halfW - m)),
            y: Math.max(halfH + m, Math.min(pos.y, sh - halfH - m)),
          };
        },
      });

      imgObj.onload = () => layer.draw();

      const patchObj = {
        id: instanceId,
        patchRefId: patchRefId,
        type: patchType,
        category: categoryStr,
        categoryLabel: categoryLabel,
        letterChar: titleStr,
        node: node,
        element: btnEl,
        imgUrl: finalImgSrc,
        relX: relX,
        relY: relY,
        baseScaleX: 1,
        baseScaleY: 1,
        rotation: 0,
      };

      function syncNodeRelativeState() {
        const w = stage.width();
        const h = stage.height();
        patchObj.relX = node.x() / w;
        patchObj.relY = node.y() / h;
        patchObj.rotation = node.rotation();
      }

      node.on('dragmove dragend transform transformend', () => {
        syncNodeRelativeState();
        updateDeleteButtonPosition();
      });

      node.on('click tap', () => {
        transformer.nodes([node]);
        updateDeleteButtonPosition();
      });

      layer.add(node);
      transformer.nodes([node]);
      updateDeleteButtonPosition();

      selectedPatches.push(patchObj);
      updateUIBadges();
    }

