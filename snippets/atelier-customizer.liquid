{% comment %}
  Podifai / Atelier Product Customizer Snippet
  Supports:
  1. Step 3 (Add Patches) & Step 4 (Add Embroidery) Card Architecture.
  2. Bottom Placement of Selected Patches with Pill design & Live Surcharges.
  3. Dynamic Character Categories (Cutie faces, Snacks & sweets, Tiny animals, Little feelings) & 26 Alphabet Patches.
  4. Multi-Text Embroidery Engine with Font Picker, Character Counter, and Thread Colors.
  5. Live Order Total Summary Breakdown Card & Microcopy.
  6. Zero-Backend Companion Addon Surcharge Engine + ImgBB/Cloudinary Canvas composite snapshot export.
{% endcomment %}

{% assign customizer_block = block %}
{% if customizer_block == blank %}
  {% for b in section.blocks %}
    {% if b.type == 'atelier-customizer' or b.type == 'podifai-customizer' %}
      {% assign customizer_block = b %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}
{% assign custom_settings = customizer_block.settings | default: section_settings | default: section.settings %}
{% assign currency_symbol = custom_settings.currency_symbol | default: 'RM' %}

{% assign patch_addon_prod = custom_settings.patch_addon_product %}
{% if patch_addon_prod == blank or patch_addon_prod.title == blank %}
  {% assign patch_addon_handle = custom_settings.patch_addon_product.handle
    | default: custom_settings.patch_addon_product
    | default: 'patch-addon'
  %}
  {% assign patch_addon_prod = all_products[patch_addon_handle] | default: custom_settings.patch_addon_product %}
{% endif %}
{% assign patch_addons_coll_handle = custom_settings.patch_addons_collection.handle
  | default: custom_settings.patch_addons_collection
  | default: 'patch-addons'
%}
{% assign patch_addons_coll = collections[patch_addons_coll_handle] %}
{% assign patch_addon_variant = patch_addon_prod.selected_or_first_available_variant
  | default: patch_addon_prod.variants.first
%}
{% if patch_addon_variant == blank %}
  {% if patch_addons_coll != blank and patch_addons_coll.products.size > 0 %}
    {% assign first_coll_prod = patch_addons_coll.products.first %}
    {% assign patch_addon_variant = first_coll_prod.selected_or_first_available_variant
      | default: first_coll_prod.variants.first
    %}
  {% else %}
    {% assign generic_addon_prod = all_products['patch-addon'] | default: patch_addon_prod %}
    {% assign patch_addon_variant = generic_addon_prod.selected_or_first_available_variant
      | default: generic_addon_prod.variants.first
    %}
  {% endif %}
{% endif %}
{% if patch_addon_variant == blank %}
  {% for blk in section.blocks %}
    {% if blk.settings.patch_product != blank and blk.settings.patch_product.variants.size > 0 %}
      {% assign patch_addon_variant = blk.settings.patch_product.variants.first %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}
{% assign patch_addon_variant_id = patch_addon_variant.id | default: custom_settings.patch_addon_variant_id %}
{% assign patch_unit_price = patch_addon_prod.price
  | money_without_currency
  | default: custom_settings.patch_unit_price
  | default: '6.00'
%}

{% assign embroidery_addon_handle = custom_settings.embroidery_addon_product.handle
  | default: custom_settings.embroidery_addon_product
%}
{% assign embroidery_addon_prod = all_products[embroidery_addon_handle]
  | default: custom_settings.embroidery_addon_product
%}
{% assign embroidery_addon_variant = embroidery_addon_prod.selected_or_first_available_variant
  | default: embroidery_addon_prod.variants.first
%}
{% assign embroidery_addon_variant_id = embroidery_addon_variant.id
  | default: custom_settings.embroidery_addon_variant_id
%}
{% assign embroidery_unit_price = embroidery_addon_prod.price
  | money_without_currency
  | default: custom_settings.embroidery_unit_price
  | default: '20.00'
%}
{% assign embroidery_heading_text = custom_settings.embroidery_heading_text | default: 'Add embroidery' %}
{% assign text_input_label_text = custom_settings.text_input_label_text | default: 'Your text' %}

{% assign default_medium_orange_variant = null %}
{% for v in product.variants %}
  {% assign v_title_down = v.title | downcase %}
  {% if v_title_down contains 'medium' and v_title_down contains 'orange' and v.available %}
    {% assign default_medium_orange_variant = v %}
    {% break %}
  {% endif %}
{% endfor %}
{% if default_medium_orange_variant == null %}
  {% for v in product.variants %}
    {% assign v_title_down = v.title | downcase %}
    {% if v_title_down contains 'medium' and v.available %}
      {% assign default_medium_orange_variant = v %}
      {% break %}
    {% endif %}
  {% endfor %}
{% endif %}
{% if default_medium_orange_variant == null %}
  {% assign default_medium_orange_variant = product.selected_or_first_available_variant
    | default: product.variants.first
  %}
{% endif %}

<div class="podifai-customizer">
  <!-- Config Bridge for JavaScript -->
  <div
    id="podifai-customizer-config"
    data-enable-addon="{{ custom_settings.enable_addon_surcharges }}"
    data-currency-symbol="{{ currency_symbol }}"
    data-base-price="{{ default_medium_orange_variant.price | default: product.price | money_without_currency | remove: ',' }}"
    data-patch-price="{{ patch_unit_price }}"
    data-patch-addon-variant="{{ patch_addon_variant_id }}"
    data-patch-addons-collection="{{ patch_addons_coll_handle | default: 'patch-addons' }}"
    data-embroidery-price="{{ embroidery_unit_price }}"
    data-embroidery-addon-variant="{{ embroidery_addon_variant_id }}"
    data-imgbb-api-key="{{ custom_settings.imgbb_api_key | default: '' | escape }}"
    data-cloud-name="{{ custom_settings.cloudinary_cloud_name | default: 'tifgkltm' | escape }}"
    data-upload-preset="{{ custom_settings.cloudinary_upload_preset | default: 'shopify_preset_podifai' | escape }}"
    style="display: none;"
  ></div>
  <script id="podifai-patch-addon-variants" type="application/json">
    [
      {% assign emitted_variant_ids = '' %}
      {% assign has_output = false %}

      {% if patch_addons_coll != blank and patch_addons_coll.products.size > 0 %}
        {% for prod in patch_addons_coll.products %}
          {% for v in prod.variants %}
            {% assign vid_str = v.id | append: ',' %}
            {% unless emitted_variant_ids contains vid_str %}
              {% assign emitted_variant_ids = emitted_variant_ids | append: vid_str %}
              {% if has_output %},{% endif %}
              {
                "id": {{ v.id }},
                "title": {{ v.title | json }},
                "product_title": {{ prod.title | json }},
                "product_handle": {{ prod.handle | json }},
                "option1": {{ v.option1 | json }},
                "option2": {{ v.option2 | json }},
                "option3": {{ v.option3 | json }},
                "sku": {{ v.sku | json }},
                "image": {{ v.featured_media | default: v.featured_image | default: prod.featured_media | default: prod.featured_image | image_url: width: 200 | json }},
                "available": {{ v.available | json }},
                "inventory_quantity": {{ v.inventory_quantity | default: 0 }},
                "inventory_policy": {{ v.inventory_policy | json }},
                "inventory_management": {{ v.inventory_management | json }}
              }
              {% assign has_output = true %}
            {% endunless %}
          {% endfor %}
        {% endfor %}
      {% endif %}

      {% comment %} Main patch addon product from customizer block settings {% endcomment %}
      {% if patch_addon_prod != blank and patch_addon_prod.variants.size > 0 %}
        {% for v in patch_addon_prod.variants %}
          {% assign vid_str = v.id | append: ',' %}
          {% unless emitted_variant_ids contains vid_str %}
            {% assign emitted_variant_ids = emitted_variant_ids | append: vid_str %}
            {% if has_output %},{% endif %}
            {
              "id": {{ v.id }},
              "title": {{ v.title | json }},
              "product_title": {{ patch_addon_prod.title | json }},
              "product_handle": {{ patch_addon_prod.handle | json }},
              "option1": {{ v.option1 | json }},
              "option2": {{ v.option2 | json }},
              "option3": {{ v.option3 | json }},
              "sku": {{ v.sku | json }},
              "image": {{ v.featured_media | default: v.featured_image | default: patch_addon_prod.featured_media | default: patch_addon_prod.featured_image | image_url: width: 200 | json }},
              "available": {{ v.available | json }},
              "inventory_quantity": {{ v.inventory_quantity | default: 0 }},
              "inventory_policy": {{ v.inventory_policy | json }},
              "inventory_management": {{ v.inventory_management | json }}
            }
            {% assign has_output = true %}
          {% endunless %}
        {% endfor %}
      {% endif %}

      {% comment %} Dynamic auto-detection for category products by block setting or title handle {% endcomment %}
      {% for blk in section.blocks %}
        {% if blk.type == 'alphabet_category' or blk.type == 'character_category' %}
          {% assign blk_prod = blk.settings.patch_product %}
          {% if blk_prod == blank and blk.settings.title != blank %}
            {% assign blk_handle = blk.settings.title | handleize %}
            {% assign blk_prod = all_products[blk_handle] %}
            {% if blk_prod == blank and blk.settings.metafield_key != blank %}
              {% assign m_key_handle = blk.settings.metafield_key | split: '.' | last | replace: '_', '-' | handleize %}
              {% assign blk_prod = all_products[m_key_handle] %}
            {% endif %}
          {% endif %}
          {% if blk_prod != blank and blk_prod.variants.size > 0 %}
            {% for v in blk_prod.variants %}
              {% assign vid_str = v.id | append: ',' %}
              {% unless emitted_variant_ids contains vid_str %}
                {% assign emitted_variant_ids = emitted_variant_ids | append: vid_str %}
                {% if has_output %},{% endif %}
                {
                  "id": {{ v.id }},
                  "title": {{ v.title | json }},
                  "product_title": {{ blk_prod.title | json }},
                  "product_handle": {{ blk_prod.handle | json }},
                  "option1": {{ v.option1 | json }},
                  "option2": {{ v.option2 | json }},
                  "option3": {{ v.option3 | json }},
                  "sku": {{ v.sku | json }},
                  "image": {{ v.featured_media | default: v.featured_image | default: blk_prod.featured_media | default: blk_prod.featured_image | image_url: width: 200 | json }},
                  "available": {{ v.available | json }},
                  "inventory_quantity": {{ v.inventory_quantity | default: 0 }},
                  "inventory_policy": {{ v.inventory_policy | json }},
                  "inventory_management": {{ v.inventory_management | json }}
                }
                {% assign has_output = true %}
              {% endunless %}
            {% endfor %}
          {% endif %}
        {% endif %}
      {% endfor %}

      {% assign known_patch_handles = 'character-patches-part-1,character-patches-part-2,character-patches,character-patche,character-patch,character-patches-1,character-patches-2,alphabet-patches-capital-colors,alphabet-patches-small-letters,alphabet-patches-glitter-letters,alphabet-patches-yellow-and-mix,alphabet-patches-mix-capital-letters,alphabet-patches,alphabet-patche,alphabet-patch,alphabet-patches-1,alphabet-patches-2,alphabet-patches-3,alphabet-patches-4,alphabet-patches-5,patch-addon,red-glitter' | split: ',' %}
      {% for handle_str in known_patch_handles %}
        {% assign h_prod = all_products[handle_str] %}
        {% if h_prod != blank and h_prod.variants.size > 0 %}
          {% for v in h_prod.variants %}
            {% assign vid_str = v.id | append: ',' %}
            {% unless emitted_variant_ids contains vid_str %}
              {% assign emitted_variant_ids = emitted_variant_ids | append: vid_str %}
              {% if has_output %},{% endif %}
              {
                "id": {{ v.id }},
                "title": {{ v.title | json }},
                "product_title": {{ h_prod.title | json }},
                "product_handle": {{ h_prod.handle | json }},
                "option1": {{ v.option1 | json }},
                "option2": {{ v.option2 | json }},
                "option3": {{ v.option3 | json }},
                "sku": {{ v.sku | json }},
                "image": {{ v.featured_media | default: v.featured_image | default: h_prod.featured_media | default: h_prod.featured_image | image_url: width: 200 | json }},
                "available": {{ v.available | json }},
                "inventory_quantity": {{ v.inventory_quantity | default: 0 }},
                "inventory_policy": {{ v.inventory_policy | json }},
                "inventory_management": {{ v.inventory_management | json }}
              }
              {% assign has_output = true %}
            {% endunless %}
          {% endfor %}
        {% endif %}
      {% endfor %}
    ]
  </script>


  {% comment %} 1. Render Customizer UI Components (Canvas, Accordions, Grids, Summary Card) {% endcomment %}
  {% render 'atelier-customizer-ui',
    section: section,
    block: customizer_block,
    product: product,
    custom_settings: custom_settings,
    section_settings: section_settings,
    currency_symbol: currency_symbol,
    patch_unit_price: patch_unit_price,
    embroidery_unit_price: embroidery_unit_price,
    embroidery_heading_text: embroidery_heading_text,
    text_input_label_text: text_input_label_text,
    default_medium_orange_variant: default_medium_orange_variant
  %}
</div>

{% comment %} 2. Render Customizer Client-Side JavaScript Engine (Konva Canvas & Cart Submission) {% endcomment %}
  {% render 'atelier-customizer-scripts',
    section: section,
    block: customizer_block,
    product: product,
    custom_settings: custom_settings,
    section_settings: section_settings
  %}
