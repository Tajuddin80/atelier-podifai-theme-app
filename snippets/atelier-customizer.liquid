    let lastCanvasW = 0;
    let lastCanvasH = 0;
    let resizeFrameId = null;

    // Helper to position floating X (Delete) button on top-right of selected node
    function updateDeleteButtonPosition() {
      if (!stage || !layer || !deleteBtnGroup) return;
      const nodes = transformer ? transformer.nodes() : [];
      if (!nodes || nodes.length === 0) {
        deleteBtnGroup.visible(false);
        layer.batchDraw();
        return;
      }
      const selectedNode = nodes[0];
      const box = selectedNode.getClientRect({ relativeTo: layer });

      deleteBtnGroup.position({
        x: box.x + box.width + 2,
        y: box.y - 2,
      });
      deleteBtnGroup.visible(true);
      deleteBtnGroup.moveToTop();
      layer.batchDraw();
    }

    // Responsive Canvas Resize & Re-anchor Function
    function resizeAndRedrawCanvas() {
      if (!mediaContainerEl || !stage || !layer) return;

      const newRect = mediaContainerEl.getBoundingClientRect();
      if (newRect.width <= 0 || newRect.height <= 0) return;

      // Prevent fractional subpixel micro-reflows that cause mobile screen shaking
      if (Math.abs(newRect.width - lastCanvasW) < 1.5 && Math.abs(newRect.height - lastCanvasH) < 1.5) {
        return;
      }

      lastCanvasW = newRect.width;
      lastCanvasH = newRect.height;

      const newWidth = newRect.width;
      const newHeight = newRect.height;

      stage.width(newWidth);
      stage.height(newHeight);

      const scaleFactor = newWidth / BASE_STAGE_REF;

      selectedPatches.forEach((p) => {
        if (p.node) {
          p.node.x(p.relX * newWidth);
          p.node.y(p.relY * newHeight);
          p.node.scaleX((p.baseScaleX || 1) * scaleFactor);
          p.node.scaleY((p.baseScaleY || 1) * scaleFactor);
          if (typeof p.rotation === 'number') {
            p.node.rotation(p.rotation);
          }
        }
      });

      const maxEmbW = Math.min(220 * scaleFactor, newWidth * 0.42);

      embroideryLines.forEach((line) => {
        if (line.node) {
          const baseSize = (line.baseFontSize || 30) * scaleFactor;
          line.node.fontSize(baseSize);
          if (line.node.width() > maxEmbW) {
            line.node.fontSize(baseSize * (maxEmbW / line.node.width()));
          }
          line.node.offsetX(line.node.width() / 2);
          line.node.offsetY(line.node.height() / 2);
          line.node.x(line.relX * newWidth);
          line.node.y(line.relY * newHeight);
          if (typeof line.rotation === 'number') {
            line.node.rotation(line.rotation);
          }
        }
      });

      updateDeleteButtonPosition();
      layer.batchDraw();
    }

    // Initialize Konva Canvas Engine
    function initKonvaOverlay() {
      mediaContainerEl = document.querySelector(
        '.product-images, .product-media-gallery, [data-product-single-media-group], .product-gallery__main'
      );
      const canvasWrapper = document.getElementById('podifai-canvas-wrapper');

      if (mediaContainerEl && canvasWrapper) {
        if (getComputedStyle(mediaContainerEl).position === 'static') {
          mediaContainerEl.style.position = 'relative';
        }
        mediaContainerEl.appendChild(canvasWrapper);

        const rect = mediaContainerEl.getBoundingClientRect();
        const width = rect.width || 500;
        const height = rect.height || 500;

        lastCanvasW = width;
        lastCanvasH = height;

        stage = new Konva.Stage({
          container: 'podifai-konva-container',
          width: width,
          height: height,
        });

        layer = new Konva.Layer();
        stage.add(layer);

        // Transformer: Allows 360° rotation and dragging while strictly locking size / preventing resizing
        transformer = new Konva.Transformer({
          rotateEnabled: true,
          rotateAnchorOffset: 25,
          resizeEnabled: false,
          enabledAnchors: [],
          borderStroke: '#1a1a1a',
          borderStrokeWidth: 1.5,
          borderDash: [4, 4],
          padding: 4,
        });
        layer.add(transformer);

        // Floating Delete / Trash Bin Icon Button (X Icon)
        deleteBtnGroup = new Konva.Group({
          name: 'deleteBtnGroup',
          visible: false,
          listening: true,
        });

        const deleteBtnBg = new Konva.Circle({
          radius: 11,
          fill: '#ffffff',
          stroke: '#333333',
          strokeWidth: 1.5,
          shadowColor: 'rgba(0, 0, 0, 0.15)',
          shadowBlur: 3,
          shadowOffset: { x: 0, y: 1 },
          shadowOpacity: 0.2,
          cursor: 'pointer',
        });

        const deleteBtnIcon = new Konva.Path({
          data: 'M -3.5 -3.5 L 3.5 3.5 M 3.5 -3.5 L -3.5 3.5',
          stroke: '#333333',
          strokeWidth: 1.6,
          lineCap: 'round',
          lineJoin: 'round',
          fill: 'none',
          cursor: 'pointer',
        });

        deleteBtnGroup.add(deleteBtnBg);
        deleteBtnGroup.add(deleteBtnIcon);
        layer.add(deleteBtnGroup);

        deleteBtnGroup.on('mouseenter', () => {
          if (typeof document !== 'undefined') document.body.style.cursor = 'pointer';
          deleteBtnBg.fill('#fee2e2');
          deleteBtnBg.stroke('#dc2626');
          deleteBtnIcon.stroke('#dc2626');
          layer.batchDraw();
        });

        deleteBtnGroup.on('mouseleave', () => {
          if (typeof document !== 'undefined') document.body.style.cursor = 'default';
          deleteBtnBg.fill('#ffffff');
          deleteBtnBg.stroke('#333333');
          deleteBtnIcon.stroke('#333333');
          layer.batchDraw();
        });

        deleteBtnGroup.on('click tap', (e) => {
          e.cancelBubble = true;
          const nodes = transformer ? transformer.nodes() : [];
          if (nodes && nodes.length > 0) {
            const targetNode = nodes[0];
            const patchObj = selectedPatches.find((p) => p.node === targetNode);
            if (patchObj) {
              removePatchById(patchObj.id);
            } else {
              const lineObj = embroideryLines.find((l) => l.node === targetNode);
              if (lineObj) {
                lineObj.text = '';
                const idx = embroideryLines.indexOf(lineObj);
                updateEmbroideryLineNode(lineObj, idx);
                if (typeof renderEmbroideryLinesUI === 'function') renderEmbroideryLinesUI();
              }
            }
            if (transformer) transformer.nodes([]);
            updateDeleteButtonPosition();
          }
        });

        stage.on('click tap', (e) => {
          if (e.target === stage) {
            transformer.nodes([]);
            updateDeleteButtonPosition();
          }
        });

        if (window.ResizeObserver) {
          const ro = new ResizeObserver(() => {
            if (resizeFrameId) cancelAnimationFrame(resizeFrameId);
            resizeFrameId = requestAnimationFrame(resizeAndRedrawCanvas);
          });
          ro.observe(mediaContainerEl);
        }

        window.addEventListener('resize', () => {
          if (resizeFrameId) cancelAnimationFrame(resizeFrameId);
          resizeFrameId = requestAnimationFrame(resizeAndRedrawCanvas);
        });
        window.addEventListener('orientationchange', () => {
          setTimeout(resizeAndRedrawCanvas, 200);
        });
      }
    }

    // Accordion Toggle
    document.querySelectorAll('.podifai-accordion__trigger').forEach((trigger) => {
      trigger.addEventListener('click', () => {
