            "custom_liquid_icLj8r": {
              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "settings": {
                "custom_liquid": "<div class=\"custom-jump-wrapper\">\n  <span class=\"cjw-left-text\">What fits?</span>\n  <button type=\"button\" class=\"cjw-right-link\" id=\"openSizeGuideModal\">Size Guide</button>\n</div>\n\n<div id=\"sizeGuideModal\" class=\"sg-modal-overlay\" aria-hidden=\"true\" role=\"dialog\">\n  <div class=\"sg-modal-container\">\n    <button type=\"button\" class=\"sg-modal-close\" id=\"closeSizeGuideModal\" aria-label=\"Close modal\">&times;</button>\n    <div class=\"sg-image-card\">\n      <img \n        src=\"https://cdn.shopify.com/s/files/1/0974/2778/4048/files/size-chart-travel-pouches_e8bf414c-91c3-4dca-aec0-58acf414751d.jpg?v=1787734994\" \n        alt=\"Size Guide Chart\"\n        class=\"sg-modal-img\"\n        loading=\"lazy\"\n      >\n    </div>\n  </div>\n</div>\n\n<style>\n  .custom-jump-wrapper {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding: 10px 0;\n    width: 100%;\n    box-sizing: border-box;\n  }\n\n  .cjw-left-text {\n    font-size: 14px;\n    color: #444444;\n  }\n\n  .cjw-right-link {\n    font-size: 14px;\n    color: #1A1A1A;\n    text-decoration: underline;\n    cursor: pointer;\n    font-weight: 500;\n    background: none;\n    border: none;\n    padding: 0;\n    font-family: inherit;\n    transition: opacity 0.2s ease;\n  }\n\n  .cjw-right-link:hover {\n    opacity: 0.7;\n  }\n\n  .sg-modal-overlay {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100vw;\n    height: 100vh;\n    background: rgba(0, 0, 0, 0.75);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    z-index: 999999;\n    opacity: 0;\n    visibility: hidden;\n    transition: opacity 0.25s ease, visibility 0.25s ease;\n    padding: 20px;\n    box-sizing: border-box;\n  }\n\n  .sg-modal-overlay.is-active {\n    opacity: 1;\n    visibility: visible;\n  }\n\n  .sg-modal-container {\n    position: relative;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    animation: sgZoomIn 0.2s ease-out;\n  }\n\n  @keyframes sgZoomIn {\n    from {\n      transform: scale(0.96);\n      opacity: 0;\n    }\n    to {\n      transform: scale(1);\n      opacity: 1;\n    }\n  }\n\n  .sg-modal-close {\n    position: absolute;\n    top: 10px;\n    right: 10px;\n    background: rgba(0, 0, 0, 0.08);\n    color: #333333;\n    border: none;\n    font-size: 22px;\n    line-height: 1;\n    width: 32px;\n    height: 32px;\n    border-radius: 50%;\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    transition: background 0.2s ease, color 0.2s ease;\n    z-index: 20;\n  }\n\n  .sg-modal-close:hover {\n    background: rgba(0, 0, 0, 0.15);\n    color: #000;\n  }\n\n  .sg-image-card {\n    background: #ffffff;\n    padding: 28px 20px 24px;\n    border-radius: 12px;\n    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.25);\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    box-sizing: border-box;\n  }\n\n  .sg-modal-img {\n    max-width: 480px;\n    width: 100%;\n    max-height: 72vh;\n    height: auto;\n    object-fit: contain;\n    display: block;\n  }\n\n  @media (max-width: 768px) {\n    .sg-modal-overlay {\n      padding: 16px;\n    }\n\n    .sg-image-card {\n      padding: 24px 14px 18px;\n    }\n\n    .sg-modal-img {\n      max-width: 90vw;\n      max-height: 70vh;\n    }\n\n    .sg-modal-close {\n      top: 8px;\n      right: 8px;\n      width: 28px;\n      height: 28px;\n      font-size: 20px;\n    }\n  }\n</style>\n\n<script>\n  document.addEventListener('DOMContentLoaded', function() {\n    const openBtn = document.getElementById('openSizeGuideModal');\n    const closeBtn = document.getElementById('closeSizeGuideModal');\n    const modal = document.getElementById('sizeGuideModal');\n\n    if (!openBtn || !modal || !closeBtn) return;\n\n    function openModal() {\n      modal.classList.add('is-active');\n      modal.setAttribute('aria-hidden', 'false');\n      document.body.style.overflow = 'hidden';\n    }\n\n    function closeModal() {\n      modal.classList.remove('is-active');\n      modal.setAttribute('aria-hidden', 'true');\n      document.body.style.overflow = '';\n    }\n\n    openBtn.addEventListener('click', function(e) {\n      e.preventDefault();\n      openModal();\n    });\n\n    closeBtn.addEventListener('click', closeModal);\n\n    modal.addEventListener('click', function(e) {\n      if (e.target === modal) {\n        closeModal();\n      }\n    });\n\n    document.addEventListener('keydown', function(e) {\n      if (e.key === 'Escape' && modal.classList.contains('is-active')) {\n        closeModal();\n      }\n    });\n  });\n</script>"
