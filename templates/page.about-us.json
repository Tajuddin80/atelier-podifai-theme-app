        "text_3HgbNw": {
          "type": "text",
          "name": "t:names.text",
          "settings": {
            "text": "<p>say it slowly —<strong>a pop of joy.</strong></p>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "center",
            "type_preset": "custom",
            "font": "var(--font-accent--family)",
            "font_size": "1.25rem",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "color": "var(--color-foreground)",
            "background": false,
            "background_color": "#00000026",
