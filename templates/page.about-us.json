            "text_zqqbGb": {
              "type": "text",
              "name": "t:names.heading",
              "settings": {
                "text": "<h3>So why —<strong>apopofjoy ?</strong></h3>",
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "h3",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
