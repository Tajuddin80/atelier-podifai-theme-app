            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "text_iradhi": {
          "type": "text",
          "name": "t:names.text",
          "settings": {
            "text": "<p>A small, unexpected moment of delight. Personal. Heartfelt. The kind that catches you on an ordinary day and quietly makes it brighter.</p>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "center",
            "type_preset": "custom",
            "font": "var(--font-accent--family)",
            "font_size": "1.125rem",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "color": "var(--color-foreground)",
            "background": false,
            "background_color": "#00000026",
            "corner_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "text_NcfDPP": {
          "type": "text",
          "name": "t:names.text",
          "settings": {
            "text": "<p>We used to think joy needed a reason. A birthday. A milestone.<em> </em>Something big.</p>",
            "width": "100%",
            "max_width": "none",
            "alignment": "center",
            "type_preset": "custom",
            "font": "var(--font-accent--family)",
            "font_size": "1.125rem",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "color": "var(--color-foreground)",
            "background": false,
            "background_color": "#00000026",
            "corner_radius": 0,
            "padding-block-start": 20,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "text_6TcyUP": {
          "type": "text",
          "name": "t:names.text",
          "settings": {
            "text": "<p>But the small days count too. The ordinary Tuesdays. The just-because moments.</p>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "center",
            "type_preset": "custom",
            "font": "var(--font-accent--family)",
            "font_size": "1.125rem",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "color": "var(--color-foreground)",
            "background": false,
            "background_color": "#00000026",
            "corner_radius": 0,
            "padding-block-start": 5,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "text_cjifPd": {
          "type": "text",
          "name": "t:names.text",
          "settings": {
            "text": "<p>apopofjoy is here for all of them.</p>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "center",
            "type_preset": "custom",
            "font": "var(--font-accent--family)",
            "font_size": "1.125rem",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "color": "var(--color-foreground)",
            "background": false,
            "background_color": "#00000026",
            "corner_radius": 0,
            "padding-block-start": 5,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "text_tbAKQj": {
          "type": "text",
          "name": "t:names.text",
          "settings": {
            "text": "<p>This started because we believe joy shouldn't have to wait for a special occasion — and that the everyday stuff can feel a little less ordinary, and a lot more <em>you.</em></p>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "center",
            "type_preset": "custom",
            "font": "var(--font-body--family)",
            "font_size": "1.125rem",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "color": "var(--color-foreground)",
            "background": false,
            "background_color": "#00000026",
            "corner_radius": 0,
            "padding-block-start": 20,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "custom_liquid_caFqig": {
          "type": "custom-liquid",
          "name": "t:names.custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"custom-divider-wrapper\">\n  <hr class=\"custom-horizontal-line\">\n</div>\n\n<style>\n  .custom-divider-wrapper {\n    width: 100%;\n    display: flex;\n    justify-content: center; /* লাইনটি মাঝে রাখার জন্য (left বা right ও করতে পারেন) */\n    margin: 10px 0; /* ওপর ও নিচের গ্যাপ বা মার্জিন */\n  }\n\n  .custom-horizontal-line {\n    width: 38px; /* আপনার পছন্দমতো লাইনের দৈর্ঘ্য ছোট বা বড় করতে পারেন */\n    height: 1px; /* লাইনের পুরুত্ব বা মোটা কত হবে */\n    background-color: #a97c4f; /* ছবির কালারের সাথে মিলিয়ে গোল্ডেন/ব্রাউন কালার */\n    border: none;\n    margin: 0;\n  }\n</style>"
          },
          "blocks": {}
        },
        "text_EhCiC6": {
          "type": "text",
          "name": "t:names.text",
          "settings": {
            "text": "<p>Some pieces are ready just as they are. Others, you make your own — a name, a colour, the little detail that makes it yours. Either way, it's made to make an ordinary day feel a little more like yours.</p>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "center",
            "type_preset": "custom",
            "font": "var(--font-accent--family)",
            "font_size": "1.125rem",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "color": "var(--color-foreground)",
            "background": false,
            "background_color": "#00000026",
            "corner_radius": 0,
            "padding-block-start": 20,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "text_xAQUMq": {
          "type": "text",
          "name": "t:names.text",
          "settings": {
            "text": "<p>It starts with bags and pouches. But it doesn't end there — bit by bit, we're building a whole home for celebration, the everyday kind and the confetti-everywhere kind.</p>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "center",
            "type_preset": "custom",
            "font": "var(--font-accent--family)",
            "font_size": "1.125rem",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "color": "var(--color-foreground)",
            "background": false,
            "background_color": "#00000026",
            "corner_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "text_QL9kTX": {
          "type": "text",
          "name": "t:names.text",
          "settings": {
            "text": "<p>Because joy lives in the details. And it's <em>worth carrying with you.</em></p>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "center",
            "type_preset": "custom",
            "font": "var(--font-accent--family)",
            "font_size": "1.125rem",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
