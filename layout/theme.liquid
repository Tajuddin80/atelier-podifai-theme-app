<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% # theme-check-disable RemoteAsset %}
    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    {% if settings.transition_to_main_product or settings.page_transition_enabled %}
      <link
        rel="expect"
        href="#MainContent"
        blocking="render"
        id="view-transition-render-blocker"
      >
    {% endif %}

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Red+Hat+Text:ital,wght@0,300..700;1,300..700&display=swap" rel="stylesheet">
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
    {% # theme-check-enable RemoteAsset %}

    {% comment %} Universal Addon Product Suppression (Hide Addons from Recommendations, Cards, Search, and Collections) {% endcomment %}
    <style>
      a[href*="/products/patch-addon"],
      a[href*="/products/embroidery-addon"],
      a[href*="patch-addon"],
      a[href*="embroidery-addon"],
      .product-card:has(a[href*="addon"]),
      .collection-product:has(a[href*="addon"]),
      .search-result:has(a[href*="addon"]),
      [class*="recommendation"]:has(a[href*="addon"]),
      li:has(a[href*="addon"]),
      .grid__item:has(a[href*="addon"]),
      .card-wrapper:has(a[href*="addon"]),
      .product-grid-item:has(a[href*="addon"]),
      .product-item:has(a[href*="addon"]),
      div:has(> a[href*="addon"]),
      div:has(> * > a[href*="addon"][class*="product"]) {
        display: none !important;
      }
    </style>
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <script>
      // Inline header height and menu style calculations to prevent layout shift
      (function setHeaderHeighCustomProperties() {
        const header = document.querySelector('header-component');
        const headerGroup = document.querySelector('#header-group');
        const hasHeaderSection = headerGroup?.querySelector('.header-section');

        if (!header || !headerGroup) return;

        const headerTopRow = header.querySelector('.header__row--top');
        const headerHeight = header.offsetHeight;

        let headerGroupHeight = 0;
        const children = headerGroup.children;
        for (let i = 0; i < children.length; i++) {
          const element = children[i];
          if (element === header || !(element instanceof HTMLElement)) continue;
          headerGroupHeight += element.offsetHeight;
        }

        if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
          headerGroupHeight += headerHeight;
        }

        document.body.style.setProperty('--header-height', `${headerHeight}px`);
        document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);

        if (headerTopRow) {
          window.requestAnimationFrame(function () {
            document.body.style.setProperty('--top-row-height', `${headerTopRow.offsetHeight}px`);
          });
        }

        if (!hasHeaderSection || !header?.hasAttribute('transparent')) {
          document.body.style.setProperty('--transparent-header-offset-boolean', '0');
          return;
        }

        const hasImmediateSection = hasHeaderSection.nextElementSibling?.classList.contains('shopify-section');
        const shouldApplyOffset = !hasImmediateSection ? '1' : '0';
        document.body.style.setProperty('--transparent-header-offset-boolean', shouldApplyOffset);
      })();

      (function setHeaderMenuStyle() {
        const headerComponent = document.querySelector('#header-component');
        if (headerComponent) {
          const isTouchDevice = 'ontouchstart' in window && navigator.maxTouchPoints > 0;
          const overflowList = headerComponent?.querySelector('overflow-list');
          const hasReachedMinimum = overflowList && overflowList.hasAttribute('minimum-reached');
          headerComponent.dataset.menuStyle = isTouchDevice || hasReachedMinimum ? 'drawer' : 'menu';
        }
      })();

      {% comment %} podifai apps js {% endcomment %}
      const observer = new MutationObserver(() => {
        document.querySelectorAll('a[href^="#shopify-section-"]').forEach(link => {
          link.removeAttribute("target");
          link.target = "_self";
        });
      });

      observer.observe(document.body, {
        childList: true,
        subtree: true
      });

      document.addEventListener("click", function (e) {
        const guide = e.target.closest("#badge_group-be99927bf0c407701928fd5f .podifai-header-help");
        if (!guide) return;

        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();

        document.querySelector("#shopify-section-template--27966972920176__section_tbnDA4")
          ?.scrollIntoView({
            behavior: "smooth",
            block: "start"
          });
      }, true);
      {% comment %} podifai apps js end{% endcomment %}
    </script>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    <footer>
      {% sections 'footer-group' %}
    </footer>

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}

    <script>
      (function () {
        let isSyncing = false;
        let syncTimeout = null;

        function updateHeaderCountUI(count) {
          try {
            const countEls = document.querySelectorAll(
              '#header-component sup, .header-actions sup, header a sup, .cart-bubble'
            );
            const textEls = document.querySelectorAll(
              '.cart-bubble__text-count, [ref="cartBubbleCount"], [data-testid="cart-bubble"]'
            );
            textEls.forEach((el) => {
              if (el) {
                el.textContent = count > 0 ? (count < 100 ? String(count) : '99+') : '';
                if (count > 0) el.classList.remove('hidden');
                else el.classList.add('hidden');
              }
            });

            countEls.forEach((el) => {
              if (!el) return;
              if (count > 0) {
                el.removeAttribute('hidden');
                el.classList.remove('visually-hidden');
                el.style.setProperty('display', 'inline-flex', 'important');
                el.style.setProperty('visibility', 'visible', 'important');
                el.style.setProperty('opacity', '1', 'important');
              } else {
                el.setAttribute('hidden', '');
                el.classList.add('visually-hidden');
                el.style.setProperty('display', 'none', 'important');
              }
            });

            document.querySelectorAll('cart-icon').forEach((cartIcon) => {
              if (count > 0) {
                cartIcon.classList.add('header-actions__cart-icon--has-cart');
              } else {
                cartIcon.classList.remove('header-actions__cart-icon--has-cart');
              }
            });

            try {
              sessionStorage.setItem(
                'cart-count',
                JSON.stringify({
                  value: String(count),
                  timestamp: Date.now(),
                })
              );
            } catch (_) {}
          } catch (e) {}
        }

        function isPatchAddon(it) {
          const p = it.properties || {};
          if (
            p['_Customization Data'] ||
            p['_Preview'] ||
            p['Preview'] ||
            p['Customisation Preview'] ||
            p['Customization Preview'] ||
            p['Customisation'] ||
            p['Customization']
          ) {
            return false;
          }
          const t = (it.title || '').toLowerCase();
          const h = (it.handle || '').toLowerCase();
          const addonType = (p['Add on Type'] || p['Addon Type'] || p['_addon_type'] || p['_Add on Type'] || '').toLowerCase();
          return (
            (t.includes('patch') && (t.includes('add') || t.includes('surcharge'))) ||
            (h.includes('patch') && h.includes('add')) ||
            addonType.includes('patch')
          );
        }

        function isEmbroideryAddon(it) {
          const p = it.properties || {};
          if (
            p['_Customization Data'] ||
            p['_Preview'] ||
            p['Preview'] ||
            p['Customisation Preview'] ||
            p['Customization Preview'] ||
            p['Customisation'] ||
            p['Customization']
          ) {
            return false;
          }
          const t = (it.title || '').toLowerCase();
          const h = (it.handle || '').toLowerCase();
          const addonType = (p['Add on Type'] || p['Addon Type'] || p['_addon_type'] || p['_Add on Type'] || '').toLowerCase();
          return (
            (t.includes('embroidery') && (t.includes('add') || t.includes('surcharge'))) ||
            (h.includes('embroidery') && h.includes('add')) ||
            addonType.includes('embroidery')
          );
        }

        function isAnyAddon(it) {
          const p = it.properties || {};
          if (
            p['_Customization Data'] ||
            p['_Preview'] ||
            p['Preview'] ||
            p['Customisation Preview'] ||
            p['Customization Preview'] ||
            p['Customisation'] ||
            p['Customization']
          ) {
            return false;
          }
          const t = (it.title || '').toLowerCase();
          const h = (it.handle || '').toLowerCase();
          return (
            isPatchAddon(it) ||
            isEmbroideryAddon(it) ||
            t.includes('surcharge') ||
            h.includes('addon') ||
            Boolean(p['_addon_type']) ||
            Boolean(p['_is_companion']) ||
            Boolean(p['_parent_item']) ||
            Boolean(p['parent_item'])
          );
        }

        function analyzeCart(cart) {
          const patchItems = [];
          const embroideryItems = [];
          const customizedBags = [];
          const regularProducts = [];
          let totalRequiredPatches = 0;
          let totalRequiredEmbroidery = 0;
          let mainItemCount = 0;
          let regularProductsTotalCents = 0;
          let customizedBagsTotalCents = 0;

          if (!cart || !Array.isArray(cart.items)) {
            return {
              customizedBags: [],
              regularProducts: [],
              patchItems: [],
              embroideryItems: [],
              totalRequiredPatches: 0,
              totalRequiredEmbroidery: 0,
              mainItemCount: 0,
              trueCartSubtotalCents: 0,
              formattedSubtotal: 'RM0.00',
            };
          }

          cart.items.forEach((it) => {
            const p = it.properties || {};

            if (isPatchAddon(it)) {
              patchItems.push(it);
            } else if (isEmbroideryAddon(it)) {
              embroideryItems.push(it);
            } else if (!isAnyAddon(it)) {
              mainItemCount += it.quantity;
              const isCustomized =
                p['Preview'] ||
                p['_Preview'] ||
                p['Customisation Preview'] ||
                p['Customization Preview'] ||
                p['_patches_per_bag'] ||
                p['Customisation'] ||
                p['Customization'] ||
                p['Embroidery'] ||
                p['_Embroidery'];

              if (isCustomized) {
                let patchesPerBag = parseInt(p['_patches_per_bag']) || 0;
                let embroideryPerBag = parseInt(p['_embroidery_per_bag']) || 0;

                const custStr = p['Customisation'] || p['Customization'] || '';
                if (!patchesPerBag && custStr) {
                  const m = custStr.match(/(\d+)\s*Patch/i);
                  if (m) patchesPerBag = parseInt(m[1], 10);
                }
                if (!embroideryPerBag && custStr) {
                  const m = custStr.match(/(\d+)\s*Embroidery/i);
                  if (m) embroideryPerBag = parseInt(m[1], 10);
                }

                const bagQty = it.quantity;
                totalRequiredPatches += patchesPerBag * bagQty;
                totalRequiredEmbroidery += embroideryPerBag * bagQty;

                const unitPatchFee = patchesPerBag * 600;
                const unitEmbroideryFee = embroideryPerBag * 2000;
                const unitTotal = it.final_price + unitPatchFee + unitEmbroideryFee;
                const lineTotal = unitTotal * bagQty;

                customizedBagsTotalCents += lineTotal;

                customizedBags.push({
                  key: it.key,
                  qty: bagQty,
                  unitTotalFormatted: 'RM' + (unitTotal / 100).toFixed(2),
                  lineTotalFormatted: 'RM' + (lineTotal / 100).toFixed(2),
                });
              } else {
                regularProducts.push(it);
                regularProductsTotalCents += it.final_line_price;
              }
            }
          });

          const trueCartSubtotalCents = customizedBagsTotalCents + regularProductsTotalCents;
          const formattedSubtotal = 'RM' + (trueCartSubtotalCents / 100).toFixed(2);

          return {
            customizedBags,
            regularProducts,
            patchItems,
            embroideryItems,
            totalRequiredPatches,
            totalRequiredEmbroidery,
            mainItemCount,
            trueCartSubtotalCents,
            formattedSubtotal,
          };
        }

        let lastAnalysis = null;
        let isApplyingPatches = false;

        function applyPricePatches(analysis) {
          if (!analysis || isApplyingPatches) return;
          isApplyingPatches = true;
          lastAnalysis = analysis;

          try {
            updateHeaderCountUI(analysis.mainItemCount);

            // 1. Update line item prices for customized bags
            analysis.customizedBags.forEach((bag) => {
              const rows = document.querySelectorAll(
                `[data-key="${bag.key}"], tr:has([href*="${bag.key}"]), .cart-item:has([href*="${bag.key}"])`
              );
              rows.forEach((row) => {
                const priceEls = row.querySelectorAll(
                  '.cart-items__price text-component, .cart-item__price, [class*="price-width"] text-component, .cart-items__price span'
                );
                priceEls.forEach((pe) => {
                  if (pe && pe.children.length === 0 && pe.innerText !== bag.lineTotalFormatted) {
                    pe.innerText = bag.lineTotalFormatted;
                  }
                });
              });
            });

            // 2. Update Subtotal everywhere on the Cart Page and Cart Drawer
            document
              .querySelectorAll(
                '.cart-totals__total-value, [data-testid="cart-total-value"], [data-cart-subtotal], .cart-summary__subtotal-value, .cart__total-value, [data-cart-subtotal-value], [data-cart-total-value], .cart-summary [class*="value"], .cart-drawer__footer [class*="value"], .cart__total, caption span'
              )
              .forEach((el) => {
                if (el) {
                  if (el.tagName.toLowerCase() === 'text-component') {
                    el.setAttribute('value', analysis.formattedSubtotal);
                  }
                  el.innerText = analysis.formattedSubtotal;
                }
              });

            document
              .querySelectorAll(
                '.cart-drawer__footer, .cart-drawer__summary, #cart-drawer footer, .cart-page__summary, .cart-summary, .cart-totals'
              )
              .forEach((container) => {
                container.querySelectorAll('*').forEach((node) => {
                  if (
                    node.children.length === 0 &&
                    /^RM\s*\d+(\.\d{2})?$/i.test(node.innerText.trim()) &&
                    !node.closest('.cart-item') &&
                    !node.closest('tr')
                  ) {
                    if (node.innerText !== analysis.formattedSubtotal) {
                      node.innerText = analysis.formattedSubtotal;
                    }
                  }
                });
              });

            // 3. Hide standalone companion addon items from visual cart list
            document
              .querySelectorAll(
                '.cart-drawer .cart-items__table-row, .cart-drawer .cart-item, .cart-drawer li, .cart-items__table-row, tr.cart-item'
              )
              .forEach((row) => {
                const txt = (row.textContent || '').toLowerCase();
                if (
                  (txt.includes('patch') || txt.includes('embroidery')) &&
                  (txt.includes('add on') || txt.includes('addon') || txt.includes('surcharge'))
                ) {
                  row.style.display = 'none';
                }
              });

            // 4. Update Free Shipping Progress Bar
            updateFreeShippingUI(analysis.trueCartSubtotalCents, analysis.mainItemCount);
          } catch (e) {
            console.error('Price patch error:', e);
          } finally {
            isApplyingPatches = false;
          }
        }

        function updateFreeShippingUI(subtotalCents, itemCount) {
          const thresholdCents = 10000;
          const freeShippingContainers = document.querySelectorAll(
            '.free-shipping-progress, [class*="free-shipping-progress"], [data-free-shipping-bar]'
          );

          freeShippingContainers.forEach((container) => {
            if (itemCount === 0 || subtotalCents === 0) {
              container.style.display = 'none';
              return;
            }
            container.style.display = '';

            const bar = container.querySelector(
              '.free-shipping-progress__bar, .progress-bar, [class*="bar-fill"], [class*="progress-fill"], progress, .shipping-bar__fill'
            );
            if (bar) {
              const percent = Math.min(100, Math.max(0, Math.round((subtotalCents / thresholdCents) * 100)));
              if (bar.tagName.toLowerCase() === 'progress') {
                bar.value = percent;
              } else {
                bar.style.width = `${percent}%`;
              }
            }

            const msgEl = container.querySelector(
              '.free-shipping-progress__text, .shipping-message, [class*="message"], [class*="shipping-text"]'
            );
            if (msgEl) {
              if (subtotalCents >= thresholdCents) {
                msgEl.innerHTML = `You've unlocked free shipping!`;
              } else {
                const remainingCents = thresholdCents - subtotalCents;
                const remainingFormatted = `RM${(remainingCents / 100).toFixed(2)}`;
                msgEl.innerHTML = `You're <strong>${remainingFormatted}</strong> away from free shipping`;
              }
            }
          });
        }

        function syncFromVisibleDOM() {
          try {
            const subtotalEl = document.querySelector(
              '.cart-totals__total-value, [data-testid="cart-total-value"], [data-cart-subtotal], .cart-summary__subtotal-value'
            );
            let subtotalCents = 0;
            if (subtotalEl) {
              const text = subtotalEl.innerText || subtotalEl.getAttribute('value') || '';
              const match = text.match(/[\d,.]+/);
              if (match) {
                const clean = match[0].replace(/,/g, '');
                subtotalCents = Math.round(parseFloat(clean) * 100);
              }
            }

            let mainItemCount = 0;
            document
              .querySelectorAll('.cart-drawer .cart-items__table-row, .cart-drawer .cart-item, .cart-drawer tr.cart-item, .cart-items__table-row')
              .forEach((row) => {
                if (row.style.display === 'none' || row.classList.contains('removing')) return;
                const txt = (row.textContent || '').toLowerCase();
                if (
                  (txt.includes('patch') || txt.includes('embroidery')) &&
                  (txt.includes('add on') || txt.includes('addon') || txt.includes('surcharge'))
                ) {
                  return;
                }
                const qtyInput = row.querySelector('input.quantity-selector__input, input[name="updates[]"]');
                const qty = qtyInput ? parseInt(qtyInput.value, 10) || 1 : 1;
                mainItemCount += qty;
              });

            if (subtotalCents > 0 || mainItemCount > 0) {
              updateFreeShippingUI(subtotalCents, mainItemCount);
            }
          } catch (_) {}
        }

        async function syncCartEngine() {
          if (isSyncing) return;
          try {
            const res = await fetch('/cart.js', {
              headers: { Accept: 'application/json', 'x-cart-sync': '1' },
            });
            if (!res.ok) return;
            const cart = await res.json();
            const analysis = analyzeCart(cart);

            applyPricePatches(analysis);

            const onlyAddonsRemain =
              cart.items.length > 0 &&
              cart.items.every((it) => isAnyAddon(it));

            if (onlyAddonsRemain || cart.items.length === 0) {
              if (onlyAddonsRemain) {
                isSyncing = true;
                await fetch('/cart/clear.js', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json', 'x-cart-sync': '1' },
                });
                isSyncing = false;
              }
              updateHeaderCountUI(0);
              document
                .querySelectorAll(
                  '.cart-drawer .cart-items__table-row, .cart-drawer .cart-item, .cart-drawer li, .cart-items__table-row'
                )
                .forEach((el) => (el.style.display = 'none'));
              document
                .querySelectorAll(
                  '[class*="free-shipping"], [class*="shipping-bar"], [class*="shipping_bar"], .cart-drawer [class*="shipping"], [data-free-shipping-bar]'
                )
                .forEach((el) => (el.style.display = 'none'));
              return;
            }

            // Sync companion add-ons per bundle ID
            let updates = {};
            let needsUpdate = false;

            // 1. Group active customized bags by bundle ID
            const bagsByBundle = {};
            cart.items.forEach((it) => {
              if (isAnyAddon(it)) return;
              const p = it.properties || {};
              const bId = p['_bundle_id'];
              if (bId) {
                let patchesPerBag = parseInt(p['_patches_per_bag']) || 0;
                let embroideryPerBag = parseInt(p['_embroidery_per_bag']) || 0;
                const custStr = p['Customisation'] || p['Customization'] || '';
                if (!patchesPerBag && custStr) {
                  const m = custStr.match(/(\d+)\s*Patch/i);
                  if (m) patchesPerBag = parseInt(m[1], 10);
                }
                if (!embroideryPerBag && custStr) {
                  const m = custStr.match(/(\d+)\s*Embroidery/i);
                  if (m) embroideryPerBag = parseInt(m[1], 10);
                }
                bagsByBundle[bId] = {
                  bag: it,
                  qty: it.quantity,
                  requiredPatches: patchesPerBag * it.quantity,
                  requiredEmbroidery: embroideryPerBag * it.quantity,
                };
              }
            });

            // 2. Check and sync each companion add-on item against its parent bundle
            cart.items.forEach((it) => {
              if (!isAnyAddon(it)) return;
              const bId = it.properties?._bundle_id;

              if (!bId || !bagsByBundle[bId]) {
                // Orphan add-on: parent bag does not exist in cart
                if (it.quantity > 0) {
                  updates[it.key] = 0;
                  needsUpdate = true;
                }
              } else {
                const bundleInfo = bagsByBundle[bId];
                if (isPatchAddon(it)) {
                  if (it.quantity !== bundleInfo.requiredPatches) {
                    updates[it.key] = bundleInfo.requiredPatches;
                    needsUpdate = true;
                  }
                } else if (isEmbroideryAddon(it)) {
                  if (it.quantity !== bundleInfo.requiredEmbroidery) {
                    updates[it.key] = bundleInfo.requiredEmbroidery;
                    needsUpdate = true;
                  }
                }
              }
            });

            if (needsUpdate) {
              isSyncing = true;
              const updateRes = await fetch('/cart/update.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', Accept: 'application/json', 'x-cart-sync': '1' },
                body: JSON.stringify({ updates }),
              });
              isSyncing = false;
              if (updateRes.ok) {
                const freshCart = await updateRes.json();
                applyPricePatches(analyzeCart(freshCart));
              }
            }
          } catch (err) {
            console.error('Cart sync error:', err);
            isSyncing = false;
          }
        }

        function triggerSyncDebounced(delay = 50) {
          if (syncTimeout) clearTimeout(syncTimeout);
          syncTimeout = setTimeout(syncCartEngine, delay);
        }

        // Run on load
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', syncCartEngine);
        } else {
          syncCartEngine();
        }

        // Fetch Interceptor: Trigger sync on cart calls without capturing or blocking native events
        const origFetch = window.fetch;
        window.fetch = function () {
          const url = arguments[0];
          const options = arguments[1] || {};
          const isInternalSync =
            options.headers &&
            (options.headers['x-cart-sync'] ||
              (typeof options.headers.get === 'function' && options.headers.get('x-cart-sync')));
          const isCartCall =
            typeof url === 'string' &&
            (url.includes('/cart/change') ||
              url.includes('/cart/update') ||
              url.includes('/cart/add') ||
              url.includes('/cart/clear') ||
              url.includes('/cart?') ||
              url.includes('/cart'));

          return origFetch.apply(this, arguments).then((res) => {
            if (isCartCall && !isInternalSync && !isSyncing) {
              triggerSyncDebounced(20);
              setTimeout(triggerSyncDebounced, 200);
            }
            return res;
          });
        };

        // Standard event listeners
        document.addEventListener('cart:updated', () => triggerSyncDebounced(20));
        document.addEventListener('cart:update', () => triggerSyncDebounced(20));
        document.addEventListener('cart:refresh', () => triggerSyncDebounced(20));
        document.addEventListener('cart-drawer:open', () => triggerSyncDebounced(20));

        // Click listener on cart controls
        document.addEventListener('click', function (e) {
          const btn = e.target.closest(
            '.quantity-selector button, button[name="plus"], button[name="minus"], .quantity-btn, .cart-items__remove, [data-cart-remove], .cart-item__remove, [data-testid="cart-drawer-trigger"], [aria-label*="Remove"], [aria-label*="remove"], [aria-label*="Delete"], [aria-label*="delete"]'
          );
          if (btn) {
            triggerSyncDebounced(20);
            setTimeout(triggerSyncDebounced, 250);
          }
        });

        // Change listener for quantity input typing
        document.addEventListener('change', function (e) {
          const input = e.target.closest(
            'input.quantity-selector__input, .quantity-selector input, input[name="updates[]"]'
          );
          if (input) {
            triggerSyncDebounced(30);
            setTimeout(triggerSyncDebounced, 250);
          }
        });

        // Expose globally
        window.updateHeaderCountUI = updateHeaderCountUI;
        window.syncCartEngine = syncCartEngine;
      })();
    </script>

    <!-- Load Konva.js -->
    <script src="{{ 'konva.min.js' | asset_url }}" defer></script>
  </body>
</html>
